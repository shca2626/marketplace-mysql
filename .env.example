# ─────────────────────────────────────────────────────────────────────────────
# Vendora configuration template — copy to .env and fill real values.
#   cp .env.example .env
# The repo is PUBLIC: never commit the real .env (it is gitignored).
# A fresh clone needs only DATABASE_URL below — the managed cloud MySQL.
# ─────────────────────────────────────────────────────────────────────────────

# Prisma datasource — Aiven cloud MySQL 8.4 (SSL required, always on).
# This is the ONE and ONLY database for every environment (dev = prod).
# Copy the "Service URI" from the Aiven console (service overview page).
DATABASE_URL="mysql://user:password@mysql-your-project.aivencloud.com:23363/defaultdb?ssl-mode=REQUIRED"

# Session cookie signing secret — REQUIRED in production (>= 32 chars).
# Generate with: openssl rand -hex 32
# Development falls back to a built-in secret.
# AUTH_SECRET=

# ── Email — Resend (https://resend.com) ─────────────────────────────────────
# RESEND_API_KEY enables the REST API path (preferred): sends return the
# provider message id used for delivery tracking (Check delivery in the digest
# dialog + the test-mode banner). SMTP below is the fallback transport.
# RESEND_API_KEY=your_resend_api_key
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key
# From address — a sender on a Resend-verified domain. While the domain is NOT
# verified in Resend, the mailer automatically falls back to Resend's testing
# sender "Vendora <onboarding@resend.dev>" (Resend rejects unverified senders
# with 403); the branded address is used the moment the domain verifies.
# SMTP_FROM="Vendora <no-reply@yourdomain.com>"

# ── File storage — external hosting (FTP) ────────────────────────────────────
# STORAGE_DRIVER: 'local-disk' (default — files under STORAGE_ROOT, served via
# /api/media) or 'ftp-hosting' (files uploaded over plain FTP to FTP_REMOTE_DIR
# on a shared host and served publicly from STORAGE_PUBLIC_BASE/<file>).
# The driver always: generates unique filenames (public hosts edge-cache
# 200/403 responses for ~30 days); enforces an extension whitelist
# (.png .jpg .jpeg .webp .gif .pdf .doc .docx .xls .xlsx .csv .txt .zip);
# rejects executable extensions (.php .phtml .phar .cgi .pl .py .sh .htaccess)
# outright; validates image magic bytes before upload; and degrades
# GRACEFULLY to local disk on any FTP failure (host down, auth, file over the
# ~10 MB FTP limit) — uploads never fail because of FTP.
# STORAGE_DRIVER=local-disk
# STORAGE_PUBLIC_BASE=https://your-domain.example/storage
# STORAGE_ROOT=./uploads
# FTP_HOST=ftp.example.com
# FTP_PORT=21
# FTP_USER=your_ftp_user
# FTP_PASS=your_ftp_password
# FTP_REMOTE_DIR=/htdocs/storage
# FTP_MAX_FILE_BYTES=10485760

# AUTHSEC-1: base URL used in auth emails (password reset / email verification)
APP_URL=http://localhost:3000
