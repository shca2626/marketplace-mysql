[client]
port=3306
socket=/home/z/mysql/mysql.sock

[mysqld]
port=3306
socket=/home/z/mysql/mysql.sock
basedir=/home/z/mysql/usr
datadir=/home/z/mysql-data
tmpdir=/home/z/mysql-tmp
pid-file=/home/z/mysql/mysqld.pid
user=z
log-error=/home/z/mysql/mysqld.err

# Lean sandbox-safe configuration
innodb_buffer_pool_size=256M
innodb_log_file_size=64M
innodb_flush_method=O_DIRECT
max_connections=151
table_open_cache=400
skip-name-resolve
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# security
local_infile=0
