# Vendora runtime configuration
# NOTE: this file is intentionally committed (owner ruling 2026-09) so a fresh
# clone boots with zero setup. Replace values for real deployments.

# Prisma datasource — SQLite file database (shipped with the repo, demo dataset included)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Session cookie signing secret — REQUIRED in production (>= 32 chars).
# Generate one with: openssl rand -hex 32
# In development a built-in fallback is used; `next start` with NODE_ENV=production
# refuses to boot without it (src/lib/auth.ts, SEC-01).
# AUTH_SECRET=

# Media storage driver + root (defaults shown; see src/lib/storage/)
# STORAGE_DRIVER=local-disk
# STORAGE_ROOT=./uploads
