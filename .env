# ═══════════════════════════════════════════════════════════════════════════
# Vendora runtime configuration
# ═══════════════════════════════════════════════════════════════════════════
# DATABASE: Aiven cloud MySQL 8.4 is the ONE and ONLY database (dev = prod),
# forever. Never install a local database server. The service URI comes from
# the Aiven console; ssl-mode=REQUIRED is enforced by the service itself.
# ═══════════════════════════════════════════════════════════════════════════

DATABASE_URL=mysql://avnadmin:AVNS_rPZKf46vS9SmtXTUrY4@mysql-marketplace-sunsolar1.f.aivencloud.com:23363/defaultdb?ssl-mode=REQUIRED

# ── Session cookie signing secret ────────────────────────────────────────────
# REQUIRED in production (>= 32 chars, generate with: openssl rand -hex 32).
# Development falls back to a built-in secret (src/lib/auth.ts, SEC-01).
# AUTH_SECRET=

# ── File storage — InfinityFree hosting over FTP (ftp-hosting driver) ───────
# Public origin: https://yusr.site.je/storage (same account as the legacy
# MySQL panel — FTP and MySQL share the InfinityFree login by design).
# The driver degrades gracefully to local disk on any FTP failure.
STORAGE_DRIVER=ftp-hosting
FTP_HOST=ftpupload.net
FTP_PORT=21
FTP_USER=if0_43035558
FTP_PASS=325631NMB
FTP_REMOTE_DIR=/htdocs/storage
STORAGE_PUBLIC_BASE=https://yusr.site.je/storage

# ── Email — Resend ──────────────────────────────────────────────────────────
# NOTE (2026-10-01): RESEND_API_KEY / SMTP_PASS were lost in an .env accident
# during the Aiven migration and are NOT recoverable from git history —
# re-add them from the Resend dashboard to re-enable digest emails. The
# digest engine degrades gracefully (FAILED status + retry UI) without them.
# RESEND_API_KEY=
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM="Vendora <onboarding@resend.dev>"

# ── AUTHSEC-1: base URL used in auth emails (password reset / verification) ──
APP_URL=http://localhost:3000
