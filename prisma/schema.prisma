model Solution {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  tagline      String?
  description  String?           @db.Text // MYSQL: long description
  audience     String            @default("HOME") // HOME | FARM | BUSINESS
  icon         String? // lucide icon name
  imageUrl     String?
  accentColor  String? // hex
  categorySlug String? // products from this category curated on the page
