// ═══════════════════════════════════════════════════════════════════════════
// VENDORA — PRODUCTION SCHEMA (Aiven cloud MySQL 8.4 — the ONE and ONLY database)
// ═══════════════════════════════════════════════════════════════════════════
//
// Datasource: Aiven for MySQL, service "mysql-marketplace-sunsolar1"
// (mysql-marketplace-sunsolar1.f.aivencloud.com:23363 / defaultdb, TLS required).
// The complete 66-model graph. MySQL dialect notes: @db.Text on long free-form
// fields, @db.VarChar(4000) on Product.images (TEXT can't take literal defaults
// on MySQL 8.4), explicit composite-@@id M2M join models (Aiven enforces
// sql_require_primary_key=1).
//
// Schema/DB sync:  bun run db:push    (prisma db push --accept-data-loss)
// Client:          bun run db:generate
// Health:          bun scripts/db-status.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// VENDORA — unified commerce core (B2C + B2B + B2B2C)
//
// Foundation principle: the difference between B2C and B2B is DATA, not code
// paths. One buyer graph (users + organizations + customer groups), one
// pricing resolution pipeline (price lists), one negotiation primitive
// (RFQ/Quote), one order pipeline with payment-term extensions.
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id             String    @id @default(cuid())
  email          String?   @unique // Phase 3: OPTIONAL — sign-in is phone-first; email stays for receipts/recovery (unique when set)
  password       String
  name           String
  image          String?
  role           String    @default("BUYER") // BUYER | SELLER | ADMIN
  status         String    @default("ACTIVE") // ACTIVE | SUSPENDED — platform-controlled vendor lifecycle
  suspendedAt    DateTime?
  storeName      String?
  storeBio       String?   @db.Text // MYSQL: vendor bio, free-form long content
  storeCover     String? // cover id from the curated STORE_COVERS set — persisted per seller, STAB-8
  commissionRate Float? // vendor payout commission override (percent); null = platform default
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ── Auth hardening (AUTHSEC-1) — mirrors prisma/schema.prisma ──
  sessionVersion  Int       @default(0)
  emailVerifiedAt DateTime?

  // ── Phase 6 MFA (lastplan v5 6.7) ──
  mfaRequired  Boolean @default(false) // admin-set per-account requirement; the user can enroll but never disable while required
  isBreakGlass Boolean @default(false) // dedicated break-glass account — login-alerted + audited (6.2.3)

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  products            Product[]
  productsCurated     Product[]            @relation("ProductsCuratedBy") // 9.1: curated catalog records this admin owns (provenance)
  orders              Order[]
  reviews             Review[]
  favorites           Favorite[]
  memberships         OrganizationMember[]
  groups              CustomerGroupUser[]  @relation("UserCustomerGroups")
  rfqs                Rfq[]
  quotesIssued        Quote[]              @relation("QuoteCreatedBy")
  rfqMessages         RfqMessage[]         @relation("RfqMessages")
  approvalsRequested  ApprovalRequest[]    @relation("ApprovalRequester")
  approvalsDecided    ApprovalRequest[]    @relation("ApprovalDecider")
  notifications       Notification[]       @relation("Notifications")
  verifiedAt          DateTime? // platform verification stamp (KYC-lite); enables routing auto-approve + distribution filters
  settingChanges      SettingChange[]      @relation("SettingChangeUser")
  disputesRaised      Dispute[]            @relation("DisputeRaisedBy")
  disputesAgainst     Dispute[]            @relation("DisputeSeller")
  disputesResolved    Dispute[]            @relation("DisputeResolver")
  recurringSchedules  RecurringRfq[]
  mediaAssets         MediaAsset[]         @relation("MediaAssets")
  vaultAccessGrants   VaultAccessGrant[]   @relation("VaultAccessGrants")
  paymentsCaptured    Payment[]            @relation("PaymentsCapturedBy")
  payouts             Payout[]             @relation("PayoutSeller")
  payoutExecutions    Payout[]             @relation("PayoutExecutedBy")
  sellerProfilesOwned SellerProfile[]      @relation("SellerProfileOwner")
  refundsRequested    Refund[]             @relation("RefundRequester")
  refundsApproved     Refund[]             @relation("RefundApprover")
  refundsCompleted    Refund[]             @relation("RefundCompleter")

  // ── Applicant profile (FINANCIER_SCHEMA v5 §3.1) — additive, ALL nullable;
  //    B2C buyers unaffected until they apply for financing (DP-14) ──
  phone             String?   @unique // Phase 3: normalized E.164 (+9677XXXXXXXXX) — REQUIRED + OTP-verified for new registrations; unique when set
  phoneVerifiedAt   DateTime? // set by OTP verification (L1 evidence)
  kycLevel          Int       @default(0) // 0=L0 registered · 1=L1 phone verified · 2=L2 identity docs verified · 3=L3 business/org verified (computed once, read everywhere)
  merchantType      String? // EXCLUSIVE_AGENT | AUTHORIZED_AGENT | DISTRIBUTOR | WHOLESALER | RETAILER — Merchant/Dealer designation (owner taxonomy)
  whatsappNumber    String?
  dateOfBirth       DateTime?
  gender            String? // MALE | FEMALE | OTHER
  maritalStatus     String? // SINGLE | MARRIED | DIVORCED | WIDOWED
  nationality       String?
  identityType      String? // NATIONAL_ID | PASSPORT | RESIDENCE_PERMIT | OTHER
  identityNumber    String?
  residenceStreet   String?   @db.Text // MYSQL: street address, free-form
  residenceCity     String?
  residenceDistrict String?
  residenceType     String? // OWNED | RENTED

  // ── financing-domain relations (FINANCIER_SCHEMA v5) ──
  accountDocuments          AccountDocument[]       @relation("AccountDocumentsOwner")
  documentsReviewed         AccountDocument[]       @relation("AccountDocumentsReviewedBy")
  financingRequests         FinancingRequest[]      @relation("FinancingRequests")
  financingOffers           FinancingOffer[]        @relation("FinancingOffers")
  financingEventsReported   FinancingEvent[]        @relation("FinancingEventsReportedBy")
  accreditationsSubmitted   AccreditationRequest[]  @relation("AccreditationsSubmitted")
  accreditationsDecided     AccreditationRequest[]  @relation("AccreditationsDecidedBy")
  accreditationsRevoked     AccreditationRequest[]  @relation("AccreditationsRevokedBy")
  gateReviewsFinancing      FinancingRequest[]      @relation("FinancingPlatformReviews")
  gateReviewsAccreditation  AccreditationRequest[]  @relation("AccreditationPlatformReviews")
  submissionsVerified       RequirementSubmission[] @relation("RequirementSubmissionsVerifiedBy")
  conditionTemplatesCreated ConditionTemplate[]     @relation("ConditionTemplatesCreatedBy")

  // ── notification email digest (DIGEST-13) ──
  digests    NotificationDigest[]
  digestPref UserDigestPref?

  // ── RBAC role assignments (mergedplan.md Phase 2) ──
  roleAssignments UserRole[]
  mfaEnrollment   MfaEnrollment?
  authSessions    SessionRegistry[]

  // ── Phase 3: KYC/KYP + notification channels ──
  notificationPref       UserNotificationPref?
  certificationsVerified ProductCertification[] @relation("CertificationsVerifiedBy")

  // ── Phase 4: unified catalog + multi-vendor + approvals ──
  offers           ProductOffer[] // this seller's offers on any catalog product
  productsReviewed Product[]      @relation("ProductsReviewedBy") // admin publish-review decisions

  // ── Phase 9.4: publication agreement templates & consent ledger ──
  agreementsAuthored PublicationAgreementTemplate[] @relation("AgreementsAuthored")
  agreementConsents  PublicationConsent[]           @relation("AgreementConsents")

  // ── Phase 10: financier operations (lastplan v5 §10) ──
  installmentPaymentsRecorded        InstallmentPayment[]        @relation("InstallmentPaymentsRecordedBy")
  paymentReconciliationsResolved     PaymentReconciliation[]     @relation("PaymentReconciliationsResolvedBy")
  disbursementsQueued                DisbursementRecord[]        @relation("DisbursementsQueuedBy")
  disbursementsConfirmed             DisbursementRecord[]        @relation("DisbursementsConfirmedBy")
  riskAssessmentsComputed            RiskAssessment[]            @relation("RiskAssessmentsComputedBy")
  financingContractTemplatesAuthored FinancingContractTemplate[] @relation("FinancingContractTemplatesAuthored")
  esignaturesExecuted                ESignatureExecution[]       @relation("ESignaturesExecuted")
  underwritingLimitsUpdated          UnderwritingLimit[]         @relation("UnderwritingLimitsUpdatedBy")
  riskConfigsUpdated                 RiskConfig[]                @relation("RiskConfigsUpdatedBy") // 10.2
  underwritingLimitScopes            UnderwritingLimit[]         @relation("UnderwritingLimitUsers") // 10.7: per-underwriter overrides

  @@index([role])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  icon           String?
  description    String?         @db.Text // Phase 4: admin-managed category blurb (directory / SEO)
  sortOrder      Int             @default(0) // Phase 4: admin-controlled ordering on nav + directories
  products       Product[]
  specAttributes SpecAttribute[] // Phase 3 KYP: structured attribute dictionary per category
}

// ── Phase 4: brand directory (aggregator layer — owner Q7) ────────────────────
model Brand {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  logoUrl       String?
  description   String?  @db.Text
  websiteUrl    String?
  originCountry String? // e.g. "China", "Germany" — provenance signal
  isVerified    Boolean  @default(false) // platform-verified brand (trust tier)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]

  @@index([isVerified])
}

// ── Phase 4: unit-of-measure dictionary for spec attributes (owner Q7) ──────
model UnitOfMeasure {
  id        String   @id @default(cuid())
  code      String   @unique // "W", "V", "kg", "cm", "mo"
  label     String // "Watt", "Volt", "Kilogram"
  dimension String // POWER | VOLTAGE | CURRENT | WEIGHT | LENGTH | AREA | VOLUME | COUNT | TIME | OTHER
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dimension])
}

// ── Phase 4: organization-type metadata dictionary (owner Q1) ────────────────
// Operational layer OVER the Organization.orgType enum: keys mirror the enum
// (COMPANY | BANK | MFI | EWALLET) so behavior switches stay code-defined,
// while labels / descriptions / ordering / registration visibility are
// owner-managed. merchantType taxonomy (5 Merchant/Dealer types) is presented
// alongside COMPANY. Custom keys are allowed for display-only groupings.
model OrganizationType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  icon        String?
  isActive    Boolean  @default(true) // hidden from registration pickers when false
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Product {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text // MYSQL: long product description
  price          Float // retail list price (fallback of the pricing pipeline)
  compareAtPrice Float?
  images         String   @default("[]") @db.VarChar(4000) // MYSQL: JSON string array of URLs (Aiven MySQL 8.4: TEXT columns can't take literal defaults — VarChar can; measured max ~50 chars, 4000 = ample headroom)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  // ── 9.1 3P catalog ownership: null = platform-curated catalog record ──
  // (no primary seller; purchasable ONLY via a real vendor's ACTIVE ProductOffer —
  // checkout enforces it, the legacy price/stock fallback paths are removed).
  // Non-null = the classic seller-owned listing (primary-seller semantics kept).
  sellerId       String?
  seller         User?    @relation(fields: [sellerId], references: [id])
  // 9.1 provenance: which admin actor created/owns the curated record (audit trail).
  curatedById    String?
  curatedBy      User?    @relation("ProductsCuratedBy", fields: [curatedById], references: [id])
  stock          Int      @default(10) // total units; with variants = sum of variant stock
  soldCount      Int      @default(0)
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  featured       Boolean  @default(false)

  // ── Commerce details (product form: Pricing / Details / Shipping / SEO) ──
  sku             String?
  barcode         String?
  videoUrl        String?
  highlights      String? @db.Text // MYSQL: JSON array of bullet strings (About this item)
  specs           String? @db.Text // MYSQL: JSON array of {label, value} (Specifications)
  materials       String? @db.Text // MYSQL: free-form materials text
  care            String? @db.Text // MYSQL: free-form care instructions
  weightGrams     Int?
  lengthCm        Float?
  widthCm         Float?
  heightCm        Float?
  processingDays  Int? // handling time before dispatch
  freeShipping    Boolean @default(false)
  shippingFee     Float? // flat rate; ignored when freeShipping = true
  shippingPolicy  String? @db.Text // MYSQL: free-form policy text
  slug            String? @unique // SEO handle / future deep links
  metaTitle       String?
  metaDescription String? @db.Text // MYSQL: SEO description, can run long
  moq             Int? // minimum order quantity enforced by RFQ commercial rules (null = none)
  priceTiers      String? @db.Text // MYSQL: JSON [{from,to,price}] quantity-break ladder applied in quotes
  status          String  @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED | PENDING_REVIEW (Phase 4 publish-approval) | REJECTED
  // ── Phase 4: unified catalog identity (the "what it is" layer) ──
  brandId         String? // FK Brand — platform-managed brand linkage
  brand           Brand?  @relation(fields: [brandId], references: [id])
  gtin            String? // normalized EAN/UPC/GTIN — dedup + merge matching key
  mpn             String? // manufacturer part number — dedup key
  isCurated       Boolean @default(false) // platform-curated catalog listing (admin-created/adopted)
  popularRank     Int? // homepage popular-products ordering (curated); null = not ranked

  // ── Phase 4: publish-approval workflow ──
  reviewNote                  String?   @db.Text // admin reject reason shown to the seller
  reviewedAt                  DateTime?
  reviewedById                String?
  reviewedBy                  User?     @relation("ProductsReviewedBy", fields: [reviewedById], references: [id])
  publicationAgreedAt         DateTime? // seller accepted the Publication Agreement (audit-logged too)
  publicationAgreementVersion String? // which agreement text version was accepted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews           Review[]
  favorites         Favorite[]
  orderItems        OrderItem[]
  priceListEntries  PriceListEntry[]
  rfqLines          RfqLine[]
  quoteLines        QuoteLine[]
  variants          ProductVariant[]
  certifications    ProductCertification[]
  offers            ProductOffer[] // Phase 4: multi-vendor offers on this listing
  agreementConsents PublicationConsent[]   @relation("ProductAgreementConsents") // 9.4: publication-agreement consent ledger rows

  @@index([categoryId])
  @@index([sellerId, status])
  @@index([status, soldCount])
  @@index([featured])
  @@index([brandId]) // MYSQL-FK-INDEX: brandId relation needs its own leftmost index
  @@index([gtin]) // Phase 4: dedup/merge matching lookups
  @@index([isCurated])
  @@index([popularRank]) // homepage popular rail ordering
}

// ── Phase 4: multi-vendor offer — the "who sells it" layer (owner Q5) ────────
// Product keeps its single-seller listing semantics (price/stock/sellerId =
// the primary/owning offer, so every existing cart/order/RFQ/quote flow keeps
// working); ProductOffer rows are ADDITIONAL seller offers displayed
// side-by-side on the product page. @@unique([productId, sellerId]) = one
// offer per seller per product; the seller who OWNS the listing edits the
// Product fields instead (guard enforced in the API).
model ProductOffer {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User          @relation(fields: [sellerId], references: [id])
  sellerOrgId    String? // 7.0: authoritative seller-org tenant (backfilled; new writes always set both identifiers)
  sellerOrg      Organization? @relation("OfferSellerOrg", fields: [sellerOrgId], references: [id])
  price          Float // offer unit price (offer currency = product currency)
  compareAtPrice Float?
  stock          Int           @default(0)
  moq            Int?
  sku            String?
  priceTiers     String?       @db.Text // JSON [{from,to,price}] quantity-break ladder
  freeShipping   Boolean       @default(false)
  shippingFee    Float?
  processingDays Int? // handling time before dispatch
  leadTimeNote   String? // e.g. "Ships from Sana'a central warehouse"
  status         String        @default("ACTIVE") // PENDING_REVIEW | ACTIVE | PAUSED | REJECTED | ARCHIVED
  soldCount      Int           @default(0) // units sold through this offer
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  rfqLines      RfqLine[] // RFQ lines may target a specific offer
  quoteLines    QuoteLine[] // 7.6: quote lines snapshot the offer actually quoted
  offerVariants OfferVariant[] // 7.6: D9 per-offer variant rows

  @@unique([productId, sellerId])
  @@index([productId, status])
  @@index([sellerId, status]) // seller console "My offers" listing
  @@index([sellerOrgId]) // 7.0: org-tenant offer queries (MYSQL-FK-INDEX)
}

model Order {
  id       String      @id @default(cuid())
  buyerId  String
  buyer    User        @relation(fields: [buyerId], references: [id])
  items    OrderItem[]
  total    Float
  status   String      @default("PAID") // PENDING_PAYMENT | PENDING_APPROVAL | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  fullName String
  address  String      @db.Text // MYSQL: shipping address, free-form
  city     String
  country  String
  zip      String
  phone    String?

  // ── Phase 7.7: dimension split — one status no longer serves payment and
  // fulfillment simultaneously. Legacy `status` is retained read-only during
  // migration (removed after 7.1b's observation discipline).──
  paymentStatus     String @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | PAID | FUNDED | PARTIALLY_REFUNDED | REFUNDED | OUTSTANDING
  fulfillmentStatus String @default("UNFULFILLED") // UNFULFILLED | PARTIALLY_FULFILLED | FULFILLED | PARTIALLY_CANCELLED | CANCELLED
  currency          String @default("USD") // 7.2: explicit transaction currency

  createdAt DateTime @default(now())

  // ── B2B extensions (all optional so the B2C fast path is unchanged) ──
  organizationId  String? // purchasing organization (B2B context)
  organization    Organization?      @relation(fields: [organizationId], references: [id])
  poNumber        String? // buyer purchase-order reference
  costCenter      String?
  paymentTerms    String? // e.g. NET-30; null = paid at checkout
  sourceType      String? // CART | RFQ
  sourceQuoteId   String?            @unique // quote that produced this order
  approvalRequest ApprovalRequest?
  payment         Payment?
  disputes        Dispute[]
  fulfillments    OrderFulfillment[] // 7.7: per-seller-group fulfillment
  refunds         Refund[] // 7.7: refund obligations + executions

  // ── Phase 10.9: Murabaha checkout — the financed order links to its
  // financing agreement; FUNDED (paymentStatus) ≠ buyer obligation cleared
  // (that lives on the financing state machine, never conflated) ──
  financingAgreementId String?
  financingAgreement   FinancingAgreement? @relation("FinancedOrders", fields: [financingAgreementId], references: [id])

  @@index([buyerId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([organizationId])
}

model OrderItem {
  id                String                 @id @default(cuid())
  orderId           String
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product                @relation(fields: [productId], references: [id])
  sellerId          String
  quantity          Int
  price             Float
  title             String // snapshot of product title at purchase time
  image             String? // snapshot of first product image
  variantId         String? // purchased ProductVariant (null = base product)
  variantName       String? // snapshot of variant label at purchase time
  offerId           String? // Phase 4: purchased ProductOffer (null = primary listing offer) — loose snapshot ref; offers archive but never hard-delete
  offerVariantId    String? // 7.6: the (offer, variant) actually sold — D9 identity
  offerVariant      OfferVariant?          @relation(fields: [offerVariantId], references: [id], onDelete: SetNull)
  sellerOrgId       String? // 7.0: authoritative seller-org tenant of the sale
  sellerOrg         Organization?          @relation("OrderItemSellerOrg", fields: [sellerOrgId], references: [id])
  payoutId          String? // set when this item's revenue was settled into a seller payout
  payout            Payout?                @relation(fields: [payoutId], references: [id])
  payoutLines       PayoutLine[] // 7.4: settlement ledger entries covering this item
  refundAllocations RefundAllocation[] // 7.7: refunds covering this item
  fulfillmentItems  OrderFulfillmentItem[] // 7.7: per-seller-group links

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@index([sellerId, payoutId])
  @@index([offerId]) // Phase 4: offer-level sales analytics
  @@index([payoutId]) // MYSQL-FK-INDEX: payoutId relation needs its own leftmost index
  @@index([sellerOrgId]) // 7.0: org-tenant sales analytics (MYSQL-FK-INDEX)
  @@index([offerVariantId]) // 7.6 (MYSQL-FK-INDEX)
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String // display label, e.g. M / Black
  options        String   @db.Text // MYSQL: JSON map Size -> M, Color -> Black
  price          Float? // null = inherit product price
  compareAtPrice Float?
  stock          Int      @default(0)
  sku            String?
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  image          String? // uploaded-media variant image URL
  createdAt      DateTime @default(now())

  offerVariants OfferVariant[] // 7.6: D9 per-offer rows pointing at this catalog variant

  @@index([productId, isActive])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1..5
  comment   String   @db.Text // MYSQL: review body, free-form long content
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId]) // MYSQL-FK-INDEX: productId relation needs its own leftmost index
}

// ─────────────────────────────────────────────────────────────────────────────
// Party & account graph — the B2B identity foundation.
// A "B2B buyer" is a User acting inside an Organization with a role, not a
// separate user type. Organizations carry verification state, tax identity
// and credit configuration; they map to CustomerGroups for pricing.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  orgType            String    @default("COMPANY") // COMPANY | BANK | MFI | EWALLET — settings scope key
  kycLevel           Int       @default(0) // Phase 3 KYB: 0=registered · 2=identity · 3=business docs verified
  merchantType       String? // EXCLUSIVE_AGENT | AUTHORIZED_AGENT | DISTRIBUTOR | WHOLESALER | RETAILER — Merchant/Dealer classification of the entity
  legalName          String?
  taxId              String? // VAT / EIN
  registrationNumber String?
  industry           String?
  website            String?
  billingAddress     String?   @db.Text // MYSQL: free-form billing address
  status             String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | ACTIVE | SUSPENDED | REJECTED
  verifiedAt         DateTime?
  creditTermsDays    Int       @default(0) // 0 = prepaid; 30 = NET-30 invoicing
  creditLimit        Float     @default(0)
  approvalThreshold  Float? // orders/quote-accepts at or above this total placed by BUYER-role members require org approval (null = off)
  notes              String?   @db.Text // MYSQL: free-form notes
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members          OrganizationMember[]
  priceLists       PriceList[]
  rfqs             Rfq[]
  orders           Order[]
  groups           CustomerGroupOrganization[] @relation("OrganizationCustomerGroups")
  approvalRequests ApprovalRequest[]

  // ── Phase 7.0: seller-org tenant back-relations (three-concept identity) ──
  sellerProfile           SellerProfile?     @relation("SellerProfileOrg")
  offersAsSellerOrg       ProductOffer[]     @relation("OfferSellerOrg")
  orderItemsAsSellerOrg   OrderItem[]        @relation("OrderItemSellerOrg")
  payoutsAsSellerOrg      Payout[]           @relation("PayoutSellerOrg")
  quotesAsSellerOrg       Quote[]            @relation("QuoteSellerOrg")
  fulfillmentsAsSellerOrg OrderFulfillment[] @relation("FulfillmentSellerOrg")

  // ── financing-domain back-relations (FINANCIER_SCHEMA v5) ──
  financierProfile      FinancierProfile?      @relation("FinancierProfileOrg")
  conditionTemplates    ConditionTemplate[]    @relation("FinancierConditionTemplates")
  accountDocuments      AccountDocument[]      @relation("OrganizationAccountDocuments")
  financingRequests     FinancingRequest[]     @relation("FinancingRequestsByOrg")
  accreditationRequests AccreditationRequest[] @relation("AccreditationRequestsByOrg")

  @@index([status])
  @@index([createdAt])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("BUYER") // OWNER | ADMIN | BUYER | APPROVER | VIEWER
  jobTitle       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// Buyer segmentation that pricing and future promotions hang off. Works for
// B2C segments (e.g. VIP retail) and B2B tiers (e.g. wholesale-tier-1).
model CustomerGroup {
  id                         String                      @id @default(cuid())
  key                        String                      @unique
  name                       String
  description                String?                     @db.Text // MYSQL: free-form segment description
  priority                   Int                         @default(0) // higher wins when several groups apply
  isDefault                  Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  customerGroupUsers         CustomerGroupUser[]         @relation("UserCustomerGroups")
  customerGroupOrganizations CustomerGroupOrganization[] @relation("OrganizationCustomerGroups")
  priceLists                 PriceList[]

  @@index([isDefault])
}

// ── Explicit M2M join models ── Aiven MySQL 8.4 runs sql_require_primary_key=1,
// and Prisma's implicit M2M join tables carry only a unique index (no PK), so
// the platform CANNOT push them. These explicit models give the join tables a
// real composite @@id. (Aiven = the one and only production database, forever.)
model CustomerGroupUser {
  customerGroupId String
  userId          String
  customerGroup   CustomerGroup @relation("UserCustomerGroups", fields: [customerGroupId], references: [id], onDelete: Cascade)
  user            User          @relation("UserCustomerGroups", fields: [userId], references: [id], onDelete: Cascade)

  @@id([customerGroupId, userId])
  @@index([userId]) // MYSQL-FK-INDEX: userId relation needs its own leftmost index
}

model CustomerGroupOrganization {
  customerGroupId String
  organizationId  String
  customerGroup   CustomerGroup @relation("OrganizationCustomerGroups", fields: [customerGroupId], references: [id], onDelete: Cascade)
  organization    Organization  @relation("OrganizationCustomerGroups", fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([customerGroupId, organizationId])
  @@index([organizationId]) // MYSQL-FK-INDEX: organizationId relation needs its own leftmost index
}

// ─────────────────────────────────────────────────────────────────────────────
// Pricing engine — price is RESOLVED, never just read.
// Precedence: organization contract list > customer-group list > channel list
// (future) > retail Product.price. Entries carry quantity-break ladders.
// ─────────────────────────────────────────────────────────────────────────────

model PriceList {
  id              String         @id @default(cuid())
  name            String
  description     String?        @db.Text // MYSQL: free-form description
  scope           String // ORG | GROUP | CHANNEL
  status          String         @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  priority        Int            @default(0)
  currency        String         @default("USD")
  startsAt        DateTime?
  endsAt          DateTime?
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  entries PriceListEntry[]

  @@index([status, scope])
  @@index([organizationId])
  @@index([customerGroupId])
}

model PriceListEntry {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  minQuantity Int       @default(1) // ladder step: applies from this quantity up
  unitPrice   Float
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, minQuantity])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Negotiation engine — RFQ (request for quote) and Quote.
// The B2B transaction primitive: multi-line requests, competing quotes with
// validity windows, acceptance closes the RFQ. Quote → Order conversion is
// prepared via Order.sourceQuoteId.
// ─────────────────────────────────────────────────────────────────────────────

model Rfq {
  id                String        @id @default(cuid())
  number            String        @unique
  userId            String
  organizationId    String?
  title             String?
  description       String?       @db.Text // MYSQL: free-form RFQ description
  status            String        @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | QUOTED | ACCEPTED | REJECTED | CANCELLED | EXPIRED | ORDERED
  submittedAt       DateTime?
  respondedAt       DateTime?
  closedAt          DateTime?
  expiresAt         DateTime? // RFQ deadline (expiry settings; null = no deadline)
  extendedCount     Int           @default(0) // buyer extensions used against the max-extensions rule
  sourceRecurringId String? // loose FK: the RecurringRfq schedule that spawned this run
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id])
  organization      Organization? @relation(fields: [organizationId], references: [id])

  lines    RfqLine[]
  quotes   Quote[]
  messages RfqMessage[]

  @@index([userId, createdAt])
  @@index([organizationId])
  @@index([status, createdAt])
}

model RfqLine {
  id             String        @id @default(cuid())
  rfqId          String
  productId      String? // null = open/free item ("250 units of something like this")
  productName    String        @db.Text // MYSQL: snapshot title / free description
  sku            String?
  variantId      String? // referenced catalog variant (optional)
  variantName    String? // snapshot "Color: Black / Bundle: Duo"
  offerId        String? // Phase 4: target a SPECIFIC vendor offer (null = the product generally / primary listing)
  offer          ProductOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull) // offer archived → line keeps product context
  offerVariantId String? // 7.6: buyer targets a specific vendor's variant (D9 identity)
  offerVariant   OfferVariant? @relation(fields: [offerVariantId], references: [id], onDelete: SetNull)
  quantity       Int
  targetPrice    Float? // buyer's target unit price (optional)
  notes          String?       @db.Text // MYSQL: free-form line notes
  rfq            Rfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product        Product?      @relation(fields: [productId], references: [id])

  quoteLines QuoteLine[]

  @@index([rfqId])
  @@index([productId])
  @@index([variantId])
  @@index([offerVariantId]) // 7.6 (MYSQL-FK-INDEX)
}

model Quote {
  id            String        @id @default(cuid())
  number        String        @unique
  rfqId         String
  createdById   String // admin or seller who issued the quote
  sellerId      String? // fulfilling seller (null = platform-facilitated)
  sellerOrgId   String? // 7.0: authoritative seller-org tenant of the quote
  sellerOrg     Organization? @relation("QuoteSellerOrg", fields: [sellerOrgId], references: [id])
  status        String        @default("SENT") // DRAFT | SENT | PENDING_REVIEW | ACCEPTED | DECLINED | REJECTED | EXPIRED | CONVERTED | WITHDRAWN
  currency      String        @default("USD")
  subtotal      Float
  discountTotal Float         @default(0)
  shippingTotal Float         @default(0)
  taxTotal      Float         @default(0)
  total         Float
  paymentTerms  String? // e.g. NET-30
  validUntil    DateTime?
  notes         String?       @db.Text // MYSQL: free-form quote notes
  sentAt        DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  convertedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rfq           Rfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  lines            QuoteLine[]
  approvalRequests ApprovalRequest[] @relation("ApprovalQuote")

  @@index([rfqId])
  @@index([status])
  @@index([sellerOrgId]) // 7.0 (MYSQL-FK-INDEX)
  @@index([createdById]) // MYSQL-FK-INDEX: createdById relation needs its own leftmost index
}

// B2B purchase-approval workflow: BUYER-role members trigger a request when an
// order (cart checkout) or a quote acceptance reaches the org's approval
// threshold. OWNER/ADMIN/APPROVER members decide; requesters never self-approve.
model ApprovalRequest {
  id             String    @id @default(cuid())
  organizationId String
  type           String // ORDER | QUOTE_ACCEPT
  orderId        String?   @unique // set for ORDER
  quoteId        String?   @unique // set for QUOTE_ACCEPT
  rfqId          String? // owning RFQ context (QUOTE_ACCEPT)
  requesterId    String
  amount         Float
  note           String?   @db.Text // MYSQL: requester's justification
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?   @db.Text // MYSQL: decision note
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id])
  quote        Quote?       @relation("ApprovalQuote", fields: [quoteId], references: [id])
  requester    User         @relation("ApprovalRequester", fields: [requesterId], references: [id])
  decidedBy    User?        @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([organizationId, status])
  @@index([requesterId])
  @@index([decidedById]) // MYSQL-FK-INDEX: decidedById relation needs its own leftmost index
}

model QuoteLine {
  id             String        @id @default(cuid())
  quoteId        String
  rfqLineId      String?
  productId      String
  variantId      String? // quoted variant (mirrors the RFQ line)
  variantName    String? // snapshot at quote time
  offerId        String? // 7.6: the seller offer actually quoted — H1: the snapshot is the fact, never reconstructed from a live offer
  offer          ProductOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerVariantId String? // 7.6: the (offer, variant) quoted — D9 identity
  offerVariant   OfferVariant? @relation(fields: [offerVariantId], references: [id], onDelete: SetNull)
  availableStock Int? // 7.6/H1: applicable inventory at quote time (null = not inventoried)
  quantity       Int
  unitPrice      Float
  quote          Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqLine        RfqLine?      @relation(fields: [rfqLineId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@index([productId])
  @@index([rfqLineId]) // MYSQL-FK-INDEX: rfqLineId relation needs its own leftmost index
  @@index([offerId]) // 7.6 (MYSQL-FK-INDEX)
  @@index([offerVariantId]) // 7.6 (MYSQL-FK-INDEX)
}

// ── Server-side notification feed (RFQ / approval / message events) ─────────
// Order events stay derived client-side (NotificationsBell); this table
// covers everything the order list can't see.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // RFQ_SUBMITTED_SELLER | RFQ_QUOTE_RECEIVED | RFQ_QUOTE_ACCEPTED | RFQ_QUOTE_DECLINED | RFQ_QUOTE_WITHDRAWN | RFQ_QUOTE_CONVERTED | RFQ_STATUS | RFQ_MESSAGE | APPROVAL_REQUESTED | APPROVAL_DECIDED
  title     String
  body      String?   @db.Text // MYSQL: notification body, free-form
  linkView  String // SPA destination: rfq | orders | business | seller
  linkId    String? // rfqId / orderId / approval context id
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("Notifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATION EMAIL DIGEST (DIGEST-13)
// Rendered digest emails are BUILT and STORED here (branded inline-styled HTML);
// delivery goes through a pluggable transport. The bundled dev transport only
// logs, so status stays LOGGED until a real SMTP transport is wired in.
// ─────────────────────────────────────────────────────────────────────────────

model NotificationDigest {
  id          String   @id @default(cuid())
  userId      String
  kind        String // DAILY | WEEKLY
  periodStart DateTime
  periodEnd   DateTime
  itemCount   Int
  subject     String
  html        String   @db.MediumText // MYSQL: full branded inline-styled email HTML (16MB)
  status      String   @default("LOGGED") // LOGGED now; SENT when a transport is configured
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Per-user digest opt-in + cadence. No row (or OFF) = never included in batches.
model UserDigestPref {
  userId    String @id
  frequency String @default("OFF") // OFF | DAILY | WEEKLY
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Auth hardening (AUTHSEC-1): single-use, hashed, expiring tokens ─────────
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Negotiation thread on an RFQ — buyer ↔ admin ↔ involved sellers Q&A.
// Access mirrors getRfq (requester, admins, sellers quoted on or referenced by lines).
model RfqMessage {
  id        String   @id @default(cuid())
  rfqId     String
  authorId  String
  body      String   @db.Text // MYSQL: message body, free-form long content
  createdAt DateTime @default(now())
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  author    User     @relation("RfqMessages", fields: [authorId], references: [id])

  @@index([rfqId, createdAt])
  @@index([authorId]) // MYSQL-FK-INDEX: authorId relation needs its own leftmost index
}

// ─────────────────────────────────────────────────────────────────────────────
// Media library — uploaded images deduplicated by content hash (sha256) and
// processed into webp renditions by the storage pipeline. Product.images
// references the medium rendition URL; deletes are reference-checked.
// ─────────────────────────────────────────────────────────────────────────────

model MediaAsset {
  id               String                @id @default(cuid())
  key              String                @unique // storage base key (no extension)
  namespace        String                @default("public-media") // public-media | private-vault — 6.6.1: separate key roots; dedup NEVER crosses namespaces
  originalName     String
  mime             String
  size             Int
  width            Int?
  height           Int?
  sha256           String
  variants         String?               @db.Text // MYSQL: JSON {thumb,medium,large,full} storage keys
  uploadedById     String
  uploadedBy       User                  @relation("MediaAssets", fields: [uploadedById], references: [id])
  accountDocuments AccountDocument[]     @relation("AccountDocumentMedia")
  esignatures      ESignatureExecution[] @relation("ESignatureSignatures") // 10.4: signature-image evidence
  createdAt        DateTime              @default(now())

  @@unique([namespace, sha256])
  @@index([uploadedById, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dispute resolution (settings: Dispute Resolution panel) — buyer raises a
// dispute on a delivered/in-flight order against a specific seller; admins
// mediate and record an outcome. Escalation, response windows and outcome
// effects (rating penalty / verification loss) are enforced by the settings.
// ─────────────────────────────────────────────────────────────────────────────

model Dispute {
  id                String    @id @default(cuid())
  number            String    @unique // DSP-2026-000001
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id])
  raisedById        String // buyer (or admin acting for them)
  raisedBy          User      @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  sellerId          String // the disputed seller
  seller            User      @relation("DisputeSeller", fields: [sellerId], references: [id])
  rfqId             String? // loose FK: RFQ context when the order came from a quote
  reason            String // NOT_AS_DESCRIBED | DAMAGED | LATE_DELIVERY | WRONG_QUANTITY | QUALITY_ISSUE | PAYMENT_NOT_RECEIVED | OTHER
  description       String    @db.Text // MYSQL: dispute description, free-form long content
  amount            Float? // claimed amount (partial resolution support)
  status            String    @default("OPEN") // OPEN | SELLER_RESPONDED | ESCALATED | RESOLVED | CLOSED | CANCELLED
  sellerResponse    String?   @db.Text // MYSQL: seller's response, free-form
  sellerRespondedAt DateTime?
  escalateAt        DateTime? // autoEscalateDays deadline while unresolved
  outcome           String? // FULL_REFUND | PARTIAL_REFUND | REPLACEMENT | REPAIR | NO_ACTION | SELLER_PENALTY
  resolutionNote    String?   @db.Text // MYSQL: resolution note, free-form
  resolvedById      String?
  resolvedBy        User?     @relation("DisputeResolver", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([raisedById])
  @@index([sellerId])
  @@index([orderId])
  @@index([resolvedById]) // MYSQL-FK-INDEX: resolvedById relation needs its own leftmost index
}

// ─────────────────────────────────────────────────────────────────────────────
// Recurring RFQ schedules (settings: Recurring RFQs panel) — standing purchase
// requests that re-publish each cycle. The spawn engine (lazy sweep, like
// expiry) clones the line snapshot into a fresh RFQ when nextRunAt is due.
// ─────────────────────────────────────────────────────────────────────────────

model RecurringRfq {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  organizationId    String? // loose FK: org context for settings resolution
  title             String?
  description       String?   @db.Text // MYSQL: free-form description
  frequency         String // WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY | CUSTOM
  intervalDays      Int       @default(0) // CUSTOM: every N days
  lines             String    @db.Text // MYSQL: JSON snapshot of line inputs [{productId, variantId, productName, quantity, targetPrice, notes}]
  recipientIds      String?   @db.Text // MYSQL: JSON array of seller ids (keepSameRecipients)
  active            Boolean   @default(true)
  pausedUntil       DateTime?
  lastRunAt         DateTime?
  nextRunAt         DateTime
  previewNotifiedAt DateTime? // notifyBeforeHours heads-up sent flag
  emptyCycles       Int       @default(0) // consecutive spawned runs with zero quotes
  runCount          Int       @default(0)
  lastRfqId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([active, nextRunAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments — explicit money settlement for orders.
// Methods: CARD (simulated gateway — succeeds inline), BANK_TRANSFER (manual:
// buyer wires money, admin captures), INVOICE (NET-terms B2B flow from quote
// conversion). A payment row exists exactly when money is expected; SUCCEEDED
// flips the order to PAID.
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method       String // CARD | BANK_TRANSFER | INVOICE
  status       String    @default("PENDING") // PENDING | SUCCEEDED | FAILED | CANCELLED
  amount       Float
  currency     String    @default("USD")
  reference    String? // buyer-supplied transfer reference / gateway txn id
  instructions String?   @db.Text // MYSQL: manual-payment instructions snapshot for the buyer
  dueAt        DateTime? // INVOICE: NET-terms due date
  paidAt       DateTime?
  capturedById String?
  capturedBy   User?     @relation("PaymentsCapturedBy", fields: [capturedById], references: [id])
  note         String?   @db.Text // MYSQL: admin note on capture / failure
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([method, status])
  @@index([capturedById]) // MYSQL-FK-INDEX: capturedById relation needs its own leftmost index
}

// ─────────────────────────────────────────────────────────────────────────────
// Payouts — platform → seller settlement. A payout settles the seller's share
// (gross − commission) of all order items whose payment has SUCCEEDED and that
// have not been settled yet (OrderItem.payoutId IS NULL). Commission rate:
// vendor override (User.commissionRate) falling back to the platform default
// stored in PlatformSetting key "payouts".
// ─────────────────────────────────────────────────────────────────────────────

model Payout {
  id                     String        @id @default(cuid())
  number                 String        @unique // PY-2026-000001
  sellerId               String
  seller                 User          @relation("PayoutSeller", fields: [sellerId], references: [id])
  sellerOrgId            String? // 7.0: authoritative seller-org tenant receiving payment
  sellerOrg              Organization? @relation("PayoutSellerOrg", fields: [sellerOrgId], references: [id])
  periodStart            DateTime
  periodEnd              DateTime
  itemCount              Int           @default(0)
  grossAmount            Float         @default(0)
  commissionRate         Float // percent actually applied (snapshot)
  commission             Float         @default(0)
  netAmount              Float         @default(0)
  currency               String        @default("USD") // 7.2: explicit settlement currency
  status                 String        @default("PENDING") // PENDING | PAID | CANCELLED
  paidAt                 DateTime?
  note                   String?       @db.Text // MYSQL: free-form payout note
  // ── 7.4C: external transfer discipline (S4) ──
  transferReference      String? // bank/manually-confirmed transfer reference — REQUIRED to mark paid
  transferIdempotencyKey String?       @unique // derived from payout number + execution attempt; retries reuse it
  executedById           String? // actor who confirmed the transfer
  executedBy             User?         @relation("PayoutExecutedBy", fields: [executedById], references: [id])
  executedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  items OrderItem[]
  lines PayoutLine[] // 7.4B: the immutable settlement ledger

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([sellerOrgId]) // 7.0 (MYSQL-FK-INDEX)
  @@index([executedById]) // 7.4 (MYSQL-FK-INDEX)
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 7 (lastplan v5) — Financial integrity & multi-currency substrate.
// ─────────────────────────────────────────────────────────────────────────────

// 7.0 — the seller-org tenant profile: one per selling organization.
// Verification lives HERE (verificationState, per S3: verification ≠
// suspension); Organization.status stays the operational lifecycle.
// Store settings (logo/banner/policies/payout account) land here in 8.3.
model SellerProfile {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  organization      Organization @relation("SellerProfileOrg", fields: [organizationId], references: [id])
  ownerUserId       String
  owner             User         @relation("SellerProfileOwner", fields: [ownerUserId], references: [id])
  verificationState String       @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  verificationNote  String?      @db.Text // MYSQL: free-form verification note
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([verificationState])
  @@index([ownerUserId]) // MYSQL-FK-INDEX: ownerUserId relation needs its own leftmost index
}

// 7.4B — the immutable settlement ledger. Amount/commission/currency/FX fields
// are never UPDATEd after insert; only status transitions and appended entries.
// claimKey (the DB backstop): orderItemId for claim-purpose lines
// (SETTLEMENT/REISSUE) while PENDING/EFFECTIVE, else NULL — UNIQUE(claimKey)
// means at most one live settlement claim per order item, ever. REVERSAL
// lines never occupy the slot (an accounting fact, not a claim).
model PayoutLine {
  id               String    @id @default(cuid())
  payoutId         String
  orderItemId      String
  linePurpose      String // SETTLEMENT | REVERSAL | REISSUE
  amount           Float
  commission       Float
  currency         String    @default("USD")
  fxRate           Float? // FX snapshot on converted amounts (7.2)
  fxRateAt         DateTime?
  fxSource         String?
  status           String    @default("PENDING") // PENDING | EFFECTIVE | REVERSED | CANCELLED
  claimKey         String?   @unique
  reversalOfLineId String?
  effectiveAt      DateTime?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())

  payout     Payout       @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderItem  OrderItem    @relation(fields: [orderItemId], references: [id])
  reversalOf PayoutLine?  @relation("PayoutLineReversal", fields: [reversalOfLineId], references: [id])
  reversals  PayoutLine[] @relation("PayoutLineReversal")

  @@index([payoutId])
  @@index([orderItemId])
  @@index([status])
  @@index([reversalOfLineId]) // MYSQL-FK-INDEX
}

// 7.5 — durable recurring-RFQ run state with a fencing token (S5): Tx 1
// claims the unique run with a lease; Tx 2 executes CONDITIONED on the lease
// token — a stale worker whose lease expired can never create a duplicate.
model RecurringRfqRun {
  id             String   @id @default(cuid())
  scheduleId     String // loose FK to RecurringRfq.id — run history outlives the schedule
  dueAt          DateTime
  status         String   @default("CLAIMED") // CLAIMED | CREATED | FAILED
  leaseToken     String // random per claim; rewritten on reclaim — Tx 2 verifies it (fencing)
  leaseExpiresAt DateTime
  attempt        Int      @default(1)
  rfqId          String?
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scheduleId, dueAt]) // idempotency key
  @@index([status, leaseExpiresAt])
}

// 7.2 — multi-currency substrate: admin-managed currency list + rate history.
// Money rows carry explicit currency codes; conversions snapshot the rate.
model Currency {
  id        String   @id @default(cuid())
  code      String   @unique // ISO-4217: USD, YER, SAR
  name      String
  symbol    String?
  decimals  Int      @default(2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ratesAsBase  ExchangeRate[] @relation("RateBase")
  ratesAsQuote ExchangeRate[] @relation("RateQuote")

  @@index([isActive])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  baseCode  String
  quoteCode String
  rate      Float // 1 base = rate quote
  source    String   @default("ADMIN") // ADMIN | SEED | IMPORT
  validFrom DateTime @default(now())
  createdBy String?
  createdAt DateTime @default(now())

  base                    Currency             @relation("RateBase", fields: [baseCode], references: [code])
  quote                   Currency             @relation("RateQuote", fields: [quoteCode], references: [code])
  disbursementFxSnapshots DisbursementRecord[] @relation("DisbursementFxSnapshots") // 10.5: FX snapshot at disbursement confirm

  @@unique([baseCode, quoteCode, validFrom]) // one authoritative rate per instant
  @@index([quoteCode]) // MYSQL-FK-INDEX
}

// 7.7.2 — minimal per-seller-group fulfillment model (operational depth in
// 8.1). One row per (order × sellerOrgId); Order.fulfillmentStatus is the
// tested derivation over these groups.
model OrderFulfillment {
  id             String    @id @default(cuid())
  orderId        String
  sellerOrgId    String? // null = platform-facilitated group (items with no seller org)
  sellerId       String? // historical seller-account identity (7.0 three-concept model)
  status         String    @default("UNFULFILLED") // UNFULFILLED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order     Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrg Organization?          @relation("FulfillmentSellerOrg", fields: [sellerOrgId], references: [id])
  items     OrderFulfillmentItem[]

  @@index([orderId])
  @@index([sellerOrgId])
}

model OrderFulfillmentItem {
  id            String @id @default(cuid())
  fulfillmentId String
  orderItemId   String @unique
  quantity      Int    @default(1)

  fulfillment OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId]) // MYSQL-FK-INDEX
}

// 7.7.3 — refunds: obligation vs execution, item-level allocations (S7).
// REQUESTED → APPROVED (obligation established) → COMPLETED (only with
// execution evidence: a payment reference recorded by an authenticated
// actor). Corrections append REVERSAL entries on the payout ledger (7.4) —
// history is never rewritten. paymentStatus refund states derive ONLY from
// COMPLETED refunds' allocations.
model Refund {
  id               String    @id @default(cuid())
  number           String    @unique // RF-2026-000001
  orderId          String
  requestedById    String
  reason           String    @db.Text
  status           String    @default("REQUESTED") // REQUESTED | APPROVED | COMPLETED | DENIED | CANCELLED
  decidedNote      String?   @db.Text
  amountTotal      Float     @default(0) // sum of allocation buckets
  currency         String    @default("USD")
  paymentReference String? // execution evidence — REQUIRED to complete
  approvedById     String?
  approvedAt       DateTime?
  completedById    String?
  completedAt      DateTime?
  deniedAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order       Order              @relation(fields: [orderId], references: [id])
  requestedBy User               @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedBy  User?              @relation("RefundApprover", fields: [approvedById], references: [id])
  completedBy User?              @relation("RefundCompleter", fields: [completedById], references: [id])
  allocations RefundAllocation[]

  @@index([orderId])
  @@index([status])
  @@index([requestedById]) // MYSQL-FK-INDEX
  @@index([approvedById]) // MYSQL-FK-INDEX
  @@index([completedById]) // MYSQL-FK-INDEX
}

model RefundAllocation {
  id              String @id @default(cuid())
  refundId        String
  orderItemId     String
  quantity        Int    @default(1)
  amount          Float  @default(0) // items bucket for this allocation
  bucketShipping  Float  @default(0)
  bucketDiscounts Float  @default(0)
  bucketTaxes     Float  @default(0)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([refundId, orderItemId])
  @@index([orderItemId]) // MYSQL-FK-INDEX
}

// 7.6 — D9 OfferVariant: per-offer variant rows. The (offer, variant) pair
// is the purchase-time authority — price override, per-variant stock, sku,
// isActive. Catalog-level ProductVariant price/stock remain presentation
// defaults for the product owner's primary listing.
model OfferVariant {
  id        String   @id @default(cuid())
  offerId   String
  variantId String
  price     Float? // null = inherit the offer price
  stock     Int      @default(0)
  sku       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer   ProductOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  rfqLines   RfqLine[]
  quoteLines QuoteLine[]
  orderItems OrderItem[]

  @@unique([offerId, variantId])
  @@index([variantId]) // MYSQL-FK-INDEX
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform substrate — audit trail, number sequences, dynamic coupons.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // loose FK: SYSTEM entries have no user
  actorType  String // USER | SELLER | ADMIN | SYSTEM
  action     String // e.g. ORG_VERIFIED, RFQ_SUBMITTED, PRICELIST_UPDATED
  entityType String
  entityId   String?
  summary    String?  @db.Text // MYSQL: human-readable summary
  metadata   String?  @db.MediumText // MYSQL: JSON payload blob (16MB)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorType, action])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}

// ═══════════════════════════════════════════════════════════════════════════
// RBAC — roles, permissions & scoped assignments (mergedplan.md Phase 2)
//
// Answers owner gap #2/#3: full RBAC visibility, platform staff management
// with scoped roles, and per-organization team roles. Scope model:
//   • PLATFORM scope → UserRole.organizationId = "" (platform staff)
//   • ORG scope       → UserRole.organizationId = <org id> (team members)
// System roles are seeded by scripts/seed-rbac.ts and cannot be deleted;
// platform.super-admin is the only fully locked role. User.role stays as the
// legacy coarse column (BUYER/SELLER/ADMIN) — ADMIN is an implicit
// super-admin bypass everywhere; staff users keep role=BUYER and gain
// console access purely through role assignments.
// ═══════════════════════════════════════════════════════════════════════════

model Permission {
  key         String           @id // e.g. "financing.documents.verify"
  domain      String // catalog | vendors | financing | org-members | ... (UI grouping key)
  description String?          @db.Text // MYSQL: free-form help text
  roles       RolePermission[]

  @@index([domain])
}

model Role {
  id          String            @id @default(cuid())
  key         String            @unique // e.g. "platform.super-admin" | "org.admin" | "custom.platform.x"
  name        String
  description String?           @db.Text // MYSQL: free-form description
  scope       String // PLATFORM | ORG
  isSystem    Boolean           @default(false) // seeded, undeletable
  isProtected Boolean           @default(false) // RBACSEC-1: hidden & untouchable for non-super-admins (super-admin, org.owner)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  permissions RolePermission[]
  assignments UserRole[]
  invitations StaffInvitation[]

  @@index([scope])
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String   @default("") // "" = platform scope; otherwise org id (loose FK — keeps composite unique simple on MySQL)
  assignedAt     DateTime @default(now())
  assignedBy     String? // admin user id (loose FK)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model StaffInvitation {
  id             String    @id @default(cuid())
  email          String
  name           String?
  roleId         String
  organizationId String    @default("") // "" = platform staff
  tokenHash      String    @unique // Phase 6 (6.5): SHA-256 of the raw token — the raw token is shown once at invite time, never stored
  status         String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  invitedBy      String // admin user id (loose FK)
  invitedByName  String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  role           Role      @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([organizationId, status])
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 6 — MFA + persistent session registry (lastplan v5 6.7)
// ═══════════════════════════════════════════════════════════════════════════

// TOTP enrollment. secretEnc = AES-256-GCM ciphertext (key from the secret
// store — MFA_ENCRYPTION_KEY, never the DB credential). The plaintext secret
// exists only in memory during enrollment/verification (6.7.2).
model MfaEnrollment {
  id           String    @id @default(cuid())
  userId       String    @unique
  method       String    @default("TOTP") // TOTP (RFC 6238)
  secretEnc    String    @db.Text // AES-256-GCM payload — never logged, never returned after confirmation
  confirmedAt  DateTime? // null = started, not yet confirmed (no challenge until confirmed)
  lastTotpStep Int? // RFC 6238 §5.2 replay guard — a verified step is never accepted twice
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes MfaBackupCode[]

  @@index([userId])
}

// Single-use backup codes — salted scrypt hashes, each use flips usedAt and is
// audited; replay is rejected (6.7.3). Admin re-issue invalidates the set.
model MfaBackupCode {
  id           String    @id @default(cuid())
  enrollmentId String
  codeHash     String    @unique // salt:hash — same format as passwords
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  enrollment MfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

// Persistent session registry (6.7.7): every issued session token gets a row
// (tokenHash = SHA-256 of the cookie value). Revocation supports a single
// session (revokedAt) and all-sessions (sessionVersion bump stays the all-kill).
// mfaSatisfiedAt carries the step-up freshness window (6.7.5).
model SessionRegistry {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  userAgent      String?   @db.VarChar(400)
  ip             String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  revokedAt      DateTime?
  revokedReason  String?   @db.VarChar(120) // LOGOUT | REVOKED_BY_USER | REVOKED_BY_ADMIN | ALL_SESSIONS
  mfaSatisfiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Settings storage — platform key/value documents + scoped RFQ configuration
// ═══════════════════════════════════════════════════════════════════════════

// Generic platform-level documents (storefront config today).
model PlatformSetting {
  key       String   @id
  value     String   @db.MediumText // MYSQL: JSON document (16MB)
  updatedAt DateTime @updatedAt
}

// Hero banner slides (admin-managed, position-ordered).
model BannerSlide {
  id          String   @id @default(cuid())
  eyebrow     String?
  title       String?
  subtitle    String?
  image       String
  ctaLabel    String?
  ctaView     String?
  ctaCategory String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, position])
}

// Scoped RFQ configuration — one row per (panel, scope). Scope precedence
// (most specific wins): ORG/CATEGORY/REGION > ORG_TYPE > PLATFORM. scopeId is
// "" at platform scope; otherwise the org/type/category/region identifier.
model RfqSetting {
  id          String   @id @default(cuid())
  key         String // panel key, e.g. "quoteRouting"
  scopeType   String // PLATFORM | ORG_TYPE | ORG | CATEGORY | REGION
  scopeId     String   @default("")
  value       String   @db.MediumText // MYSQL: JSON document of the panel's fields (16MB)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

// Append-only settings change log — every field mutation is a row; rollback
// restores oldValue and is itself logged (rollbackOf chain). Deliberately NOT
// FK-linked to RfqSetting so history survives override deletion.
model SettingChange {
  id           String   @id @default(cuid())
  settingKey   String
  scopeType    String
  scopeId      String   @default("")
  field        String // field path within the panel
  oldValue     String?  @db.Text // MYSQL: JSON value snapshot
  newValue     String?  @db.Text // MYSQL: JSON value snapshot
  userId       String
  rollbackOfId String? // set when this change reverts an earlier one
  createdAt    DateTime @default(now())

  user User @relation("SettingChangeUser", fields: [userId], references: [id])

  @@index([settingKey, scopeType, scopeId, createdAt])
  @@index([userId]) // MYSQL-FK-INDEX: userId relation needs its own leftmost index
}

// Coupons moved from hardcoded constants to data (admin-managed).
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String   @db.Text // MYSQL: free-form coupon description
  percentOff     Int
  minSubtotal    Float    @default(0)
  firstOrderOnly Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

// ═════════════════════════════════════════════════════════════════════════════
// FINANCIER MODULE — FINANCIER_SCHEMA v5.0 (18 models, ZERO Json columns)
// Services not products (DP-22) · platform verification gate (DP-23) ·
// requirements engine (DP-24) · multi-financier sibling routing (DP-25) ·
// accreditation as a MAIN service (DP-26) · universal documents (DP-27) ·
// no open-broadcast distribution (DP-28).
// Money = Float (SQLite); statuses are string enums validated in TS/zod.

// ── 3.2 FinancierProfile — slim: financing facts ONLY; identity on Organization ──
model FinancierProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique // 1:1 — the legal entity (BANK | MFI | EWALLET)
  organization   Organization @relation("FinancierProfileOrg", fields: [organizationId], references: [id], onDelete: Cascade)

  about         String?  @db.Text // MYSQL: public marketing text (About tab)
  licenseNumber String?
  regulator     String?
  logoUrl       String? // MediaAsset-backed URL (existing pattern: User.image)
  contactEmail  String?
  contactPhone  String?
  minTicket     Float? // routing hint; service-level ranges remain authoritative
  maxTicket     Float?
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches    FinancierBranch[]
  services    FinancierService[]
  socialLinks FinancierSocialLink[]
  stories     FundingStory[]
  partners    Partner[]
  // (conditionTemplates live on Organization — R-2 single entry via organizationId)

  // ── Phase 10: financier operations (lastplan v5 §10) ──
  shariaCertifications ShariaCertification[] // 10.3: scholar certs w/ expiry + reminders
  contractTemplates    FinancingContractTemplate[] // 10.3: versioned, sha256-stamped
  riskConfig           RiskConfig? // 10.2: one scoring config per financier
  underwritingLimits   UnderwritingLimit[] // 10.7: branch × underwriter limit matrix

  @@index([organizationId])
}

// ── 3.3 FinancierBranch — typed address columns (no Json, no geo tables) ──
model FinancierBranch {
  id                 String           @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  name               String
  kind               String           @default("BRANCH") // BRANCH | AGENT | ATM
  street             String?          @db.Text // MYSQL: street address, free-form
  city               String?
  district           String?
  latitude           Float?
  longitude          Float?
  phone              String?
  isActive           Boolean          @default(true)
  position           Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  underwritingLimits UnderwritingLimit[] // 10.7: limits scoped to this branch

  @@index([financierProfileId, isActive])
}

// ── 3.4 FinancierService — THE offering (services, not products — DP-22) ──
model FinancierService {
  id                       String           @id @default(cuid())
  financierProfileId       String
  financierProfile         FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  serviceKind              String // FINANCING | ACCREDITATION (DP-22/DP-26)
  category                 String // FINANCING: WORKING_CAPITAL | INVOICE_FINANCING | PO_FINANCING | EQUIPMENT | VEHICLE | HOME | EDUCATION | AGRICULTURE | MICROENTERPRISE | SME | OTHER
  // ACCREDITATION: SUPPLIER_QUALIFICATION | VENDOR_APPROVAL
  name                     String
  summary                  String?          @db.Text // MYSQL: one-line card text
  description              String?          @db.Text // MYSQL: full service description
  targetSegment            String? // BUSINESS | INDIVIDUAL | BOTH (DP-13)
  status                   String           @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  currency                 String           @default("YER")
  amountMin                Float? // null = open (ACCREDITATION kinds)
  amountMax                Float? // competitor's currency.min/max folds HERE
  rateType                 String? // MURABAHA_ANNUAL | FIXED_ANNUAL | FLAT_FEE
  rateMax                  Float? // e.g. 30.000 = 30%/yr cap (murabaha)
  feeFlat                  Float?
  tenorMinMonths           Int?
  tenorMaxMonths           Int?
  repaymentFrequency       String? // MONTHLY | QUARTERLY | LUMP_SUM
  gracePeriodDays          Int?
  shariaCompliant          Boolean          @default(false)
  processingDays           Int?
  accreditationValidMonths Int? // ACCREDITATION kind: lifetime of the grant once ACCREDITED
  accreditationFeeAmount   Float? // ACCREDITATION kind: fee (invoiced externally, D-002)
  financingLimitText       String?          @db.Text // MYSQL: rich detail — financing limit display text
  targetAudience           String?          @db.Text // MYSQL: rich detail — who the program is for
  termsNote                String?          @db.Text // MYSQL: rich detail — terms callout (e.g. murabaha cap)
  guaranteeTypes           String?          @db.Text // MYSQL: rich detail — comma-separated guarantee kinds
  financingPeriods         String?          @db.Text // MYSQL: rich detail — comma-separated periods
  viewCount                Int              @default(0)
  // ── Phase 4: publish-approval workflow (same mechanism as products) ──
  reviewNote               String?          @db.Text // admin reject reason shown to the financier
  reviewedAt               DateTime?
  reviewedById             String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  attributes            FinancierServiceAttribute[] // features + eligibility text bullets
  coverage              FinancierServiceCoverage[] // geographic coverage (region NAMES — DP-16)
  requirements          ServiceRequirement[] // THE acceptance requirements
  financingRequests     FinancingRequest[] // kind = FINANCING (service-enforced)
  accreditationRequests AccreditationRequest[] // kind = ACCREDITATION (service-enforced)

  @@index([financierProfileId, status])
  @@index([serviceKind, category, status])
}

// ── 3.4a text-bullet traits (competitor "features" + "eligibility conditions") ──
model FinancierServiceAttribute {
  id        String           @id @default(cuid())
  serviceId String
  service   FinancierService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  kind      String // FEATURE | ELIGIBILITY_CONDITION
  position  Int              @default(0)
  text      String           @db.Text // MYSQL: bullet text, free-form

  @@unique([serviceId, kind, position])
  @@index([serviceId, kind])
}

// ── 3.4b geographic coverage — region names, no geo tables (DP-16) ──
model FinancierServiceCoverage {
  id         String           @id @default(cuid())
  serviceId  String
  service    FinancierService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  regionName String // normalized at write; matched case-insensitively vs FinancingRequest.activityCity

  @@unique([serviceId, regionName])
  @@index([serviceId])
}

// ── 3.5 THE REQUIREMENTS ENGINE (R-5) — ConditionTemplate + ConditionOption + ServiceRequirement ──
model ConditionTemplate {
  id              String        @id @default(cuid())
  scope           String // GENERAL | FINANCIER (R-5)
  organizationId  String? // null = GENERAL (platform library); set = FINANCIER (private)
  organization    Organization? @relation("FinancierConditionTemplates", fields: [organizationId], references: [id])
  conditionType   String // DOCUMENT | PROFILE_FIELD | DECLARATION | TEXT | NUMBER | DATE | SELECT | MULTI_SELECT
  code            String? // optional stable ref, e.g. "COM-REG" (uniqueness enforced in service layer)
  title           String
  description     String?       @db.Text // MYSQL: instructions shown to the applicant
  profileFieldKey String? // PROFILE_FIELD only — closed set, zod-validated
  documentType    String? // DOCUMENT only — expected AccountDocument.documentType
  validationMin   Float? // NUMBER only — inclusive lower bound
  validationMax   Float? // NUMBER only — inclusive upper bound
  validityMonths  Int? // evidence freshness window
  isRepeatable    Boolean       @default(false) // DOCUMENT only — multiple docs allowed
  isActive        Boolean       @default(true)
  createdById     String
  createdBy       User          @relation("ConditionTemplatesCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  options             ConditionOption[]
  serviceRequirements ServiceRequirement[]

  @@index([scope, organizationId, isActive])
  @@index([conditionType, isActive])
  @@index([organizationId]) // MYSQL-FK-INDEX: organizationId is 2nd col of the index above — MySQL needs it leftmost
  @@index([createdById]) // MYSQL-FK-INDEX: createdById relation needs its own leftmost index
}

// SELECT / MULTI_SELECT choices — every list a table (R-1).
model ConditionOption {
  id                  String            @id @default(cuid())
  conditionTemplateId String
  conditionTemplate   ConditionTemplate @relation(fields: [conditionTemplateId], references: [id], onDelete: Cascade)
  value               String // stored + displayed
  position            Int               @default(0)

  @@unique([conditionTemplateId, value])
  @@index([conditionTemplateId, position])
}

// The attachment: ONE template on ONE service, with per-service config.
model ServiceRequirement {
  id                  String            @id @default(cuid())
  serviceId           String
  service             FinancierService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  conditionTemplateId String
  conditionTemplate   ConditionTemplate @relation(fields: [conditionTemplateId], references: [id])
  isRequired          Boolean           @default(true) // optional conditions inform but never gate
  displayOrder        Int               @default(0)
  instructions        String?           @db.Text // MYSQL: financier's per-service override text
  autoPassAccredited  Boolean           @default(false) // auto-VERIFIED when applicant org holds a live accreditation from THIS financier (DP-26)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  submissions RequirementSubmission[]

  @@unique([serviceId, conditionTemplateId])
  @@index([serviceId, isActive, displayOrder])
  @@index([conditionTemplateId]) // MYSQL-FK-INDEX: conditionTemplateId is 2nd col of the unique above — MySQL needs it leftmost
}

// ── 3.6 RequirementSubmission — per-request checklist row + THE GATE's verification unit ──
model RequirementSubmission {
  id                   String             @id @default(cuid())
  serviceRequirementId String
  serviceRequirement   ServiceRequirement @relation(fields: [serviceRequirementId], references: [id], onDelete: Cascade)

  // parent: EXACTLY ONE set (service-enforced)
  financingRequestId     String?
  financingRequest       FinancingRequest?     @relation(fields: [financingRequestId], references: [id], onDelete: Cascade)
  accreditationRequestId String?
  accreditationRequest   AccreditationRequest? @relation(fields: [accreditationRequestId], references: [id], onDelete: Cascade)

  status            String           @default("PENDING") // PENDING | SUBMITTED | VERIFIED | REJECTED | WAIVED
  valueText         String?          @db.Text // MYSQL: TEXT / DECLARATION / SELECT answers
  valueNumber       Float? // NUMBER answers
  valueDate         DateTime? // DATE answers
  accountDocumentId String? // DOCUMENT evidence — REUSE of an AccountDocument
  accountDocument   AccountDocument? @relation(fields: [accountDocumentId], references: [id])
  submittedAt       DateTime?
  verifiedAt        DateTime?
  verifiedById      String? // the platform admin (or system for autoPass)
  verifiedBy        User?            @relation("RequirementSubmissionsVerifiedBy", fields: [verifiedById], references: [id])
  decisionNote      String?          @db.Text // MYSQL: rejection reason / waiver reason — shown to applicant
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([financingRequestId, serviceRequirementId])
  @@unique([accreditationRequestId, serviceRequirementId])
  @@index([status])
  @@index([serviceRequirementId]) // MYSQL-FK-INDEX: serviceRequirementId is 2nd col of both uniques above — MySQL needs it leftmost
  @@index([accountDocumentId]) // MYSQL-FK-INDEX: accountDocumentId relation needs its own leftmost index
  @@index([verifiedById]) // MYSQL-FK-INDEX: verifiedById relation needs its own leftmost index
}

// ── 3.7 AccountDocument + RequestAttachment — universal documents (R-2, DP-27) ──
model AccountDocument {
  id             String        @id @default(cuid())
  userId         String // owner/uploader — ALWAYS set
  user           User          @relation("AccountDocumentsOwner", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String? // org-scope docs; null = personal
  organization   Organization? @relation("OrganizationAccountDocuments", fields: [organizationId], references: [id])
  mediaId        String // THE storage entry: MediaAsset carries key/originalName/mime/size/sha256/renditions
  media          MediaAsset    @relation("AccountDocumentMedia", fields: [mediaId], references: [id])
  documentType   String // NATIONAL_ID | PASSPORT | RESIDENCE_PERMIT | COMMERCIAL_REG | TAX_CARD | BUSINESS_LICENSE | BANK_STATEMENT | FINANCIAL_STATEMENT | PROOF_OF_ADDRESS | GUARANTEE_DOC | FEASIBILITY_STUDY | INVOICE | PURCHASE_ORDER | PROJECT_FILE | OTHER
  title          String?
  issuedAt       DateTime? // document's own issue date
  expiresAt      DateTime? // freshness vs ConditionTemplate.validityMonths
  status         String        @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewedById   String?
  reviewedBy     User?         @relation("AccountDocumentsReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  note           String?       @db.Text // MYSQL: verification / rejection note
  isActive       Boolean       @default(true) // soft-delete
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  submissions        RequirementSubmission[]
  requestAttachments RequestAttachment[]     @relation("RequestAttachmentDocument")
  vaultAccessGrants  VaultAccessGrant[]      @relation("VaultAccessGrants")

  @@index([userId, documentType, status])
  @@index([organizationId])
  @@index([mediaId])
  @@index([reviewedById]) // MYSQL-FK-INDEX: reviewedById relation needs its own leftmost index
}

// ── 3.7b VaultAccessGrant — one-time, short-TTL retrieval grants for private-vault
// documents (6.6.4). Every issued /api/vault URL carries a unique nonce backed
// by a row here; retrieval consumes the row atomically (updateMany WHERE
// consumedAt IS NULL — 1 row or reject). Issuance (DOCUMENT_URL_ISSUED) and
// actual retrieval (DOCUMENT_FILE_RETRIEVED) are distinct audit events. ──
model VaultAccessGrant {
  id         String          @id @default(cuid())
  documentId String
  document   AccountDocument @relation("VaultAccessGrants", fields: [documentId], references: [id], onDelete: Cascade)
  userId     String // the user the URL was issued to (bound into the HMAC)
  user       User            @relation("VaultAccessGrants", fields: [userId], references: [id], onDelete: Cascade)
  nonce      String          @unique // random 48-hex — one-time use, atomic consume
  basis      String          @default("OWNER") // OWNER | PLATFORM_REVIEWER | ORG_MEMBER | FINANCIER_SCOPE — 6.8 access basis at issuance
  expiresAt  DateTime // minutes-TTL (default 5) — enforced at retrieval, not just by signature
  consumedAt DateTime? // set exactly once by the proxy route; replay ⇒ reject
  issuedIp   String? // best-effort caller IP at issuance
  createdAt  DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([documentId, createdAt])
  @@index([expiresAt]) // expired-grant reaper
}

// Free-form request attachments not tied to a specific requirement (loose-parent pattern).
model RequestAttachment {
  id                String          @id @default(cuid())
  parentType        String // FINANCING_REQUEST | ACCREDITATION_REQUEST
  parentId          String // loose FK (Dispute pattern)
  accountDocumentId String
  accountDocument   AccountDocument @relation("RequestAttachmentDocument", fields: [accountDocumentId], references: [id], onDelete: Cascade)
  kind              String // GUARANTEE_DOC | STUDY | PROJECT_FILE | OTHER
  createdAt         DateTime        @default(now())

  @@index([parentType, parentId])
  @@index([accountDocumentId])
}

// ── 3.8 FinancingRequest v3 — the financing application (FR-YYYY-###### via Sequence 'FIN') ──
model FinancingRequest {
  id     String @id @default(cuid())
  number String @unique

  // WHO — references ONLY (R-2)
  organizationId String? // applicant org (B2B); null = individual (DP-13)
  organization   Organization? @relation("FinancingRequestsByOrg", fields: [organizationId], references: [id])
  createdById    String
  createdBy      User          @relation("FinancingRequests", fields: [createdById], references: [id])

  // WHAT SERVICE — REQUIRED, service-scoped (DP-22)
  serviceId  String
  service    FinancierService @relation(fields: [serviceId], references: [id])
  targetType String // WORKING_CAPITAL | QUOTE | ORDER | RFQ_LINE
  targetId   String? // quote/order/rfqLine id (loose FK)

  // MULTI-FINANCIER ROUTING (DP-25): null = exclusive; set = sibling group
  multiGroupId String?

  // ACTIVITY (wizard step 2)
  activityStatus        String?
  activityName          String?
  activityDescription   String?   @db.Text // MYSQL: free-form activity description
  activityStartDate     DateTime?
  activityCity          String?
  activityDistrict      String?
  activityAddress       String?   @db.Text // MYSQL: street address, free-form
  activityLocationType  String? // OWNED | RENTED
  activityCategory      String?
  activityCategoryOther String?

  // UNDERWRITING INPUTS
  capitalAmount              Float?
  ownContributionAmount      Float?
  monthlyInstallmentCapacity Float?
  previousFinancing          Boolean?
  otherIncomeSources         String?  @db.Text // MYSQL: free-form income listing

  // THE ASK
  amountRequested      Float
  currency             String  @default("YER")
  purpose              String? @db.Text // MYSQL: free-form purpose text
  tenorRequestedMonths Int?

  // GUARANTEE
  guaranteeType        String? // PERSONAL_GUARANTEE | BANK_GUARANTEE | GOLD | COMMERCIAL | MORTGAGE | CONVERTIBLE_SECURITIES | SELF_GUARANTEE | OTHER
  guaranteeTypeOther   String?
  guaranteeStatus      String? // AVAILABLE | PARTIALLY_AVAILABLE | UNAVAILABLE | OTHER
  guaranteeStatusOther String?

  // CONSENT
  applicantNotes String?   @db.Text // MYSQL: free-form applicant notes
  consentAt      DateTime?

  // THE PLATFORM GATE (R-4, DP-23)
  platformReviewedById String?
  platformReviewedBy   User?     @relation("FinancingPlatformReviews", fields: [platformReviewedById], references: [id])
  platformReviewedAt   DateTime?
  platformNote         String?   @db.Text // MYSQL: free-form gate note
  returnedAt           DateTime?
  returnedReason       String?   @db.Text // MYSQL: free-form return reason
  forwardedAt          DateTime?

  // LIFECYCLE (§5.1)
  status      String    @default("DRAFT")
  expiresAt   DateTime?
  submittedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions    RequirementSubmission[]
  offers         FinancingOffer[]
  riskAssessment RiskAssessment? // 10.2: latest computed assessment (one per request)

  @@index([organizationId, status])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([serviceId])
  @@index([multiGroupId])
  @@index([targetType, targetId])
  @@index([activityCity])
}

// ── 3.9 FinancingOffer + installments (schedule proposed by the financier — R-1) ──
model FinancingOffer {
  id                 String           @id @default(cuid())
  requestId          String
  request            FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdById        String // financier staff User
  createdBy          User             @relation("FinancingOffers", fields: [createdById], references: [id])
  amount             Float
  currency           String           @default("YER")
  rateType           String? // MURABAHA_ANNUAL | FIXED_ANNUAL | FLAT_FEE
  ratePercent        Float?
  feeFlat            Float?
  tenorMonths        Int
  collateralRequired String?          @db.Text // MYSQL: from the guarantee taxonomy (§3.8), free-form
  notes              String?          @db.Text // MYSQL: free-form offer notes
  validUntil         DateTime?
  status             String           @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED | WITHDRAWN
  sentAt             DateTime?
  acceptedAt         DateTime?
  declinedAt         DateTime?
  withdrawnAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  installments FinancingOfferInstallment[]
  agreement    FinancingAgreement?

  @@index([requestId, status])
  @@index([createdById]) // MYSQL-FK-INDEX: createdById relation needs its own leftmost index
}

model FinancingOfferInstallment {
  id            String                  @id @default(cuid())
  offerId       String
  offer         FinancingOffer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  amount        Float
  allocations   InstallmentAllocation[] // 10.8: how received payments were applied here

  @@unique([offerId, installmentNo])
  @@index([offerId, dueDate])
}

// ── 3.10 FinancingAgreement — references the accepted offer; NO terms snapshot (DP-20) ──
model FinancingAgreement {
  id                String         @id @default(cuid())
  number            String         @unique // AGR-YYYY-###### via Sequence 'AGR'
  offerId           String         @unique // the ACCEPTED offer — service FREEZES it
  offer             FinancingOffer @relation(fields: [offerId], references: [id])
  fundingStatus     String         @default("PENDING") // PENDING | REPORTED_FUNDED | REPORTED_SETTLED
  status            String         @default("ACTIVE") // ACTIVE | COMPLETED | DEFAULTED | CANCELLED
  acceptedAt        DateTime
  fundedReportedAt  DateTime?
  settledReportedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  events FinancingEvent[]
  fees   FinancingFee[]

  // ── Phase 10: financier operations (lastplan v5 §10) ──
  installmentPayments    InstallmentPayment[] // 10.8: the buyer-obligation ledger
  paymentReconciliations PaymentReconciliation[] // 10.8: rail-vs-ledger discrepancy queue
  disbursement           DisbursementRecord? // 10.5: queue → confirm w/ rail ref + FX snapshot
  esignature             ESignatureExecution? // 10.4: evidence package
  financedOrders         Order[]                 @relation("FinancedOrders") // 10.9: Murabaha-checkout orders financed by this agreement

  @@index([status])
}

// ── 3.11 FinancingEvent — track-only ledger (D-002) ──
model FinancingEvent {
  id           String             @id @default(cuid())
  agreementId  String
  agreement    FinancingAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  type         String // DISBURSEMENT | REPAYMENT | EARLY_SETTLEMENT | LATE_FEE | NOTE
  eventDate    DateTime
  amount       Float?
  note         String?            @db.Text // MYSQL: free-form ledger note
  reportedById String?
  reportedBy   User?              @relation("FinancingEventsReportedBy", fields: [reportedById], references: [id])
  createdAt    DateTime           @default(now())

  @@index([agreementId, eventDate])
  @@index([reportedById]) // MYSQL-FK-INDEX: reportedById relation needs its own leftmost index
}

// ── 3.12 FinancingFee — commission accounting, invoiced externally (D-001/002) ──
model FinancingFee {
  id             String             @id @default(cuid())
  agreementId    String
  agreement      FinancingAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  type           String // SUCCESS | ORIGINATION | ACCREDITATION
  baseAmount     Float
  percentApplied Float // snapshot of the configured rate at accrual
  amount         Float
  status         String             @default("ACCRUED") // ACCRUED | INVOICED | PAID | WAIVED
  invoicedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([agreementId, type, status])
  @@index([status, createdAt])
}

// ── 3.13 AccreditationRequest — the QUALIFICATION & ACCREDITATION flow (MAIN service — DP-26) ──
model AccreditationRequest {
  id     String @id @default(cuid())
  number String @unique // ACC-YYYY-###### via Sequence 'ACC'

  // WHO — companies only
  organizationId String
  organization   Organization @relation("AccreditationRequestsByOrg", fields: [organizationId], references: [id])
  submittedById  String
  submittedBy    User         @relation("AccreditationsSubmitted", fields: [submittedById], references: [id])

  // WHAT — the financier's ACCREDITATION-kind service (service-enforced)
  serviceId String
  service   FinancierService @relation(fields: [serviceId], references: [id])

  // MULTI-FINANCIER ROUTING (DP-25)
  multiGroupId String?

  scopeNotes String?   @db.Text // MYSQL: free-form scope notes
  consentAt  DateTime?

  // THE PLATFORM GATE (R-4)
  platformReviewedById String?
  platformReviewedBy   User?     @relation("AccreditationPlatformReviews", fields: [platformReviewedById], references: [id])
  platformReviewedAt   DateTime?
  platformNote         String?   @db.Text // MYSQL: free-form gate note
  returnedAt           DateTime?
  returnedReason       String?   @db.Text // MYSQL: free-form return reason
  forwardedAt          DateTime?

  // LIFECYCLE (§5.2)
  status           String    @default("DRAFT") // DRAFT | SUBMITTED | UNDER_PLATFORM_REVIEW | RETURNED_FOR_COMPLETION | FORWARDED_TO_FINANCIER | UNDER_FINANCIER_REVIEW | ACCREDITED | REJECTED | EXPIRED | REVOKED | CANCELLED
  submittedAt      DateTime?
  decidedById      String?
  decidedBy        User?     @relation("AccreditationsDecidedBy", fields: [decidedById], references: [id])
  decidedAt        DateTime?
  decisionNote     String?   @db.Text // MYSQL: free-form decision note
  accreditedAt     DateTime?
  validUntil       DateTime? // grant lifetime — service.accreditationValidMonths default
  revokedById      String?
  revokedBy        User?     @relation("AccreditationsRevokedBy", fields: [revokedById], references: [id])
  revokedAt        DateTime?
  revocationReason String?   @db.Text // MYSQL: free-form revocation reason
  expiresAt        DateTime? // REQUEST-level expiry (pre-decision)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  submissions RequirementSubmission[]

  // ── 7.8: renewal history + DB-derived active marker ──
  activeKey    Int? // 1 for ACTIVE_SET statuses, NULL terminal — maintained by DB triggers (scripts/sql/accreditation-constraints.sql); application code NEVER sets it
  supersedesId String? // the ACCREDITED record this renewal replaces
  supersedes   AccreditationRequest?  @relation("AccreditationSupersedes", fields: [supersedesId], references: [id])
  supersededBy AccreditationRequest[] @relation("AccreditationSupersedes")

  @@unique([serviceId, organizationId, activeKey]) // 7.8: at most one LIVE request per program/org; terminal rows (activeKey NULL) keep unlimited history — multiple NULLs are legal
  @@index([organizationId, status])
  @@index([status, createdAt])
  @@index([multiGroupId])
  @@index([validUntil])
  @@index([supersedesId]) // 7.8 (MYSQL-FK-INDEX)
  @@index([submittedById]) // MYSQL-FK-INDEX: submittedById relation needs its own leftmost index
  @@index([platformReviewedById]) // MYSQL-FK-INDEX: platformReviewedById relation needs its own leftmost index
  @@index([decidedById]) // MYSQL-FK-INDEX: decidedById relation needs its own leftmost index
  @@index([revokedById]) // MYSQL-FK-INDEX: revokedById relation needs its own leftmost index
}

// ═══════════════════════════════════════════════════════════════════════════
// SITE — public website (pagedesign.md Phase 0): contact form + newsletter
