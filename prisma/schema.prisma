  solutionId String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  position   Int      @default(0)
  icon       String?
  title      String
  body       String?  @db.Text // MYSQL: feature explanation

  @@index([solutionId]) // MYSQL-FK-INDEX: solutionId relation needs its own leftmost index
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3 — Phone-OTP auth · KYC/KYP · WhatsApp notification channel
// ═══════════════════════════════════════════════════════════════════════════

// One-time passcodes for phone-first auth. Keyed by normalized E.164 phone,
// purpose-scoped, SHA-256-hashed at rest, single-use, attempt-capped.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String // normalized E.164 (+9677XXXXXXXXX)
  purpose    String // REGISTER | RESET (LOGIN reserved for future passwordless)
  codeHash   String // sha256(code)
  expiresAt  DateTime // 5-minute TTL
  attempts   Int       @default(0) // max 5 verify tries then burn
  consumedAt DateTime? // single-use burn
  ip         String? // issuance IP (abuse forensics)
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

// WhatsApp sending numbers ("senders") — the platform OWNER pairs any
// international SIM (+967…, +966…) from the admin console via a pairing code
// typed into WhatsApp → Linked devices. Session creds persist here so the
// mini-service survives restarts; owner can disconnect / replace anytime.
model WhatsAppSender {
  id           String    @id @default(cuid())
  label        String // display name, e.g. "Vendora main line"
  phoneNumber  String    @unique // E.164 — the number users receive messages FROM
  status       String    @default("PENDING_PAIRING") // PENDING_PAIRING | PAIRED | DISCONNECTED | FAILED
  credsJson    String?   @db.MediumText // Baileys session credentials (encrypted-at-rest candidate)
  pairingCode  String? // 8-char code the owner types on their phone (pairing flow)
  codeIssuedAt DateTime? // when the CURRENT pairing code was issued (codes expire in ~2-3 min)
  qrExpiresAt  DateTime?
  isDefault    Boolean   @default(false) // the active outbound line
  lastUsedAt   DateTime?
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages WhatsAppMessage[]

  @@index([status])
}

// Outbound WhatsApp log — every send is auditable + debuggable. Doubles as
// the delivery ledger when the channel fans out to email/SMS twins later.
model WhatsAppMessage {
  id             String          @id @default(cuid())
  senderId       String?
  sender         WhatsAppSender? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  toPhone        String // E.164
  template       String // OTP | NOTIFICATION | TEST | CUSTOM
  body           String          @db.Text
  status         String          @default("QUEUED") // QUEUED | SENT | FAILED
  error          String?         @db.Text
  userId         String? // recipient user (null for pre-account OTP)
  notificationId String? // mirrored in-app Notification when applicable
  campaignId     String? // WA-BIZ: bulk campaign this send belongs to
  createdAt      DateTime        @default(now())
  sentAt         DateTime?

  @@index([toPhone, createdAt])
  @@index([status, createdAt])
  @@index([userId])
  @@index([campaignId])
}

// WA-BIZ — reusable message templates with {{placeholder}} variables.
// Rendered at send time; usage counts feed the admin console KPIs.
model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String   @unique // slug, e.g. "order-shipped"
  category  String   @default("MARKETING") // MARKETING | UTILITY | NOTIFICATION | CUSTOM
  language  String   @default("ar") // ar | en — display hint for the editor
  body      String   @db.Text // supports {{name}}-style placeholders
  status    String   @default("DRAFT") // DRAFT | APPROVED | ARCHIVED
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns BulkCampaign[]
}

// WA-BIZ — chatbot auto-reply rules. Evaluated by the mini-service on every
// incoming message (priority asc, first match wins) and replied on the same
// paired line. hits++ on every fire for the console analytics.
model ChatbotRule {
  id        String   @id @default(cuid())
  name      String // human label, e.g. "Working hours"
  matchType String   @default("CONTAINS") // CONTAINS | EXACT | STARTS_WITH | REGEX
  pattern   String   @db.Text // keyword / regex source (case-insensitive)
  reply     String   @db.Text // sent back when matched
  active    Boolean  @default(true)
  priority  Int      @default(100) // lower runs first
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// WA-BIZ — bulk sending campaigns. Audience is resolved ONCE at creation into
// a phone snapshot so later user changes never mutate a running campaign.
model BulkCampaign {
  id          String            @id @default(cuid())
  name        String
  body        String            @db.Text // body with {{placeholders}} — rendered per-recipient at send time
  variables   String?           @db.Text // JSON key/value map for CUSTOM vars ({{discount}} etc.) authored in the dialog
  templateId  String?
  template    WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  audience    String            @default("CUSTOM") // ALL_USERS | BUYERS | SELLERS | CUSTOM
  phones      String?           @db.Text // newline-separated E.164 snapshot
  status      String            @default("DRAFT") // DRAFT | QUEUED | SENDING | PAUSED | COMPLETED | CANCELLED | FAILED
  total       Int               @default(0)
  sent        Int               @default(0)
  failed      Int               @default(0)
  createdBy   String? // admin user id
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

// WA-CHAT — unified conversation inbox. Every inbound WhatsApp message opens
// (or resumes) a thread; the public webchat widget creates WEBCHAT threads.
// The admin "Chats" tab is a WhatsApp-Web-like console over these rows.
model WhatsAppChatThread {
  id              String   @id @default(cuid())
  phone           String? // E.164 (WhatsApp threads: the contact; WEBCHAT: visitor phone when given)
  waJid           String? // raw WhatsApp jid (@s.whatsapp.net) — unique per WA thread
  source          String   @default("WHATSAPP") // WHATSAPP | WEBCHAT
  name            String   @default("") // display name (pushName / visitor / user)
  publicToken     String?  @unique // WEBCHAT only — unguessable widget session key
  userId          String? // linked platform user when the phone matches an account
  unreadCount     Int      @default(0)
  lastMessageAt   DateTime @default(now())
  lastMessageBody String?  @db.Text
  autoReply       Boolean  @default(true) // per-thread auto-reply switch (agent mode takes over when off)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages WhatsAppChatMessage[]

  @@unique([waJid])
  @@index([lastMessageAt])
  @@index([source])
  @@index([publicToken])
}

// WA-CHAT — one bubble per row. IN = from the contact/visitor, OUT = sent by
// auto-reply or a human agent from the admin console.
model WhatsAppChatMessage {
  id        String             @id @default(cuid())
  threadId  String
  thread    WhatsAppChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction String // IN | OUT
  body      String             @db.Text
  author    String? // 'auto-reply' | 'agent' | 'visitor' | rule name
  createdAt DateTime           @default(now())

  @@index([threadId, createdAt])
}

// Per-user channel toggles — the in-app bell is ALWAYS on; WhatsApp / email /
// SMS are opt-out per channel ("3 channels + system notifications" owner spec).
model UserNotificationPref {
  userId   String  @id
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsapp Boolean @default(true)
  email    Boolean @default(true)
  sms      Boolean @default(false) // off until an SMS gateway is wired

  updatedAt DateTime @updatedAt
}

// KYP — Know Your Product. Certification/compliance artifacts attached to the
// product itself (shared by every future offer on it, per Phase 4 product/offer
// split). Admin-verified → "Verified specs" badge on the storefront.
model ProductCertification {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind         String // DATASHEET | WARRANTY | ORIGIN | TEST_REPORT | CERTIFICATE | OTHER
  title        String
  mediaId      String? // vault-backed MediaAsset when uploaded
  url          String? // external link when provided
  issuedBy     String? // certifying body / manufacturer
  issuedAt     DateTime?
  expiresAt    DateTime?
  status       String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  verifiedById String?
  verifiedBy   User?     @relation("CertificationsVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  note         String?   @db.Text
  isActive     Boolean   @default(true) // soft-delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([productId, kind, status])
  @@index([verifiedById]) // MYSQL-FK-INDEX: verifiedById relation needs its own leftmost index
}

// Structured specs — companies never touch JSON. Admin defines the attribute
// dictionary per category (null categoryId = global); sellers fill a real form;
// Product.specs JSON stays as the storage format, now generated from this.
model SpecAttribute {
  id         String    @id @default(cuid())
  categoryId String? // null = available to EVERY category
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String // machine key: "wattage"
  label      String // human label: "Rated power"
  dataType   String    @default("TEXT") // TEXT | NUMBER | SELECT | BOOLEAN
  unit       String? // "W", "V", "kg"
  options    String?   @db.Text // SELECT: JSON array ["Monocrystalline","Polycrystalline"]
  required   Boolean   @default(false)
  position   Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([categoryId, key]) // MySQL: NULL categoryId rows not enforced — service layer dedupes global keys
  @@index([isActive, position])
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 5 — Module activation system (mergedplan.md §6 Phase 5.3)
//
// What can be switched on/off per scope — the substrate for subscription
// tiers (a tier = a bundle of enabled modules + limits). Resolution chain
// (most specific wins, Phase-2-scope-model style):
//     ORG activation  >  ORG_TYPE activation  >  PLATFORM activation  >  default
// `core` modules (retail marketplace itself) cannot be switched off — the
// API refuses and the admin UI hides the switch.
// ═══════════════════════════════════════════════════════════════════════════

model ModuleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique // "financing-hub" | "rfq" | "financier-console" | …
  name        String // "Financing Hub"
  description String?  @db.Text
  // Where the module surfaces — informational for the admin matrix grouping:
  // STOREFRONT | BUYER | SELLER | FINANCIER | PLATFORM
  domain      String   @default("STOREFRONT")
  core        Boolean  @default(false) // true = cannot be deactivated (marketplace core)
  defaultOn   Boolean  @default(true) // effective when no activation row exists
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true) // admin can retire a module from the catalog
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activations ModuleActivation[]
}

model ModuleActivation {
  id          String   @id @default(cuid())
  moduleKey   String
  // PLATFORM ("") | ORG_TYPE ("BANK" | "MFI" | "EWALLET" | "COMPANY") | ORG (<org id>)
  scopeType   String
  scopeId     String   @default("") // "" for PLATFORM; type key or org id otherwise
  enabled     Boolean  @default(true) // false = explicitly off at this scope
  note        String?  @db.Text
  changedById String? // admin user id (loose FK — audit trail in AuditLog too)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module ModuleDefinition @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@unique([moduleKey, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

// ── Phase 9.4: publication agreement management ──────────────────────────────
// Versioned Publication Agreement templates (admin-managed — no hardcoded
// agreement text in code) + the immutable consent ledger. Exactly ONE template
// is active at a time (enforced by activateTemplate in the service layer);
// existing consents keep pointing at the version the seller actually accepted,
// so every historical acceptance stays reproducible.
model PublicationAgreementTemplate {
  id          String               @id @default(cuid())
  version     String               @unique // e.g. "v2"
  title       String
  body        String               @db.Text // the agreement markdown/text sellers accept
  isActive    Boolean              @default(false) // exactly ONE active template recommended (enforce in service: activating one deactivates others)
  createdById String?
  createdBy   User?                @relation("AgreementsAuthored", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  consents    PublicationConsent[]
}

model PublicationConsent {
  id           String                       @id @default(cuid())
  templateId   String
  template     PublicationAgreementTemplate @relation(fields: [templateId], references: [id])
  productId    String?
  product      Product?                     @relation("ProductAgreementConsents", fields: [productId], references: [id])
  userId       String // the seller who consented
  user         User                         @relation("AgreementConsents", fields: [userId], references: [id])
  productTitle String? // snapshot for export even if product later deleted
  acceptedAt   DateTime                     @default(now())
  ipAddress    String?

  @@unique([templateId, userId, productId]) // one consent per (template, user, product); product-less consents have productId null
  @@index([templateId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE 10 (lastplan v5 §10) — FINANCIER OPERATIONS. ZERO Json columns
// (module convention); JSON payloads are String @db.MediumText (AuditLog
// pattern). Money is Float per the module's existing convention; the buyer
// obligation ledger (10.8) derives aging/NPL from ALLOCATED state, never
// from track-only rows.
// ─────────────────────────────────────────────────────────────────────────

// ── 10.8 InstallmentPayment — how buyer payments are RECEIVED. A reversal
// is a NEW row referencing the original (reversalOfId) — never a rewrite of
// history. Allocation waterfalls over installments are InstallmentAllocation
// rows; over/under-payment and partial allocation rules live in the service. ──
model InstallmentPayment {
  id                String               @id @default(cuid())
  agreementId       String
  agreement         FinancingAgreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  receivedAt        DateTime
  channel           String // BANK_TRANSFER | CASH | AGENT | RAIL_EXPORT | OTHER
  reference         String? // payment-rail reference / receipt number
  amount            Float
  currency          String               @default("YER")
  fxRateToAgreement Float? // snapshot: received currency → agreement currency, if different
  status            String               @default("RECEIVED") // RECEIVED | PARTIALLY_ALLOCATED | ALLOCATED | PARTIALLY_REVERSED | REVERSED
  note              String?              @db.Text
  recordedById      String
  recordedBy        User                 @relation("InstallmentPaymentsRecordedBy", fields: [recordedById], references: [id])
  reversalOfId      String? // set on the REVERSAL row → the original payment being (partially) reversed
  reversalOf        InstallmentPayment?  @relation("InstallmentPaymentReversals", fields: [reversalOfId], references: [id])
  reversals         InstallmentPayment[] @relation("InstallmentPaymentReversals")
  reconciledAt      DateTime? // last reconciliation batch that saw this row
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  allocations InstallmentAllocation[]

  @@index([agreementId, receivedAt])
  @@index([status])
  @@index([recordedById]) // MYSQL-FK-INDEX: recordedById relation needs its own leftmost index
  @@index([reversalOfId]) // MYSQL-FK-INDEX: reversalOfId relation needs its own leftmost index
}

// ── 10.8 InstallmentAllocation — how a payment's amount was APPLIED to the
// installment schedule (order + partial amounts). Effective paid per
// installment = Σ allocations of non-reversed payments − Σ allocations of
// reversal rows. Aging/NPL and late fees derive from THIS, not from
// track-only FinancingEvent rows. ──
model InstallmentAllocation {
  id            String                    @id @default(cuid())
  paymentId     String
  payment       InstallmentPayment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment   FinancingOfferInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Float
  createdAt     DateTime                  @default(now())

  @@unique([paymentId, installmentId]) // one allocation line per payment × installment
  @@index([installmentId]) // MYSQL-FK-INDEX: installmentId relation needs its own leftmost index
}

// ── 10.8 PaymentReconciliation — daily batch vs. rail exports; discrepancy
// queue. One row per (agreement × batchDate). ──
model PaymentReconciliation {
  id             String             @id @default(cuid())
  agreementId    String
  agreement      FinancingAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  batchDate      DateTime // the rail-export day (date-only semantics; service normalizes)
  railExpected   Float // sum per the rail export for that day
  ledgerActual   Float // sum of non-reversed payments receivedAt in that day
  difference     Float // ledgerActual − railExpected
  status         String             @default("OPEN") // OPEN | RESOLVED
  resolutionNote String?            @db.Text
  resolvedById   String?
  resolvedBy     User?              @relation("PaymentReconciliationsResolvedBy", fields: [resolvedById], references: [id])
  createdAt      DateTime           @default(now())
  resolvedAt     DateTime?

  @@unique([agreementId, batchDate])
  @@index([status, batchDate])
}

// ── 10.5 DisbursementRecord — queue → confirm. Confirmation requires the
// payment-rail reference and captures an FX snapshot (ExchangeRate row +
// denormalized value) when the disbursement currency differs from the
// agreement currency. One per agreement. ──
model DisbursementRecord {
  id             String             @id @default(cuid())
  agreementId    String             @unique
  agreement      FinancingAgreement @relation(fields: [agreementId], references: [id])
  status         String             @default("QUEUED") // QUEUED | CONFIRMED | CANCELLED
  currency       String             @default("YER")
  amount         Float // disbursed amount (defaults from the accepted offer)
  rail           String? // BANK | CASH | WALLET | OTHER — required at confirm
  reference      String? // payment-rail reference — required at confirm
  exchangeRateId String? // FX snapshot link (agreement currency → disbursement currency)
  exchangeRate   ExchangeRate?      @relation("DisbursementFxSnapshots", fields: [exchangeRateId], references: [id])
  fxRate         Float? // denormalized snapshot value for display
  note           String?            @db.Text
  queuedById     String
  queuedBy       User               @relation("DisbursementsQueuedBy", fields: [queuedById], references: [id])
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?              @relation("DisbursementsConfirmedBy", fields: [confirmedById], references: [id])
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([queuedById]) // MYSQL-FK-INDEX: queuedById relation needs its own leftmost index
  @@index([confirmedById]) // MYSQL-FK-INDEX: confirmedById relation needs its own leftmost index
  @@index([exchangeRateId]) // MYSQL-FK-INDEX: exchangeRateId relation needs its own leftmost index
}

// ── 10.2 RiskConfig — configurable scoring weights; auto-decision is OFF
// unless explicitly enabled (plan: "auto-decision only if explicitly enabled"). ──
model RiskConfig {
  id                   String           @id @default(cuid())
  financierProfileId   String           @unique
  financierProfile     FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  autoDecisionEnabled  Boolean          @default(false)
  autoApproveThreshold Float            @default(80) // score ≥ threshold → AUTO_APPROVE (only when enabled)
  autoDeclineThreshold Float            @default(30) // score < threshold → AUTO_DECLINE (only when enabled)
  // factor weights (0–100 each; the service normalizes to 100% at compute time)
  weightAmount         Int              @default(20) // requested amount vs service range & capacity
  weightTenor          Int              @default(10) // tenor requested vs financed norms
  weightGuarantee      Int              @default(20) // guarantee type + availability
  weightCapacity       Int              @default(20) // monthlyInstallmentCapacity vs schedule
  weightHistory        Int              @default(15) // prior agreements on the platform (performance)
  weightDocuments      Int              @default(15) // verified requirement-submissions ratio
  updatedById          String?
  updatedBy            User?            @relation("RiskConfigsUpdatedBy", fields: [updatedById], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

// ── 10.2 RiskAssessment — one per request (latest computed). factors is a
// MediumText JSON payload: [{name, weight, score, contribution, note}]. ──
model RiskAssessment {
  id           String           @id @default(cuid())
  requestId    String           @unique
  request      FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  score        Float // 0–100, higher = lower risk
  band         String // LOW | MEDIUM | HIGH
  factors      String           @db.MediumText // JSON: per-factor breakdown
  decision     String           @default("DECISION_SUPPORT") // DECISION_SUPPORT | AUTO_APPROVE | AUTO_DECLINE
  computedById String
  computedBy   User             @relation("RiskAssessmentsComputedBy", fields: [computedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([computedById]) // MYSQL-FK-INDEX: computedById relation needs its own leftmost index
}

// ── 10.3 ShariaCertification — scholar certifications with expiry +
// reminders (30-day expiry reminder service; surfaced in analytics/console). ──
model ShariaCertification {
  id                 String           @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  scholarName        String
  scholarInstitution String
  certificateRef     String
  scope              String?          @db.Text // what the certification covers
  issuedAt           DateTime
  expiresAt          DateTime
  reminderSentAt     DateTime? // last 30-day-before-expiry reminder emitted
  documentUrl        String? // evidence document link (media library URL)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([financierProfileId, certificateRef])
  @@index([financierProfileId, expiresAt])
}

// ── 10.3 FinancingContractTemplate — versioned contract templates; sha256 is
// the content hash the e-signature binds to (hash mismatch → no execution). ──
model FinancingContractTemplate {
  id                 String           @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  kind               String           @default("FINANCING_AGREEMENT") // FINANCING_AGREEMENT | MURABAHA
  version            Int
  title              String
  body               String           @db.Text // the contract text (with {{placeholders}})
  sha256             String // content hash at save — e-signature binds to this
  status             String           @default("DRAFT") // DRAFT | ACTIVE | RETIRED
  createdById        String
  createdBy          User             @relation("FinancingContractTemplatesAuthored", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  executions ESignatureExecution[]

  @@unique([financierProfileId, kind, version])
  @@index([financierProfileId, status])
  @@index([createdById]) // MYSQL-FK-INDEX: createdById relation needs its own leftmost index
}

// ── 10.4 ESignatureExecution — the evidence package: signer identity
// binding (authenticated session + step-up MFA at signing), explicit
// consent text + acceptance event, EXACT document version (template version
// + sha256 — mismatch fails closed), server timestamp, IP/device, and the
// complete audit trail (MediumText JSON package). One execution per
// agreement. ──
model ESignatureExecution {
  id                  String                    @id @default(cuid())
  agreementId         String                    @unique
  agreement           FinancingAgreement        @relation(fields: [agreementId], references: [id])
  contractTemplateId  String
  contractTemplate    FinancingContractTemplate @relation(fields: [contractTemplateId], references: [id])
  documentSha256      String // captured at execution — must equal the template's ACTIVE sha256 or fail closed
  signerId            String // the applicant user
  signer              User                      @relation("ESignaturesExecuted", fields: [signerId], references: [id])
  signerMfaVerifiedAt DateTime? // step-up MFA verification at signing (6.7.5)
  consentText         String                    @db.Text // the exact consent sentence accepted
  acceptedAt          DateTime // server timestamp
  ipAddress           String?
  userAgent           String?
  signatureImageId    String? // MediaAsset of the drawn/typed signature image
  signatureImage      MediaAsset?               @relation("ESignatureSignatures", fields: [signatureImageId], references: [id])
  evidence            String                    @db.MediumText // JSON: complete evidence package (audit trail)
  createdAt           DateTime                  @default(now())

  @@index([signerId]) // MYSQL-FK-INDEX: signerId relation needs its own leftmost index
  @@index([contractTemplateId]) // MYSQL-FK-INDEX: contractTemplateId relation needs its own leftmost index
  @@index([signatureImageId]) // MYSQL-FK-INDEX: signatureImageId relation needs its own leftmost index
}

// ── 10.7 UnderwritingLimit — the limit matrix. scopeKey is the deterministic
// unique key: "org" | "org:user:<uid>" | "branch:<bid>" |
// "branch:<bid>:user:<uid>" — resolution: user-branch → user-org → branch →
// org (most specific wins). Enforced when offers are created/sent. ──
model UnderwritingLimit {
  id                 String           @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  scopeKey           String           @unique
  branchId           String? // set when scoped to a branch
  branch             FinancierBranch? @relation(fields: [branchId], references: [id])
  userId             String? // set when scoped to a specific underwriter
  user               User?            @relation("UnderwritingLimitUsers", fields: [userId], references: [id])
  maxAmount          Float
  currency           String           @default("YER")
  updatedById        String
  updatedBy          User             @relation("UnderwritingLimitsUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([financierProfileId])
  @@index([branchId]) // MYSQL-FK-INDEX: branchId relation needs its own leftmost index
  @@index([userId]) // MYSQL-FK-INDEX: userId relation needs its own leftmost index
}
