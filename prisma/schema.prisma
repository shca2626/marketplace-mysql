model AccreditationRequest {
  id     String @id @default(cuid())
  number String @unique // ACC-YYYY-###### via Sequence 'ACC'

  // WHO — companies only
  organizationId String
  organization   Organization @relation("AccreditationRequestsByOrg", fields: [organizationId], references: [id])
  submittedById  String
  submittedBy    User         @relation("AccreditationsSubmitted", fields: [submittedById], references: [id])

  // WHAT — the financier's ACCREDITATION-kind service (service-enforced)
  serviceId String
  service   FinancierService @relation(fields: [serviceId], references: [id])

  // MULTI-FINANCIER ROUTING (DP-25)
  multiGroupId String?

  scopeNotes String?   @db.Text // MYSQL: free-form scope notes
  consentAt  DateTime?

  // THE PLATFORM GATE (R-4)
  platformReviewedById String?
  platformReviewedBy   User?     @relation("AccreditationPlatformReviews", fields: [platformReviewedById], references: [id])
  platformReviewedAt   DateTime?
  platformNote         String?   @db.Text // MYSQL: free-form gate note
  returnedAt           DateTime?
  returnedReason       String?   @db.Text // MYSQL: free-form return reason
  forwardedAt          DateTime?

  // LIFECYCLE (§5.2)
  status           String    @default("DRAFT") // DRAFT | SUBMITTED | UNDER_PLATFORM_REVIEW | RETURNED_FOR_COMPLETION | FORWARDED_TO_FINANCIER | UNDER_FINANCIER_REVIEW | ACCREDITED | REJECTED | EXPIRED | REVOKED | CANCELLED
  submittedAt      DateTime?
  decidedById      String?
  decidedBy        User?     @relation("AccreditationsDecidedBy", fields: [decidedById], references: [id])
  decidedAt        DateTime?
  decisionNote     String?   @db.Text // MYSQL: free-form decision note
  accreditedAt     DateTime?
  validUntil       DateTime? // grant lifetime — service.accreditationValidMonths default
  revokedById      String?
  revokedBy        User?     @relation("AccreditationsRevokedBy", fields: [revokedById], references: [id])
  revokedAt        DateTime?
  revocationReason String?   @db.Text // MYSQL: free-form revocation reason
  expiresAt        DateTime? // REQUEST-level expiry (pre-decision)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  submissions  RequirementSubmission[]
  activeKey    Int? // 1 for ACTIVE_SET statuses, NULL terminal — maintained by DB triggers (scripts/sql/accreditation-constraints.sql); application code NEVER sets it
  supersedesId String? // the ACCREDITED record this renewal replaces

  @@unique([serviceId, organizationId]) // one accreditation per financier-program per org; renewals after terminal states (service-enforced)
  @@index([organizationId, status])
  @@index([status, createdAt])
  @@index([multiGroupId])
  @@index([validUntil])
  @@index([submittedById]) // MYSQL-FK-INDEX: submittedById relation needs its own leftmost index
  @@index([platformReviewedById]) // MYSQL-FK-INDEX: platformReviewedById relation needs its own leftmost index
  @@index([decidedById]) // MYSQL-FK-INDEX: decidedById relation needs its own leftmost index
  @@index([revokedById]) // MYSQL-FK-INDEX: revokedById relation needs its own leftmost index
}

model ContactMessage {
