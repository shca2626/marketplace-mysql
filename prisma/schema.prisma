  agreement      FinancingAgreement @relation(fields: [agreementId], references: [id])
  status         String             @default("QUEUED") // QUEUED | CONFIRMED | CANCELLED
  currency       String             @default("YER")
  amount         Float // disbursed amount (defaults from the accepted offer)
  rail           String? // BANK | CASH | WALLET | OTHER — required at confirm
  reference      String? // payment-rail reference — required at confirm
  exchangeRateId String? // FX snapshot link (agreement currency → disbursement currency)
  exchangeRate   ExchangeRate?      @relation("DisbursementFxSnapshots", fields: [exchangeRateId], references: [id])
  fxRate         Float? // denormalized snapshot value for display
  note           String?            @db.Text
  queuedById     String
  queuedBy       User               @relation("DisbursementsQueuedBy", fields: [queuedById], references: [id])
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?              @relation("DisbursementsConfirmedBy", fields: [confirmedById], references: [id])
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([queuedById]) // MYSQL-FK-INDEX: queuedById relation needs its own leftmost index
  @@index([confirmedById]) // MYSQL-FK-INDEX: confirmedById relation needs its own leftmost index
  @@index([exchangeRateId]) // MYSQL-FK-INDEX: exchangeRateId relation needs its own leftmost index
}

model ESignatureExecution {
  id                  String                    @id @default(cuid())
  agreementId         String                    @unique
  agreement           FinancingAgreement        @relation(fields: [agreementId], references: [id])
  contractTemplateId  String
  contractTemplate    FinancingContractTemplate @relation(fields: [contractTemplateId], references: [id])
  documentSha256      String // captured at execution — must equal the template's ACTIVE sha256 or fail closed
  signerId            String // the applicant user
  signer              User                      @relation("ESignaturesExecuted", fields: [signerId], references: [id])
  signerMfaVerifiedAt DateTime? // step-up MFA verification at signing (6.7.5)
  consentText         String                    @db.Text // the exact consent sentence accepted
  acceptedAt          DateTime // server timestamp
  ipAddress           String?
  userAgent           String?
  signatureImageId    String? // MediaAsset of the drawn/typed signature image
  signatureImage      MediaAsset?               @relation("ESignatureSignatures", fields: [signatureImageId], references: [id])
  evidence            String                    @db.MediumText // JSON: complete evidence package (audit trail)
  createdAt           DateTime                  @default(now())

  @@index([signerId]) // MYSQL-FK-INDEX: signerId relation needs its own leftmost index
  @@index([contractTemplateId]) // MYSQL-FK-INDEX: contractTemplateId relation needs its own leftmost index
  @@index([signatureImageId]) // MYSQL-FK-INDEX: signatureImageId relation needs its own leftmost index
}

model ExchangeRate {
  id        String   @id @default(cuid())
  baseCode  String
  quoteCode String
  rate      Float // 1 base = rate quote
  source    String   @default("ADMIN") // ADMIN | SEED | IMPORT
  validFrom DateTime @default(now())
  createdBy String?
  createdAt DateTime @default(now())

  base                    Currency             @relation("RateBase", fields: [baseCode], references: [code])
  quote                   Currency             @relation("RateQuote", fields: [quoteCode], references: [code])
  disbursementFxSnapshots DisbursementRecord[] @relation("DisbursementFxSnapshots") // 10.5: FX snapshot at disbursement confirm

  @@unique([baseCode, quoteCode, validFrom]) // one authoritative rate per instant
  @@index([quoteCode]) // MYSQL-FK-INDEX
}

model FeeAssessment {
  id             String          @id @default(cuid())
  idempotencyKey String          @unique // event-scoped, e.g. "ORDER_COMMISSION:payout:PY-2026-000001"
  event          String
  ruleId         String? // null = recorded without a rule row (legacy carry-over)
  rule           FeeRule?        @relation("FeeAssessmentRule", fields: [ruleId], references: [id])
  ruleVersion    Int?
  ruleSnapshot   String?         @db.MediumText // JSON: {dimension, value, scopeType, scopeId, precedence} at application time
  actorType      String // SELLER | FINANCIER | PLATFORM
  actorOrgId     String? // the paying/subject org (seller org | financier org)
  actorOrg       Organization?   @relation("FeeAssessmentActorOrg", fields: [actorOrgId], references: [id])
  refType        String? // PAYOUT | AGREEMENT | SUBSCRIPTION_INVOICE | ORDER
  refId          String?
  baseAmount     Float
  currency       String          @default("USD")
  fxRateToUsd    Float           @default(1) // FX snapshot at assessment time
  calcInputs     String?         @db.MediumText // JSON: {percent?, itemCount?, note?}
  amount         Float // resulting fee (reversal rows carry the negative)
  reversalOfId   String? // set on REVERSAL rows → the original assessment
  reversalOf     FeeAssessment?  @relation("FeeAssessmentReversal", fields: [reversalOfId], references: [id])
  reversals      FeeAssessment[] @relation("FeeAssessmentReversal")
  reversalReason String?         @db.Text
  changedById    String? // actor who issued the reversal
  status         String          @default("APPLIED") // APPLIED | REVERSAL
  assessedAt     DateTime        @default(now())

  @@index([event, assessedAt])
  @@index([actorOrgId, event])
  @@index([refType, refId])
  @@index([reversalOfId])
}

model FeeRule {
  id            String    @id @default(cuid())
  event         String // ORDER_COMMISSION | FINANCING_SUCCESS | SUBSCRIPTION_RENEWAL
  actorType     String // SELLER | FINANCIER | PLATFORM
  scopeType     String    @default("PLATFORM") // PLATFORM | ORG_TYPE | ORG
  scopeId       String    @default("") // "" | COMPANY/BANK/MFI/EWALLET | org id
  dimension     String    @default("PERCENT") // PERCENT | FLAT
  value         Float // percent (0..90) or flat amount
  currency      String? // FLAT rules only; null = ledger currency
  precedence    Int       @default(0)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = open-ended
  version       Int       @default(1)
  note          String?   @db.Text
  isActive      Boolean   @default(true)
  changedById   String? // admin actor
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assessments FeeAssessment[] @relation("FeeAssessmentRule")

  @@unique([event, scopeType, scopeId, version])
  @@index([event, isActive, scopeType])
  @@index([scopeType, scopeId])
}

// ── SPONSOR-1: sponsored/pinned listings ─────────────────────────────────────
// A company pays (through the fee engine — event SPONSORSHIP, FLAT per-day
// rules, org-scoped overrides honored) to pin one of its APPROVED shared-catalog
// products: pinned to the top of the storefront default sort + "Sponsored"
// badge. One ACTIVE placement per product at a time; expiry is enforced
// server-side on read (endsAt) and lazily reconciled on write paths.
model SponsoredPlacement {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation("SponsoredProducts", fields: [productId], references: [id], onDelete: Cascade)
  organizationId String // the sponsoring company (snapshot of product ownership at purchase)
  organization   Organization @relation("SponsoredPlacements", fields: [organizationId], references: [id])
  sellerId       String // the member who purchased (actor)
  seller         User         @relation("SponsoredByUser", fields: [sellerId], references: [id])
  days           Int // 7 | 14 | 30 — the purchased window
  amount         Float // price charged (snapshot: days × per-day rate at purchase)
  currency       String       @default("USD")
  status         String       @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  paymentMethod  String       @default("CARD") // CARD (simulated capture) | WALLET (deducted from seller earnings balance)
  paymentStatus  String       @default("PAID") // PAID | FAILED
  startsAt       DateTime     @default(now())
  endsAt         DateTime // startsAt + days
  feeAssessmentId String? // link to the immutable SPONSORSHIP ledger row
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, endsAt])
  @@index([productId, status])
  @@index([organizationId, status])
  @@index([sellerId]) // MYSQL-FK-INDEX: sellerId relation needs its own leftmost index
}

model FinancingContractTemplate {
  id                 String           @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  kind               String           @default("FINANCING_AGREEMENT") // FINANCING_AGREEMENT | MURABAHA
  version            Int
  title              String
  body               String           @db.Text // the contract text (with {{placeholders}})
  sha256             String // content hash at save — e-signature binds to this
  status             String           @default("DRAFT") // DRAFT | ACTIVE | RETIRED
  createdById        String
  createdBy          User             @relation("FinancingContractTemplatesAuthored", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  executions ESignatureExecution[]

  @@unique([financierProfileId, kind, version])
  @@index([financierProfileId, status])
  @@index([createdById]) // MYSQL-FK-INDEX: createdById relation needs its own leftmost index
}

model InstallmentAllocation {
  id            String                    @id @default(cuid())
  paymentId     String
  payment       InstallmentPayment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment   FinancingOfferInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Float
  createdAt     DateTime                  @default(now())

  @@unique([paymentId, installmentId]) // one allocation line per payment × installment
  @@index([installmentId]) // MYSQL-FK-INDEX: installmentId relation needs its own leftmost index
}

model InstallmentPayment {
  id                String               @id @default(cuid())
  agreementId       String
  agreement         FinancingAgreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  receivedAt        DateTime
  channel           String // BANK_TRANSFER | CASH | AGENT | RAIL_EXPORT | OTHER
  reference         String? // payment-rail reference / receipt number
  amount            Float
  currency          String               @default("YER")
  fxRateToAgreement Float? // snapshot: received currency → agreement currency, if different
  status            String               @default("RECEIVED") // RECEIVED | PARTIALLY_ALLOCATED | ALLOCATED | PARTIALLY_REVERSED | REVERSED
  note              String?              @db.Text
  recordedById      String
  recordedBy        User                 @relation("InstallmentPaymentsRecordedBy", fields: [recordedById], references: [id])
  reversalOfId      String? // set on the REVERSAL row → the original payment being (partially) reversed
  reversalOf        InstallmentPayment?  @relation("InstallmentPaymentReversals", fields: [reversalOfId], references: [id])
  reversals         InstallmentPayment[] @relation("InstallmentPaymentReversals")
  reconciledAt      DateTime? // last reconciliation batch that saw this row
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  allocations InstallmentAllocation[]

  @@index([agreementId, receivedAt])
  @@index([status])
  @@index([recordedById]) // MYSQL-FK-INDEX: recordedById relation needs its own leftmost index
  @@index([reversalOfId]) // MYSQL-FK-INDEX: reversalOfId relation needs its own leftmost index
}

model KycCase {
  id                String             @id @default(cuid())
