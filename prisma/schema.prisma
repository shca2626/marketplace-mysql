}

model Partner {
  id                 String            @id @default(cuid())
  financierProfileId String? // null = platform-level
  financierProfile   FinancierProfile? @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  name               String
  monogram           String? // initials rendered on the tile
  accentColor        String? // hex accent for the monogram tile
  websiteUrl         String?
  kind               String            @default("PARTNER") // FINANCIER | SELLER | TECH | NGO | GOVERNMENT | PARTNER
  position           Int               @default(0)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())

  @@index([isActive])
  @@index([financierProfileId]) // MYSQL-FK-INDEX: financierProfileId relation needs its own leftmost index
