// ═══════════════════════════════════════════════════════════════════════════
// VENDORA — PRODUCTION SCHEMA (Aiven cloud MySQL 8.4 — the ONE and ONLY database)
// ═══════════════════════════════════════════════════════════════════════════
//
// Datasource: Aiven for MySQL, service "mysql-marketplace-sunsolar1"
// (mysql-marketplace-sunsolar1.f.aivencloud.com:23363 / defaultdb, TLS required).
// The complete 66-model graph. MySQL dialect notes: @db.Text on long free-form
// fields, @db.VarChar(4000) on Product.images (TEXT can't take literal defaults
// on MySQL 8.4), explicit composite-@@id M2M join models (Aiven enforces
// sql_require_primary_key=1).
//
// Schema/DB sync:  ⚠ NEVER run `prisma db push` against this database — the
// live DB intentionally carries 51 legacy tables + columns from the
// pre-rollback implementation that this schema does not declare, and db push
// would DROP them. Use the surgical additive migration scripts instead
// (scripts/migrate-*.ts). `bun run db:push` routes through a guard that
// aborts on any destructive diff.
// Client:          bun run db:generate
// Health:          bun scripts/db-status.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// VENDORA — unified commerce core (B2C + B2B + B2B2C)
//
// Foundation principle: the difference between B2C and B2B is DATA, not code
// paths. One buyer graph (users + organizations + customer groups), one
// pricing resolution pipeline (price lists), one negotiation primitive
// (RFQ/Quote), one order pipeline with payment-term extensions.
// ═══════════════════════════════════════════════════════════════════════════

// ── MFA + session registry (security roadmap 6.7 — tables pre-exist in the
// live DB; declarations restored after they were lost with unpushed commits).

model MfaEnrollment {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation("MfaEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  method       String    @default("TOTP") // TOTP (extensible)
  secretEnc    String    @db.Text // AES-256-GCM ciphertext — never plaintext
  confirmedAt  DateTime?
  lastTotpStep Int? // replay guard: last accepted TOTP timestep
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  backupCodes MfaBackupCode[]
}

model MfaBackupCode {
  id           String        @id @default(cuid())
  enrollmentId String
  enrollment   MfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  codeHash     String        @unique // salted scrypt hash; plaintext shown once
  usedAt       DateTime?
  createdAt    DateTime      @default(now())

  @@index([enrollmentId])
}

model SessionRegistry {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("SessionRegistry", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique // sha256 of the signed session token
  userAgent      String?   @db.VarChar(400)
  ip             String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  revokedAt      DateTime?
  revokedReason  String?   @db.VarChar(120)
  mfaSatisfiedAt DateTime? // 6.7.5 step-up freshness anchor (per session)

  @@index([userId])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  name           String
  image          String?
  role           String    @default("BUYER") // BUYER | SELLER | ADMIN
  status         String    @default("ACTIVE") // ACTIVE | SUSPENDED — platform-controlled vendor lifecycle
  suspendedAt    DateTime?
  storeName      String?
  storeBio       String?   @db.Text // MYSQL: vendor bio, free-form long content
  commissionRate Float? // vendor payout commission override (percent); null = platform default
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ── Auth hardening (AUTHSEC-1) — mirrors prisma/schema.prisma ──
  sessionVersion  Int       @default(0)
  emailVerifiedAt DateTime?
  isBreakGlass    Boolean   @default(false) // privileged emergency account — every sign-in is audited as BREAK_GLASS_LOGIN and surfaced in the admin security console

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mfaEnrollment           MfaEnrollment?           @relation("MfaEnrollments")
  sessionRegistry         SessionRegistry[]        @relation("SessionRegistry")

  products                Product[]
  productsReviewed        Product[]                     @relation("ProductReviewedBy")
  offersCreated           ProductOffer[]                @relation("ProductOfferSeller")
  sponsoredPlacements     SponsoredPlacement[]           @relation("SponsoredByUser") // SPONSOR-1: placements this member purchased
  sellerProfiles          SellerProfile[]               @relation("SellerProfileOwner")
  orders                  Order[]
  reviews                 Review[]
  favorites               Favorite[]
  memberships             OrganizationMember[]
  groups                  CustomerGroupUser[]           @relation("UserCustomerGroups")
  rfqs                    Rfq[]
  quotesIssued            Quote[]                       @relation("QuoteCreatedBy")
  rfqMessages             RfqMessage[]                  @relation("RfqMessages")
  approvalsRequested      ApprovalRequest[]             @relation("ApprovalRequester")
  approvalsDecided        ApprovalRequest[]             @relation("ApprovalDecider")
  notifications           Notification[]                @relation("Notifications")
  verifiedAt              DateTime? // platform verification stamp (KYC-lite); enables routing auto-approve + distribution filters
  settingChanges          SettingChange[]               @relation("SettingChangeUser")
  disputesRaised          Dispute[]                     @relation("DisputeRaisedBy")
  disputesAgainst         Dispute[]                     @relation("DisputeSeller")
  disputesResolved        Dispute[]                     @relation("DisputeResolver")
  complaintsRaised         Complaint[]                   @relation("ComplaintRaisedBy") // COMPLAINT-1: trust reports against companies
  complaintsResolved      Complaint[]                   @relation("ComplaintResolver")
  recurringSchedules      RecurringRfq[]
  mediaAssets             MediaAsset[]                  @relation("MediaAssets")
  paymentsCaptured        Payment[]                     @relation("PaymentsCapturedBy")
  payouts                 Payout[]                      @relation("PayoutSeller")
  settlementsDeclared     ExternalSettlementReference[] @relation("SettlementDeclarer")
  settlementsConfirmed    ExternalSettlementReference[] @relation("SettlementConfirmer")
  paymentEvidenceUploaded PaymentEvidence[]             @relation("PaymentEvidenceUploadedBy")
  commissionObligations   CommissionObligation[]        @relation("CommissionObligationSeller")
  commissionStatements    CommissionStatement[]         @relation("CommissionStatementSeller")
  commissionInvoices      CommissionInvoice[]           @relation("CommissionInvoiceSeller")

  // ── Applicant profile (FINANCIER_SCHEMA v5 §3.1) — additive, ALL nullable;
  //    B2C buyers unaffected until they apply for financing (DP-14) ──
  phone             String? // contact only — login stays email-based
  whatsappNumber    String?
  dateOfBirth       DateTime?
  gender            String? // MALE | FEMALE | OTHER
  maritalStatus     String? // SINGLE | MARRIED | DIVORCED | WIDOWED
  nationality       String?
  identityType      String? // NATIONAL_ID | PASSPORT | RESIDENCE_PERMIT | OTHER
  identityNumber    String?
  residenceStreet   String?   @db.Text // MYSQL: street address, free-form
  residenceCity     String?
  residenceDistrict String?
  residenceType     String? // OWNED | RENTED

  // ── financing-domain relations (FINANCIER_SCHEMA v5) ──
  accountDocuments          AccountDocument[]       @relation("AccountDocumentsOwner")
  vaultAccessGrants         VaultAccessGrant[]      @relation("VaultAccessGrantUser")
  documentsReviewed         AccountDocument[]       @relation("AccountDocumentsReviewedBy")
  financingRequests         FinancingRequest[]      @relation("FinancingRequests")
  financingOffers           FinancingOffer[]        @relation("FinancingOffers")
  financingEventsReported   FinancingEvent[]        @relation("FinancingEventsReportedBy")
  accreditationsSubmitted   AccreditationRequest[]  @relation("AccreditationsSubmitted")
  accreditationsDecided     AccreditationRequest[]  @relation("AccreditationsDecidedBy")
  accreditationsRevoked     AccreditationRequest[]  @relation("AccreditationsRevokedBy")
  gateReviewsFinancing      FinancingRequest[]      @relation("FinancingPlatformReviews")
  gateReviewsAccreditation  AccreditationRequest[]  @relation("AccreditationPlatformReviews")
  submissionsVerified       RequirementSubmission[] @relation("RequirementSubmissionsVerifiedBy")
  conditionTemplatesCreated ConditionTemplate[]     @relation("ConditionTemplatesCreatedBy")

  // ── notification email digest (DIGEST-13) ──
  digests    NotificationDigest[]
  digestPref UserDigestPref?

  // ── RBAC role assignments (mergedplan.md Phase 2) ──
  roleAssignments                    UserRole[]
  refundsRequested                   Refund[]                       @relation("RefundRequester")
  refundsApproved                    Refund[]                       @relation("RefundApprover")
  refundsCompleted                   Refund[]                       @relation("RefundCompleter")
  kycCasesDecided                    KycCase[]                      @relation("KycCaseDecidedBy") // Phase 12.4 manual-queue decisions
  notificationPref                   UserNotificationPref?
  certificationsVerified             ProductCertification[]         @relation("CertificationsVerifiedBy")
  agreementsAuthored                 PublicationAgreementTemplate[] @relation("AgreementsAuthored")
  agreementConsents                  PublicationConsent[]           @relation("AgreementConsents")
  installmentPaymentsRecorded        InstallmentPayment[]           @relation("InstallmentPaymentsRecordedBy")
  paymentReconciliationsResolved     PaymentReconciliation[]        @relation("PaymentReconciliationsResolvedBy")
  disbursementsQueued                DisbursementRecord[]           @relation("DisbursementsQueuedBy")
  disbursementsConfirmed             DisbursementRecord[]           @relation("DisbursementsConfirmedBy")
  riskAssessmentsComputed            RiskAssessment[]               @relation("RiskAssessmentsComputedBy")
  financingContractTemplatesAuthored FinancingContractTemplate[]    @relation("FinancingContractTemplatesAuthored")
  esignaturesExecuted                ESignatureExecution[]          @relation("ESignaturesExecuted")
  underwritingLimitsUpdated          UnderwritingLimit[]            @relation("UnderwritingLimitsUpdatedBy")
  riskConfigsUpdated                 RiskConfig[]                   @relation("RiskConfigsUpdatedBy") // 10.2
  underwritingLimitScopes            UnderwritingLimit[]            @relation("UnderwritingLimitUsers") // 10.7: per-underwriter overrides
  storeCover                         String? // cover id from the curated STORE_COVERS set — persisted per seller, STAB-8
  mfaRequired                        Boolean                        @default(false) // admin-set per-account requirement; the user can enroll but never disable while required
  phoneVerifiedAt                    DateTime? // set by OTP verification (L1 evidence)
  kycLevel                           Int                            @default(0) // 0=L0 registered · 1=L1 phone verified · 2=L2 identity docs verified · 3=L3 business/org verified (computed once, read everywhere)
  merchantType                       String? // EXCLUSIVE_AGENT | AUTHORIZED_AGENT | DISTRIBUTOR | WHOLESALER | RETAILER — Merchant/Dealer designation (owner taxonomy)

  @@index([role])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  icon           String?
  products       Product[]
  specAttributes SpecAttribute[] // Phase 3 KYP: structured attribute dictionary per category
  description    String?         @db.Text // Phase 4: admin-managed category blurb (directory / SEO)
  sortOrder      Int             @default(0) // Phase 4: admin-controlled ordering on nav + directories
}

model Product {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text // MYSQL: long product description
  price          Float // retail list price (fallback of the pricing pipeline)
  compareAtPrice Float?
  images         String   @default("[]") @db.VarChar(4000) // MYSQL: JSON string array of URLs (Aiven MySQL 8.4: TEXT columns can't take literal defaults — VarChar can; measured max ~50 chars, 4000 = ample headroom)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  brandId        String? // FK Brand — platform-managed brand linkage
  brand          Brand?   @relation(fields: [brandId], references: [id])
  sellerId       String
  seller         User     @relation(fields: [sellerId], references: [id])
  stock          Int      @default(10) // total units; with variants = sum of variant stock
  soldCount      Int      @default(0)
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  featured       Boolean  @default(false)

  // ── Commerce details (product form: Pricing / Details / Shipping / SEO) ──
  sku             String?
  barcode         String?
  videoUrl        String?
  highlights      String?  @db.Text // MYSQL: JSON array of bullet strings (About this item)
  specs           String?  @db.Text // MYSQL: JSON array of {label, value} (Specifications)
  materials       String?  @db.Text // MYSQL: free-form materials text
  care            String?  @db.Text // MYSQL: free-form care instructions
  weightGrams     Int?
  lengthCm        Float?
  widthCm         Float?
  heightCm        Float?
  processingDays  Int? // handling time before dispatch
  freeShipping    Boolean  @default(false)
  shippingFee     Float? // flat rate; ignored when freeShipping = true
  shippingPolicy  String?  @db.Text // MYSQL: free-form policy text
  slug            String?  @unique // SEO handle / future deep links
  metaTitle       String?
  metaDescription String?  @db.Text // MYSQL: SEO description, can run long
  moq             Int? // minimum order quantity enforced by RFQ commercial rules (null = none)
  priceTiers      String?  @db.Text // MYSQL: JSON [{from,to,price}] quantity-break ladder applied in quotes
  status          String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Shared-catalog ownership & platform approval (B2B selling) ──
  organizationId String? // owning company; null = platform-created / legacy individual listing
  organization   Organization? @relation("OrganizationProducts", fields: [organizationId], references: [id])
  approvalState  String        @default("APPROVED") // PENDING_APPROVAL | APPROVED | REJECTED — company proposals stay private until platform approval
  reviewNote     String?       @db.Text // platform review note shown to the proposing company
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?         @relation("ProductReviewedBy", fields: [reviewedById], references: [id])

  reviews                     Review[]
  favorites                   Favorite[]
  orderItems                  OrderItem[]
  priceListEntries            PriceListEntry[]
  rfqLines                    RfqLine[]
  quoteLines                  QuoteLine[]
  variants                    ProductVariant[]
  offers                      ProductOffer[]
  certifications              ProductCertification[]
  agreementConsents           PublicationConsent[]   @relation("ProductAgreementConsents") // 9.4: publication-agreement consent ledger rows
  curatedById                 String?
  gtin                        String? // normalized EAN/UPC/GTIN — dedup + merge matching key
  mpn                         String? // manufacturer part number — dedup key
  isCurated                   Boolean                @default(false) // platform-curated catalog listing (admin-created/adopted)
  popularRank                 Int? // homepage popular-products ordering (curated); null = not ranked
  publicationAgreedAt         DateTime? // seller accepted the Publication Agreement (audit-logged too)
  publicationAgreementVersion String? // which agreement text version was accepted
  sponsoredPlacements        SponsoredPlacement[] @relation("SponsoredProducts") // SPONSOR-1: active paid placements boost this product

  @@index([categoryId])
  @@index([sellerId, status])
  @@index([status, soldCount])
  @@index([featured])
  @@index([organizationId, approvalState])
  @@index([approvalState, status])
}

model Order {
  id        String      @id @default(cuid())
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id])
  items     OrderItem[]
  total     Float
  status    String      @default("PAID") // PENDING_PAYMENT | PENDING_APPROVAL | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  fullName  String
  address   String      @db.Text // MYSQL: shipping address, free-form
  city      String
  country   String
  zip       String
  phone     String?
  createdAt DateTime    @default(now())

  // ── B2B extensions (all optional so the B2C fast path is unchanged) ──
  organizationId        String? // purchasing organization (B2B context)
  organization          Organization?                @relation(fields: [organizationId], references: [id])
  poNumber              String? // buyer purchase-order reference
  costCenter            String?
  paymentTerms          String? // e.g. NET-30; null = paid at checkout
  sourceType            String? // CART | RFQ
  sourceQuoteId         String?                      @unique // quote that produced this order
  approvalRequest       ApprovalRequest?
  payment               Payment?
  disputes              Dispute[]
  externalSettlement    ExternalSettlementReference?
  commissionObligations CommissionObligation[]
  fulfillments          OrderFulfillment[] // 7.7: per-seller-group fulfillment
  refunds               Refund[] // 7.7: refund obligations + executions
  paymentStatus         String                       @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | PAID | FUNDED | PARTIALLY_REFUNDED | REFUNDED | OUTSTANDING
  fulfillmentStatus     String                       @default("UNFULFILLED") // UNFULFILLED | PARTIALLY_FULFILLED | FULFILLED | PARTIALLY_CANCELLED | CANCELLED
  currency              String                       @default("USD") // 7.2: explicit transaction currency
  financingAgreementId  String?

  @@index([buyerId, createdAt])
  @@index([status])
  @@index([organizationId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  sellerId    String
  quantity    Int
  price       Float
  title       String // snapshot of product title at purchase time
  image       String? // snapshot of first product image
  variantId   String? // purchased ProductVariant (null = base product)
  variantName String? // snapshot of variant label at purchase time
  payoutId    String? // set when this item's revenue was settled into a seller payout
  payout      Payout? @relation(fields: [payoutId], references: [id])

  // ── Shared-catalog offer snapshot (B2B2C) ──
  offerId           String? // ProductOffer purchased (loose FK — indexed, no DB constraint)
  offerVariantId    String? // OfferVariant purchased (FK constraint in DB)
  sellerOrgId       String? // selling organization snapshot
  offerVariant      OfferVariant?          @relation("OrderItemOfferVariant", fields: [offerVariantId], references: [id])
  sellerOrg         Organization?          @relation("OrderItemSellerOrg", fields: [sellerOrgId], references: [id])
  payoutLines       PayoutLine[] // 7.4: settlement ledger entries covering this item
  refundAllocations RefundAllocation[] // 7.7: refunds covering this item
  fulfillmentItems  OrderFulfillmentItem[] // 7.7: per-seller-group links

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@index([sellerId, payoutId])
  @@index([payoutId]) // MYSQL-FK-INDEX: payoutId relation needs its own leftmost index
  @@index([offerId])
  @@index([sellerOrgId])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String // display label, e.g. M / Black
  options        String         @db.Text // MYSQL: JSON map Size -> M, Color -> Black
  price          Float? // null = inherit product price
  compareAtPrice Float?
  stock          Int            @default(0)
  sku            String?
  position       Int            @default(0)
  isActive       Boolean        @default(true)
  image          String? // uploaded-media variant image URL
  createdAt      DateTime       @default(now())
  offerVariants  OfferVariant[]

  @@index([productId, isActive])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1..5
  comment   String   @db.Text // MYSQL: review body, free-form long content
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId]) // MYSQL-FK-INDEX: productId relation needs its own leftmost index
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  orgType            String    @default("COMPANY") // COMPANY | BANK | MFI | EWALLET — settings scope key
  legalName          String?
  taxId              String? // VAT / EIN
  registrationNumber String?
  industry           String?
  website            String?
  billingAddress     String?   @db.Text // MYSQL: free-form billing address
  status             String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | ACTIVE | SUSPENDED | REJECTED
  verifiedAt         DateTime?
  creditTermsDays    Int       @default(0) // 0 = prepaid; 30 = NET-30 invoicing
  creditLimit        Float     @default(0)
  approvalThreshold  Float? // orders/quote-accepts at or above this total placed by BUYER-role members require org approval (null = off)
  notes              String?   @db.Text // MYSQL: free-form notes
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members          OrganizationMember[]
  priceLists       PriceList[]
  rfqs             Rfq[]
  orders           Order[]
  groups           CustomerGroupOrganization[] @relation("OrganizationCustomerGroups")
  approvalRequests ApprovalRequest[]

  // ── financing-domain back-relations (FINANCIER_SCHEMA v5) ──
  financierProfile      FinancierProfile?      @relation("FinancierProfileOrg")
  conditionTemplates    ConditionTemplate[]    @relation("FinancierConditionTemplates")
  accountDocuments      AccountDocument[]      @relation("OrganizationAccountDocuments")
  financingRequests     FinancingRequest[]     @relation("FinancingRequestsByOrg")
  accreditationRequests AccreditationRequest[] @relation("AccreditationRequestsByOrg")

  // ── shared-catalog selling (B2B) ──
  stores                  Store[]             @relation("OrganizationStores")
  products                Product[]           @relation("OrganizationProducts")
  offers                  ProductOffer[]      @relation("ProductOfferSellerOrg")
  quotesIssued            Quote[]             @relation("QuoteSellerOrg")
  sellerProfile           SellerProfile?      @relation("SellerProfileOrg")
  sponsoredPlacements     SponsoredPlacement[] @relation("SponsoredPlacements") // SPONSOR-1: paid placements purchased by this org
  complaintsAgainst       Complaint[]         @relation("ComplaintTargetOrg") // COMPLAINT-1: trust reports against this company
  complaintsFiled         Complaint[]         @relation("ComplaintFiledByOrg") // COMPLAINT-1: reports filed on behalf of this company
  orderItemsSold          OrderItem[]         @relation("OrderItemSellerOrg")
  fulfillmentsAsSellerOrg OrderFulfillment[]  @relation("FulfillmentSellerOrg")
  sellerSubscription      SellerSubscription? @relation("SellerSubscriptionOrg")
  feeAssessmentsAsActor   FeeAssessment[]     @relation("FeeAssessmentActorOrg")
  kycLevel                Int                 @default(0) // Phase 3 KYB: 0=registered · 2=identity · 3=business docs verified
  merchantType            String? // EXCLUSIVE_AGENT | AUTHORIZED_AGENT | DISTRIBUTOR | WHOLESALER | RETAILER — Merchant/Dealer classification of the entity

  @@index([status])
  @@index([createdAt])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("BUYER") // OWNER | ADMIN | BUYER | APPROVER | VIEWER
  jobTitle       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Store {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  description    String?  @db.Text // MYSQL: free-form store description
  logoUrl        String?
  city           String?
  phone          String?
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false) // every company has exactly one default store
  isArchived     Boolean  @default(false) // soft-delete; history attribution preserved
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation("OrganizationStores", fields: [organizationId], references: [id], onDelete: Cascade)
  offers       ProductOffer[] @relation("ProductOfferStore")

  @@index([organizationId, isActive])
  @@index([organizationId, isDefault])
}

model ProductOffer {
  id             String   @id @default(cuid())
  productId      String
  sellerId       String // creator/staff user who maintains this offer
  sellerOrgId    String? // owning company (the selling organization)
  storeId        String? // store attribution (multi-store)
  price          Float
  compareAtPrice Float?
  stock          Int      @default(0)
  moq            Int?
  sku            String?
  priceTiers     String?  @db.Text // MYSQL: JSON [{from,to,price}] quantity-break ladder
  freeShipping   Boolean  @default(false)
  shippingFee    Float?
  processingDays Int? // lead time before dispatch
  leadTimeNote   String?
  status         String   @default("ACTIVE") // DRAFT | ACTIVE | PAUSED | ARCHIVED
  soldCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller    User           @relation("ProductOfferSeller", fields: [sellerId], references: [id])
  sellerOrg Organization?  @relation("ProductOfferSellerOrg", fields: [sellerOrgId], references: [id])
  store     Store?         @relation("ProductOfferStore", fields: [storeId], references: [id])
  variants  OfferVariant[]

  @@unique([productId, sellerId])
  @@index([productId, status])
  @@index([sellerId, status])
  @@index([sellerOrgId])
  @@index([storeId])
}

model OfferVariant {
  id        String   @id @default(cuid())
  offerId   String
  variantId String
  price     Float? // null = inherit offer price
  stock     Int      @default(0)
  sku       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer      ProductOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]    @relation("OrderItemOfferVariant")

  @@unique([offerId, variantId])
  @@index([variantId])
}

model SellerProfile {
  id                String    @id @default(cuid())
  organizationId    String    @unique // 1:1 — a company qualifies once
  ownerUserId       String
  verificationState String    @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  verificationNote  String?   @db.Text // MYSQL: free-form platform note
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation("SellerProfileOrg", fields: [organizationId], references: [id])
  owner        User         @relation("SellerProfileOwner", fields: [ownerUserId], references: [id])

  @@index([ownerUserId])
  @@index([verificationState])
}

model ModuleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text // MYSQL: free-form description
  domain      String   @default("STOREFRONT")
  core        Boolean  @default(false) // core modules cannot be deactivated
  defaultOn   Boolean  @default(true)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activations ModuleActivation[]
}

model ModuleActivation {
  id          String   @id @default(cuid())
  moduleKey   String
  scopeType   String // PLATFORM | ORG_TYPE | ORG | STORE
  scopeId     String   @default("")
  enabled     Boolean  @default(true)
  note        String?  @db.Text // MYSQL: free-form note
  changedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module ModuleDefinition @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@unique([moduleKey, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

model CustomerGroup {
  id                         String                      @id @default(cuid())
  key                        String                      @unique
  name                       String
  description                String?                     @db.Text // MYSQL: free-form segment description
  priority                   Int                         @default(0) // higher wins when several groups apply
  isDefault                  Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  customerGroupUsers         CustomerGroupUser[]         @relation("UserCustomerGroups")
  customerGroupOrganizations CustomerGroupOrganization[] @relation("OrganizationCustomerGroups")
  priceLists                 PriceList[]

  @@index([isDefault])
}

model CustomerGroupUser {
  customerGroupId String
  userId          String
  customerGroup   CustomerGroup @relation("UserCustomerGroups", fields: [customerGroupId], references: [id], onDelete: Cascade)
  user            User          @relation("UserCustomerGroups", fields: [userId], references: [id], onDelete: Cascade)

  @@id([customerGroupId, userId])
  @@index([userId]) // MYSQL-FK-INDEX: userId relation needs its own leftmost index
}

model CustomerGroupOrganization {
  customerGroupId String
  organizationId  String
  customerGroup   CustomerGroup @relation("OrganizationCustomerGroups", fields: [customerGroupId], references: [id], onDelete: Cascade)
  organization    Organization  @relation("OrganizationCustomerGroups", fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([customerGroupId, organizationId])
  @@index([organizationId]) // MYSQL-FK-INDEX: organizationId relation needs its own leftmost index
}

model PriceList {
  id              String         @id @default(cuid())
  name            String
  description     String?        @db.Text // MYSQL: free-form description
  scope           String // ORG | GROUP | CHANNEL
  status          String         @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  priority        Int            @default(0)
  currency        String         @default("USD")
  startsAt        DateTime?
  endsAt          DateTime?
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  entries PriceListEntry[]

  @@index([status, scope])
  @@index([organizationId])
  @@index([customerGroupId])
}

model PriceListEntry {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  minQuantity Int       @default(1) // ladder step: applies from this quantity up
  unitPrice   Float
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, minQuantity])
  @@index([productId])
}

model Rfq {
  id                String        @id @default(cuid())
  number            String        @unique
  userId            String
  organizationId    String?
  title             String?
  description       String?       @db.Text // MYSQL: free-form RFQ description
  status            String        @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | QUOTED | ACCEPTED | REJECTED | CANCELLED | EXPIRED | ORDERED
  submittedAt       DateTime?
  respondedAt       DateTime?
  closedAt          DateTime?
  expiresAt         DateTime? // RFQ deadline (expiry settings; null = no deadline)
  extendedCount     Int           @default(0) // buyer extensions used against the max-extensions rule
  sourceRecurringId String? // loose FK: the RecurringRfq schedule that spawned this run
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id])
  organization      Organization? @relation(fields: [organizationId], references: [id])

  // ── Financing-linked supplier RFQ (B2B2C sourcing) ──
  kind               String    @default("PROCUREMENT") // PROCUREMENT | SUPPLIER_FINANCING — sourcing for a financing request
  financingRequestId String? // the FinancingRequest this RFQ sources goods for (loose FK)
  version            Int       @default(1) // revision chain: material changes version up
  consentAt          DateTime? // applicant consent captured for THIS version (consent ≠ agreement)
  supersededById     String? // previous-version chain (loose FK)

  lines    RfqLine[]
  quotes   Quote[]
  messages RfqMessage[]

  @@index([userId, createdAt])
  @@index([organizationId])
  @@index([status, createdAt])
  @@index([financingRequestId])
  @@index([kind, status])
}

model RfqLine {
  id          String   @id @default(cuid())
  rfqId       String
  productId   String? // null = open/free item ("250 units of something like this")
  productName String   @db.Text // MYSQL: snapshot title / free description
  sku         String?
  variantId   String? // referenced catalog variant (optional)
  variantName String? // snapshot "Color: Black / Bundle: Duo"
  quantity    Int
  targetPrice Float? // buyer's target unit price (optional)
  notes       String?  @db.Text // MYSQL: free-form line notes
  rfq         Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  quoteLines     QuoteLine[]
  offerId        String? // Phase 4: target a SPECIFIC vendor offer (null = the product generally / primary listing)
  offerVariantId String? // 7.6: buyer targets a specific vendor's variant (D9 identity)

  @@index([rfqId])
  @@index([productId])
  @@index([variantId])
}

model Quote {
  id            String    @id @default(cuid())
  number        String    @unique
  rfqId         String
  createdById   String // admin or seller who issued the quote
  sellerId      String? // fulfilling staff user (null = platform-facilitated)
  sellerOrgId   String? // quoting company (org-context quotes; loose FK — live column Quote_sellerOrgId_idx)
  status        String    @default("SENT") // DRAFT | SENT | PENDING_REVIEW | ACCEPTED | DECLINED | REJECTED | EXPIRED | CONVERTED | WITHDRAWN
  currency      String    @default("USD")
  subtotal      Float
  discountTotal Float     @default(0)
  shippingTotal Float     @default(0)
  taxTotal      Float     @default(0)
  total         Float
  paymentTerms  String? // e.g. NET-30
  validUntil    DateTime?
  notes         String?   @db.Text // MYSQL: free-form quote notes
  sentAt        DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  convertedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rfq           Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  lines            QuoteLine[]
  approvalRequests ApprovalRequest[] @relation("ApprovalQuote")
  sellerOrg        Organization?     @relation("QuoteSellerOrg", fields: [sellerOrgId], references: [id])

  @@index([rfqId])
  @@index([status])
  @@index([createdById]) // MYSQL-FK-INDEX: createdById relation needs its own leftmost index
  @@index([sellerOrgId])
}

model ApprovalRequest {
  id             String    @id @default(cuid())
  organizationId String
  type           String // ORDER | QUOTE_ACCEPT
  orderId        String?   @unique // set for ORDER
  quoteId        String?   @unique // set for QUOTE_ACCEPT
  rfqId          String? // owning RFQ context (QUOTE_ACCEPT)
  requesterId    String
  amount         Float
  note           String?   @db.Text // MYSQL: requester's justification
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?   @db.Text // MYSQL: decision note
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id])
  quote        Quote?       @relation("ApprovalQuote", fields: [quoteId], references: [id])
  requester    User         @relation("ApprovalRequester", fields: [requesterId], references: [id])
  decidedBy    User?        @relation("ApprovalDecider", fields: [decidedById], references: [id])
  offerId      String?      @unique // set for OFFER_ACCEPT (financing offer)

  @@index([organizationId, status])
  @@index([requesterId])
  @@index([decidedById]) // MYSQL-FK-INDEX: decidedById relation needs its own leftmost index
}

model QuoteLine {
  id             String   @id @default(cuid())
  quoteId        String
  rfqLineId      String?
  productId      String
  variantId      String? // quoted variant (mirrors the RFQ line)
  variantName    String? // snapshot at quote time
  quantity       Int
  unitPrice      Float
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqLine        RfqLine? @relation(fields: [rfqLineId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
  offerId        String? // 7.6: the seller offer actually quoted — H1: the snapshot is the fact, never reconstructed from a live offer
  offerVariantId String? // 7.6: the (offer, variant) quoted — D9 identity
  availableStock Int? // 7.6/H1: applicable inventory at quote time (null = not inventoried)

  @@index([quoteId])
  @@index([productId])
  @@index([rfqLineId]) // MYSQL-FK-INDEX: rfqLineId relation needs its own leftmost index
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // RFQ_SUBMITTED_SELLER | RFQ_QUOTE_RECEIVED | RFQ_QUOTE_ACCEPTED | RFQ_QUOTE_DECLINED | RFQ_QUOTE_WITHDRAWN | RFQ_QUOTE_CONVERTED | RFQ_STATUS | RFQ_MESSAGE | APPROVAL_REQUESTED | APPROVAL_DECIDED
  title     String
  body      String?   @db.Text // MYSQL: notification body, free-form
  linkView  String // SPA destination: rfq | orders | business | seller
  linkId    String? // rfqId / orderId / approval context id
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("Notifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationDigest {
  id          String   @id @default(cuid())
  userId      String
  kind        String // DAILY | WEEKLY
  periodStart DateTime
  periodEnd   DateTime
  itemCount   Int
  subject     String
  html        String   @db.MediumText // MYSQL: full branded inline-styled email HTML (16MB)
  status      String   @default("LOGGED") // LOGGED now; SENT when a transport is configured
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserDigestPref {
  userId    String @id
  frequency String @default("OFF") // OFF | DAILY | WEEKLY
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RfqMessage {
  id        String   @id @default(cuid())
  rfqId     String
  authorId  String
  body      String   @db.Text // MYSQL: message body, free-form long content
  createdAt DateTime @default(now())
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  author    User     @relation("RfqMessages", fields: [authorId], references: [id])

  @@index([rfqId, createdAt])
  @@index([authorId]) // MYSQL-FK-INDEX: authorId relation needs its own leftmost index
}

model MediaAsset {
  id               String                @id @default(cuid())
  key              String                @unique // storage base key (no extension)
  namespace        String                @default("public-media") // storage namespace segment (legacy live column)
  originalName     String
  mime             String
  size             Int
  width            Int?
  height           Int?
  sha256           String                @unique
  variants         String?               @db.Text // MYSQL: JSON {thumb,medium,large,full} storage keys
  uploadedById     String
  uploadedBy       User                  @relation("MediaAssets", fields: [uploadedById], references: [id])
  accountDocuments AccountDocument[]     @relation("AccountDocumentMedia")
  createdAt        DateTime              @default(now())
  esignatures      ESignatureExecution[] @relation("ESignatureSignatures") // 10.4: signature-image evidence

  @@index([uploadedById, createdAt])
}

model Dispute {
  id                String    @id @default(cuid())
  number            String    @unique // DSP-2026-000001
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id])
  raisedById        String // buyer (or admin acting for them)
  raisedBy          User      @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  sellerId          String // the disputed seller
  seller            User      @relation("DisputeSeller", fields: [sellerId], references: [id])
  rfqId             String? // loose FK: RFQ context when the order came from a quote
  reason            String // NOT_AS_DESCRIBED | DAMAGED | LATE_DELIVERY | WRONG_QUANTITY | QUALITY_ISSUE | PAYMENT_NOT_RECEIVED | OTHER
  description       String    @db.Text // MYSQL: dispute description, free-form long content
  amount            Float? // claimed amount (partial resolution support)
  status            String    @default("OPEN") // OPEN | SELLER_RESPONDED | ESCALATED | RESOLVED | CLOSED | CANCELLED
  sellerResponse    String?   @db.Text // MYSQL: seller's response, free-form
  sellerRespondedAt DateTime?
  escalateAt        DateTime? // autoEscalateDays deadline while unresolved
  outcome           String? // FULL_REFUND | PARTIAL_REFUND | REPLACEMENT | REPAIR | NO_ACTION | SELLER_PENALTY
  resolutionNote    String?   @db.Text // MYSQL: resolution note, free-form
  resolvedById      String?
  resolvedBy        User?     @relation("DisputeResolver", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([raisedById])
  @@index([sellerId])
  @@index([orderId])
  @@index([resolvedById]) // MYSQL-FK-INDEX: resolvedById relation needs its own leftmost index
}

// ── COMPLAINT-1: company complaints / trust reports ─────────────────────────
// Order-agnostic trust & safety surface (the order-bound refund flow lives in
// Dispute): any authenticated user reports a COMPANY for misleading info,
// counterfeits, conduct, pricing or IP issues. The target org gets one
// response; platform staff triage severity and resolve. Statuses:
//   OPEN → ORG_RESPONDED (org's single response) → RESOLVED / DISMISSED (admin)
//   OPEN → WITHDRAWN (complainant, before the org responds)
model Complaint {
  id             String    @id @default(cuid())
  number         String    @unique // CMP-2026-000001
  targetOrgId    String // the company being complained about
  targetOrg      Organization @relation("ComplaintTargetOrg", fields: [targetOrgId], references: [id])
  raisedById     String // complainant user
  raisedBy       User      @relation("ComplaintRaisedBy", fields: [raisedById], references: [id])
  raisedByOrgId  String? // complainant's organization when filed on behalf of a company (B2B context)
  raisedByOrg    Organization? @relation("ComplaintFiledByOrg", fields: [raisedByOrgId], references: [id])
  orderId        String? // loose FK: linked order context (kept when the order is deleted)
  productId      String? // loose FK: linked product context
  category       String // MISLEADING_INFO | COUNTERFEIT | CONDUCT | PRICING | FULFILLMENT | IP_INFRINGEMENT | OTHER
  subject        String
  body           String    @db.Text // MYSQL: complaint description, free-form long content
  status         String    @default("OPEN") // OPEN | ORG_RESPONDED | RESOLVED | DISMISSED | WITHDRAWN
  orgResponse    String?   @db.Text // MYSQL: the company's single response
  orgRespondedAt DateTime?
  severity       String    @default("NORMAL") // NORMAL | HIGH | CRITICAL — admin triage flag
  resolutionNote String?   @db.Text // MYSQL: admin's resolution note, free-form
  resolvedById   String?
  resolvedBy     User?     @relation("ComplaintResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetOrgId, status])
  @@index([raisedById])
  @@index([raisedByOrgId])
  @@index([orderId])
  @@index([productId])
  @@index([resolvedById]) // MYSQL-FK-INDEX: resolvedById relation needs its own leftmost index
}

model RecurringRfq {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  organizationId    String? // loose FK: org context for settings resolution
  title             String?
  description       String?   @db.Text // MYSQL: free-form description
  frequency         String // WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY | CUSTOM
  intervalDays      Int       @default(0) // CUSTOM: every N days
  lines             String    @db.Text // MYSQL: JSON snapshot of line inputs [{productId, variantId, productName, quantity, targetPrice, notes}]
  recipientIds      String?   @db.Text // MYSQL: JSON array of seller ids (keepSameRecipients)
  active            Boolean   @default(true)
  pausedUntil       DateTime?
  lastRunAt         DateTime?
  nextRunAt         DateTime
  previewNotifiedAt DateTime? // notifyBeforeHours heads-up sent flag
  emptyCycles       Int       @default(0) // consecutive spawned runs with zero quotes
  runCount          Int       @default(0)
  lastRfqId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([active, nextRunAt])
}

model Payment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method       String // CARD | BANK_TRANSFER | INVOICE
  status       String    @default("PENDING") // PENDING | SUCCEEDED | FAILED | CANCELLED
  amount       Float
  currency     String    @default("USD")
  reference    String? // buyer-supplied transfer reference / gateway txn id
  instructions String?   @db.Text // MYSQL: manual-payment instructions snapshot for the buyer
  dueAt        DateTime? // INVOICE: NET-terms due date
  paidAt       DateTime?
  capturedById String?
  capturedBy   User?     @relation("PaymentsCapturedBy", fields: [capturedById], references: [id])
  note         String?   @db.Text // MYSQL: admin note on capture / failure
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([method, status])
  @@index([capturedById]) // MYSQL-FK-INDEX: capturedById relation needs its own leftmost index
}

model Payout {
  id             String    @id @default(cuid())
  number         String    @unique // PY-2026-000001
  sellerId       String
  seller         User      @relation("PayoutSeller", fields: [sellerId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  itemCount      Int       @default(0)
  grossAmount    Float     @default(0)
  commissionRate Float // percent actually applied (snapshot)
  commission     Float     @default(0)
  netAmount      Float     @default(0)
  status         String    @default("PENDING") // PENDING | PAID | CANCELLED
  paidAt         DateTime?
  note           String?   @db.Text // MYSQL: free-form payout note
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items                  OrderItem[]
  lines                  PayoutLine[] // 7.4B: the immutable settlement ledger
  sellerOrgId            String? // 7.0: authoritative seller-org tenant receiving payment
  currency               String       @default("USD") // 7.2: explicit settlement currency
  transferReference      String? // bank/manually-confirmed transfer reference — REQUIRED to mark paid
  transferIdempotencyKey String?      @unique // derived from payout number + execution attempt; retries reuse it
  executedById           String? // actor who confirmed the transfer
  executedAt             DateTime?

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model ExternalSettlementReference {
  id            String    @id @default(cuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id])
  method        String // WIRE | TRANSFER | CHEQUE | CASH | OTHER
  reference     String?   @db.VarChar(160) // bank/transfer reference supplied by the declarer
  status        String    @default("DECLARED") // DECLARED | CONFIRMED | DISPUTED
  declaredById  String
  declaredBy    User      @relation("SettlementDeclarer", fields: [declaredById], references: [id])
  declaredAt    DateTime  @default(now())
  settledAt     DateTime? // when the parties say money moved
  confirmedById String?
  confirmedBy   User?     @relation("SettlementConfirmer", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  note          String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  evidence PaymentEvidence[]

  @@index([status, createdAt])
  @@index([declaredById])
}

model PaymentEvidence {
  id           String                      @id @default(cuid())
  settlementId String
  settlement   ExternalSettlementReference @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  mediaKey     String
  name         String // original filename snapshot
  mime         String
  size         Int
  uploadedById String
  uploadedBy   User                        @relation("PaymentEvidenceUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime                    @default(now())

  @@unique([settlementId, mediaKey])
  @@index([uploadedById])
}

model CommissionObligation {
  id              String               @id @default(cuid())
  orderId         String
  order           Order                @relation(fields: [orderId], references: [id])
  sellerId        String
  seller          User                 @relation("CommissionObligationSeller", fields: [sellerId], references: [id])
  baseAmount      Decimal              @default(0) @db.Decimal(12, 2) // Σ price×qty of this seller's items
  commissionRate  Float // percent snapshot at trigger time (vendor override → platform default)
  amount          Decimal              @default(0) @db.Decimal(12, 2)
  collectedAmount Decimal              @default(0) @db.Decimal(12, 2)
  status          String               @default("PENDING") // PENDING | INVOICED | PARTIALLY_COLLECTED | COLLECTED | WAIVED | WRITE_OFF
  triggerStage    String               @default("DELIVERED") // owner-defined SUCCESSFUL STAGE
  statementId     String?
  statement       CommissionStatement? @relation(fields: [statementId], references: [id])
  note            String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([orderId, sellerId]) // idempotent trigger: one obligation per pair
  @@index([sellerId, status])
  @@index([statementId])
  @@index([status, createdAt])
}

model CommissionStatement {
  id              String    @id @default(cuid())
  number          String    @unique // CS-2026-000001
  sellerId        String
  seller          User      @relation("CommissionStatementSeller", fields: [sellerId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  obligationCount Int       @default(0)
  baseAmount      Decimal   @default(0) @db.Decimal(12, 2)
  amount          Decimal   @default(0) @db.Decimal(12, 2)
  status          String    @default("OPEN") // OPEN | ISSUED | SETTLED | CANCELLED
  issuedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  obligations CommissionObligation[]
  invoices    CommissionInvoice[]

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model CommissionInvoice {
  id          String              @id @default(cuid())
  number      String              @unique // CIV-2026-000001
  statementId String
  statement   CommissionStatement @relation(fields: [statementId], references: [id])
  sellerId    String
  seller      User                @relation("CommissionInvoiceSeller", fields: [sellerId], references: [id])
  amount      Decimal             @default(0) @db.Decimal(12, 2)
  status      String              @default("ISSUED") // ISSUED | PAID | VOID
  dueAt       DateTime?
  paidAt      DateTime?
  note        String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([statementId])
  @@index([sellerId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // loose FK: SYSTEM entries have no user
  actorType  String // USER | SELLER | ADMIN | SYSTEM
  action     String // e.g. ORG_VERIFIED, RFQ_SUBMITTED, PRICELIST_UPDATED
  entityType String
  entityId   String?
  summary    String?  @db.Text // MYSQL: human-readable summary
  metadata   String?  @db.MediumText // MYSQL: JSON payload blob (16MB)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorType, action])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}

model Permission {
  key         String           @id // e.g. "financing.documents.verify"
  domain      String // catalog | vendors | financing | org-members | ... (UI grouping key)
  description String?          @db.Text // MYSQL: free-form help text
  roles       RolePermission[]

  @@index([domain])
}

model Role {
  id             String            @id @default(cuid())
  key            String            @unique // e.g. "platform.super-admin" | "org.admin" | "custom.platform.x"
  name           String
  description    String?           @db.Text // MYSQL: free-form description
  scope          String // PLATFORM | ORG
  organizationId String            @default("") // "" = platform/global role; set = org-owned custom role (loose FK)
  isSystem       Boolean           @default(false) // seeded, undeletable
  isProtected    Boolean           @default(false) // RBACSEC-1: hidden & untouchable for non-super-admins (super-admin, org.owner)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  permissions    RolePermission[]
  assignments    UserRole[]
  invitations    StaffInvitation[]

  @@index([scope])
  @@index([organizationId])
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String   @default("") // "" = platform scope; otherwise org id (loose FK — keeps composite unique simple on MySQL)
  storeId        String   @default("") // "" = org-wide; otherwise store id (store-scoped assignment, loose FK)
  assignedAt     DateTime @default(now())
  assignedBy     String? // admin user id (loose FK)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId, storeId])
  @@index([userId])
  @@index([organizationId])
  @@index([storeId])
}

model StaffInvitation {
  id             String    @id @default(cuid())
  email          String
  name           String?
  roleId         String
  organizationId String    @default("") // "" = platform staff
  tokenHash      String    @unique // sha256(raw token) — the raw token is shown ONCE at creation (SEC: hashed at rest)
  status         String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  invitedBy      String // admin user id (loose FK)
  invitedByName  String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  role           Role      @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([organizationId, status])
}

model PlatformSetting {
  key       String   @id
  value     String   @db.MediumText // MYSQL: JSON document (16MB)
  updatedAt DateTime @updatedAt
}

model BannerSlide {
  id          String   @id @default(cuid())
  eyebrow     String?
  title       String?
  subtitle    String?
  image       String
  ctaLabel    String?
  ctaView     String?
  ctaCategory String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, position])
}

model RfqSetting {
  id          String   @id @default(cuid())
  key         String // panel key, e.g. "quoteRouting"
  scopeType   String // PLATFORM | ORG_TYPE | ORG | CATEGORY | REGION
  scopeId     String   @default("")
  value       String   @db.MediumText // MYSQL: JSON document of the panel's fields (16MB)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

model SettingChange {
  id           String   @id @default(cuid())
  settingKey   String
  scopeType    String
  scopeId      String   @default("")
  field        String // field path within the panel
  oldValue     String?  @db.Text // MYSQL: JSON value snapshot
  newValue     String?  @db.Text // MYSQL: JSON value snapshot
  userId       String
  rollbackOfId String? // set when this change reverts an earlier one
  createdAt    DateTime @default(now())

  user User @relation("SettingChangeUser", fields: [userId], references: [id])

  @@index([settingKey, scopeType, scopeId, createdAt])
  @@index([userId]) // MYSQL-FK-INDEX: userId relation needs its own leftmost index
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String   @db.Text // MYSQL: free-form coupon description
  percentOff     Int
  minSubtotal    Float    @default(0)
  firstOrderOnly Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

model FinancierProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique // 1:1 — the legal entity (BANK | MFI | EWALLET)
  organization   Organization @relation("FinancierProfileOrg", fields: [organizationId], references: [id], onDelete: Cascade)

  about         String?  @db.Text // MYSQL: public marketing text (About tab)
  licenseNumber String?
  regulator     String?
  logoUrl       String? // MediaAsset-backed URL (existing pattern: User.image)
  contactEmail  String?
  contactPhone  String?
  minTicket     Float? // routing hint; service-level ranges remain authoritative
  maxTicket     Float?
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches             FinancierBranch[]
  services             FinancierService[]
  socialLinks          FinancierSocialLink[]
  stories              FundingStory[]
  partners             Partner[]
  // (conditionTemplates live on Organization — R-2 single entry via organizationId)
  shariaCertifications ShariaCertification[] // 10.3: scholar certs w/ expiry + reminders
  contractTemplates    FinancingContractTemplate[] // 10.3: versioned, sha256-stamped
  riskConfig           RiskConfig? // 10.2: one scoring config per financier
  underwritingLimits   UnderwritingLimit[] // 10.7: branch × underwriter limit matrix

  @@index([organizationId])
}

model FinancierBranch {
  id                 String              @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile    @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  name               String
  kind               String              @default("BRANCH") // BRANCH | AGENT | ATM
  street             String?             @db.Text // MYSQL: street address, free-form
  city               String?
  district           String?
  latitude           Float?
  longitude          Float?
  phone              String?
  isActive           Boolean             @default(true)
  position           Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  underwritingLimits UnderwritingLimit[] // 10.7: limits scoped to this branch

  @@index([financierProfileId, isActive])
}

model FinancierService {
  id                       String           @id @default(cuid())
  financierProfileId       String
  financierProfile         FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  serviceKind              String // FINANCING | ACCREDITATION (DP-22/DP-26)
  category                 String // FINANCING: WORKING_CAPITAL | INVOICE_FINANCING | PO_FINANCING | EQUIPMENT | VEHICLE | HOME | EDUCATION | AGRICULTURE | MICROENTERPRISE | SME | OTHER
  // ACCREDITATION: SUPPLIER_QUALIFICATION | VENDOR_APPROVAL
  name                     String
  summary                  String?          @db.Text // MYSQL: one-line card text
  description              String?          @db.Text // MYSQL: full service description
  targetSegment            String? // BUSINESS | INDIVIDUAL | BOTH (DP-13)
  status                   String           @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  currency                 String           @default("YER")
  amountMin                Float? // null = open (ACCREDITATION kinds)
  amountMax                Float? // competitor's currency.min/max folds HERE
  rateType                 String? // MURABAHA_ANNUAL | FIXED_ANNUAL | FLAT_FEE
  rateMax                  Float? // e.g. 30.000 = 30%/yr cap (murabaha)
  feeFlat                  Float?
  tenorMinMonths           Int?
  tenorMaxMonths           Int?
  repaymentFrequency       String? // MONTHLY | QUARTERLY | LUMP_SUM
  gracePeriodDays          Int?
  shariaCompliant          Boolean          @default(false)
  processingDays           Int?
  accreditationValidMonths Int? // ACCREDITATION kind: lifetime of the grant once ACCREDITED
  accreditationFeeAmount   Float? // ACCREDITATION kind: fee (invoiced externally, D-002)
  financingLimitText       String?          @db.Text // MYSQL: rich detail — financing limit display text
  targetAudience           String?          @db.Text // MYSQL: rich detail — who the program is for
  termsNote                String?          @db.Text // MYSQL: rich detail — terms callout (e.g. murabaha cap)
  guaranteeTypes           String?          @db.Text // MYSQL: rich detail — comma-separated guarantee kinds
  financingPeriods         String?          @db.Text // MYSQL: rich detail — comma-separated periods
  viewCount                Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  attributes            FinancierServiceAttribute[] // features + eligibility text bullets
  coverage              FinancierServiceCoverage[] // geographic coverage (region NAMES — DP-16)
  requirements          ServiceRequirement[] // THE acceptance requirements
  financingRequests     FinancingRequest[] // kind = FINANCING (service-enforced)
  accreditationRequests AccreditationRequest[] // kind = ACCREDITATION (service-enforced)
  reviewNote            String?                     @db.Text // admin reject reason shown to the financier
  reviewedAt            DateTime?
  reviewedById          String?

  @@index([financierProfileId, status])
  @@index([serviceKind, category, status])
}

model FinancierServiceAttribute {
  id        String           @id @default(cuid())
  serviceId String
  service   FinancierService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  kind      String // FEATURE | ELIGIBILITY_CONDITION
  position  Int              @default(0)
  text      String           @db.Text // MYSQL: bullet text, free-form

  @@unique([serviceId, kind, position])
  @@index([serviceId, kind])
}

model FinancierServiceCoverage {
  id         String           @id @default(cuid())
  serviceId  String
  service    FinancierService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  regionName String // normalized at write; matched case-insensitively vs FinancingRequest.activityCity

  @@unique([serviceId, regionName])
  @@index([serviceId])
}

model ConditionTemplate {
  id              String        @id @default(cuid())
  scope           String // GENERAL | FINANCIER (R-5)
  organizationId  String? // null = GENERAL (platform library); set = FINANCIER (private)
  organization    Organization? @relation("FinancierConditionTemplates", fields: [organizationId], references: [id])
  conditionType   String // DOCUMENT | PROFILE_FIELD | DECLARATION | TEXT | NUMBER | DATE | SELECT | MULTI_SELECT
  code            String? // optional stable ref, e.g. "COM-REG" (uniqueness enforced in service layer)
  title           String
  description     String?       @db.Text // MYSQL: instructions shown to the applicant
  profileFieldKey String? // PROFILE_FIELD only — closed set, zod-validated
  documentType    String? // DOCUMENT only — expected AccountDocument.documentType
  validationMin   Float? // NUMBER only — inclusive lower bound
  validationMax   Float? // NUMBER only — inclusive upper bound
  validityMonths  Int? // evidence freshness window
  isRepeatable    Boolean       @default(false) // DOCUMENT only — multiple docs allowed
  isActive        Boolean       @default(true)
  createdById     String
  createdBy       User          @relation("ConditionTemplatesCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  options             ConditionOption[]
  serviceRequirements ServiceRequirement[]

  @@index([scope, organizationId, isActive])
  @@index([conditionType, isActive])
  @@index([organizationId]) // MYSQL-FK-INDEX: organizationId is 2nd col of the index above — MySQL needs it leftmost
  @@index([createdById]) // MYSQL-FK-INDEX: createdById relation needs its own leftmost index
}

model ConditionOption {
  id                  String            @id @default(cuid())
  conditionTemplateId String
  conditionTemplate   ConditionTemplate @relation(fields: [conditionTemplateId], references: [id], onDelete: Cascade)
  value               String // stored + displayed
  position            Int               @default(0)

  @@unique([conditionTemplateId, value])
  @@index([conditionTemplateId, position])
}

model ServiceRequirement {
  id                  String            @id @default(cuid())
  serviceId           String
  service             FinancierService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  conditionTemplateId String
  conditionTemplate   ConditionTemplate @relation(fields: [conditionTemplateId], references: [id])
  isRequired          Boolean           @default(true) // optional conditions inform but never gate
  displayOrder        Int               @default(0)
  phase               String? // CONFIG-1: sequence stage ("Pre-approval", "Due diligence", "Contracting"…) — financiers structure different agreement sequences; null = ungrouped
  instructions        String?          @db.Text // MYSQL: financier's per-service override text
  autoPassAccredited  Boolean           @default(false) // auto-VERIFIED when applicant org holds a live accreditation from THIS financier (DP-26)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  submissions RequirementSubmission[]

  @@unique([serviceId, conditionTemplateId])
  @@index([serviceId, isActive, displayOrder])
  @@index([conditionTemplateId]) // MYSQL-FK-INDEX: conditionTemplateId is 2nd col of the unique above — MySQL needs it leftmost
}

model RequirementSubmission {
  id                   String             @id @default(cuid())
  serviceRequirementId String
  serviceRequirement   ServiceRequirement @relation(fields: [serviceRequirementId], references: [id], onDelete: Cascade)

  // parent: EXACTLY ONE set (service-enforced)
  financingRequestId     String?
  financingRequest       FinancingRequest?     @relation(fields: [financingRequestId], references: [id], onDelete: Cascade)
  accreditationRequestId String?
  accreditationRequest   AccreditationRequest? @relation(fields: [accreditationRequestId], references: [id], onDelete: Cascade)

  status            String           @default("PENDING") // PENDING | SUBMITTED | VERIFIED | REJECTED | WAIVED
  valueText         String?          @db.Text // MYSQL: TEXT / DECLARATION / SELECT answers
  valueNumber       Float? // NUMBER answers
  valueDate         DateTime? // DATE answers
  accountDocumentId String? // DOCUMENT evidence — REUSE of an AccountDocument
  accountDocument   AccountDocument? @relation(fields: [accountDocumentId], references: [id])
  submittedAt       DateTime?
  verifiedAt        DateTime?
  verifiedById      String? // the platform admin (or system for autoPass)
  verifiedBy        User?            @relation("RequirementSubmissionsVerifiedBy", fields: [verifiedById], references: [id])
  decisionNote      String?          @db.Text // MYSQL: rejection reason / waiver reason — shown to applicant
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([financingRequestId, serviceRequirementId])
  @@unique([accreditationRequestId, serviceRequirementId])
  @@index([status])
  @@index([serviceRequirementId]) // MYSQL-FK-INDEX: serviceRequirementId is 2nd col of both uniques above — MySQL needs it leftmost
  @@index([accountDocumentId]) // MYSQL-FK-INDEX: accountDocumentId relation needs its own leftmost index
  @@index([verifiedById]) // MYSQL-FK-INDEX: verifiedById relation needs its own leftmost index
}

model AccountDocument {
  id             String        @id @default(cuid())
  userId         String // owner/uploader — ALWAYS set
  user           User          @relation("AccountDocumentsOwner", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String? // org-scope docs; null = personal
  organization   Organization? @relation("OrganizationAccountDocuments", fields: [organizationId], references: [id])
  mediaId        String // THE storage entry: MediaAsset carries key/originalName/mime/size/sha256/renditions
  media          MediaAsset    @relation("AccountDocumentMedia", fields: [mediaId], references: [id])
  documentType   String // NATIONAL_ID | PASSPORT | RESIDENCE_PERMIT | COMMERCIAL_REG | TAX_CARD | BUSINESS_LICENSE | BANK_STATEMENT | FINANCIAL_STATEMENT | PROOF_OF_ADDRESS | GUARANTEE_DOC | FEASIBILITY_STUDY | INVOICE | PURCHASE_ORDER | PROJECT_FILE | OTHER
  title          String?
  issuedAt       DateTime? // document's own issue date
  expiresAt      DateTime? // freshness vs ConditionTemplate.validityMonths
  status         String        @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewedById   String?
  reviewedBy     User?         @relation("AccountDocumentsReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  note           String?       @db.Text // MYSQL: verification / rejection note
  isActive       Boolean       @default(true) // soft-delete
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  submissions        RequirementSubmission[]
  requestAttachments RequestAttachment[]     @relation("RequestAttachmentDocument")
  vaultGrants        VaultAccessGrant[]      @relation("VaultAccessGrantDocument")
  kycCases           KycCase[]               @relation("KycCaseDocument") // Phase 12.4 provider cases

  @@index([userId, documentType, status])
  @@index([organizationId])
  @@index([mediaId])
  @@index([reviewedById]) // MYSQL-FK-INDEX: reviewedById relation needs its own leftmost index
}

model VaultAccessGrant {
  id         String          @id @default(cuid())
  documentId String
  document   AccountDocument @relation("VaultAccessGrantDocument", fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation("VaultAccessGrantUser", fields: [userId], references: [id])
  nonce      String          @unique // 48 hex chars — bound into the HMAC signature
  basis      String // access-decision basis recorded at issuance
  expiresAt  DateTime
  issuedIp   String?
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([documentId, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt]) // reaper scans long-expired rows
}

model RequestAttachment {
  id                String          @id @default(cuid())
  parentType        String // FINANCING_REQUEST | ACCREDITATION_REQUEST
  parentId          String // loose FK (Dispute pattern)
  accountDocumentId String
  accountDocument   AccountDocument @relation("RequestAttachmentDocument", fields: [accountDocumentId], references: [id], onDelete: Cascade)
  kind              String // GUARANTEE_DOC | STUDY | PROJECT_FILE | OTHER
  createdAt         DateTime        @default(now())

  @@index([parentType, parentId])
  @@index([accountDocumentId])
}

model FinancingRequest {
  id     String @id @default(cuid())
  number String @unique

  // WHO — references ONLY (R-2)
  organizationId String? // applicant org (B2B); null = individual (DP-13)
  organization   Organization? @relation("FinancingRequestsByOrg", fields: [organizationId], references: [id])
  createdById    String
  createdBy      User          @relation("FinancingRequests", fields: [createdById], references: [id])

  // WHAT SERVICE — REQUIRED, service-scoped (DP-22)
  serviceId  String
  service    FinancierService @relation(fields: [serviceId], references: [id])
  targetType String // WORKING_CAPITAL | QUOTE | ORDER | RFQ_LINE
  targetId   String? // quote/order/rfqLine id (loose FK)

  // MULTI-FINANCIER ROUTING (DP-25): null = exclusive; set = sibling group
  multiGroupId String?

  // ACTIVITY (wizard step 2)
  activityStatus        String?
  activityName          String?
  activityDescription   String?   @db.Text // MYSQL: free-form activity description
  activityStartDate     DateTime?
  activityCity          String?
  activityDistrict      String?
  activityAddress       String?   @db.Text // MYSQL: street address, free-form
  activityLocationType  String? // OWNED | RENTED
  activityCategory      String?
  activityCategoryOther String?

  // UNDERWRITING INPUTS
  capitalAmount              Float?
  ownContributionAmount      Float?
  monthlyInstallmentCapacity Float?
  previousFinancing          Boolean?
  otherIncomeSources         String?  @db.Text // MYSQL: free-form income listing

  // THE ASK
  amountRequested      Float
  currency             String  @default("YER")
  purpose              String? @db.Text // MYSQL: free-form purpose text
  tenorRequestedMonths Int?

  // GUARANTEE
  guaranteeType        String? // PERSONAL_GUARANTEE | BANK_GUARANTEE | GOLD | COMMERCIAL | MORTGAGE | CONVERTIBLE_SECURITIES | SELF_GUARANTEE | OTHER
  guaranteeTypeOther   String?
  guaranteeStatus      String? // AVAILABLE | PARTIALLY_AVAILABLE | UNAVAILABLE | OTHER
  guaranteeStatusOther String?

  // CONSENT
  applicantNotes String?   @db.Text // MYSQL: free-form applicant notes
  consentAt      DateTime?

  // THE PLATFORM GATE (R-4, DP-23)
  platformReviewedById String?
  platformReviewedBy   User?     @relation("FinancingPlatformReviews", fields: [platformReviewedById], references: [id])
  platformReviewedAt   DateTime?
  platformNote         String?   @db.Text // MYSQL: free-form gate note
  returnedAt           DateTime?
  returnedReason       String?   @db.Text // MYSQL: free-form return reason
  forwardedAt          DateTime?

  // LIFECYCLE (§5.1)
  status      String    @default("DRAFT")
  expiresAt   DateTime?
  submittedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions    RequirementSubmission[]
  offers         FinancingOffer[]
  riskAssessment RiskAssessment? // 10.2: latest computed assessment (one per request)

  @@index([organizationId, status])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([serviceId])
  @@index([multiGroupId])
  @@index([targetType, targetId])
  @@index([activityCity])
}

model FinancingOffer {
  id                 String           @id @default(cuid())
  requestId          String
  request            FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdById        String // financier staff User
  createdBy          User             @relation("FinancingOffers", fields: [createdById], references: [id])
  amount             Float
  currency           String           @default("YER")
  rateType           String? // MURABAHA_ANNUAL | FIXED_ANNUAL | FLAT_FEE
  ratePercent        Float?
  feeFlat            Float?
  tenorMonths        Int
  collateralRequired String?          @db.Text // MYSQL: from the guarantee taxonomy (§3.8), free-form
  notes              String?          @db.Text // MYSQL: free-form offer notes
  validUntil         DateTime?
  status             String           @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED | WITHDRAWN
  sentAt             DateTime?
  acceptedAt         DateTime?
  declinedAt         DateTime?
  withdrawnAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  installments FinancingOfferInstallment[]
  agreement    FinancingAgreement?

  @@index([requestId, status])
  @@index([createdById]) // MYSQL-FK-INDEX: createdById relation needs its own leftmost index
}

model FinancingOfferInstallment {
  id            String                  @id @default(cuid())
  offerId       String
  offer         FinancingOffer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  amount        Float
  allocations   InstallmentAllocation[] // 10.8: how received payments were applied here

  @@unique([offerId, installmentNo])
  @@index([offerId, dueDate])
}

model FinancingAgreement {
  id                String         @id @default(cuid())
  number            String         @unique // AGR-YYYY-###### via Sequence 'AGR'
  offerId           String         @unique // the ACCEPTED offer — service FREEZES it
  offer             FinancingOffer @relation(fields: [offerId], references: [id])
  fundingStatus     String         @default("PENDING") // PENDING | REPORTED_FUNDED | REPORTED_SETTLED
  status            String         @default("ACTIVE") // ACTIVE | COMPLETED | DEFAULTED | CANCELLED
  acceptedAt        DateTime
  fundedReportedAt  DateTime?
  settledReportedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  events                 FinancingEvent[]
  fees                   FinancingFee[]
  installmentPayments    InstallmentPayment[] // 10.8: the buyer-obligation ledger
  paymentReconciliations PaymentReconciliation[] // 10.8: rail-vs-ledger discrepancy queue
  disbursement           DisbursementRecord? // 10.5: queue → confirm w/ rail ref + FX snapshot
  esignature             ESignatureExecution? // 10.4: evidence package

  @@index([status])
}

model FinancingEvent {
