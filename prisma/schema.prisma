  topic    String  @default("GENERAL") // GENERAL | FUNDING | MARKET | SELL | B2B | ACCOUNT
  question String
  answer   String  @db.Text // MYSQL: long-form answer
  position Int     @default(0)
  featured Boolean @default(false)
  isActive Boolean @default(true)

  @@index([topic, position])
