model FinancierSocialLink {
  id                 String           @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  platform           String // FACEBOOK | X | INSTAGRAM | LINKEDIN | WHATSAPP | TELEGRAM | YOUTUBE | WEBSITE
  url                String
  label              String?
  position           Int              @default(0)
  createdAt          DateTime         @default(now())

  @@index([financierProfileId]) // MYSQL-FK-INDEX: financierProfileId relation needs its own leftmost index
