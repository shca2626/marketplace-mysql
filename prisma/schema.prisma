model InsightPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text // MYSQL: article teaser
  body        String   @db.Text // MYSQL: markdown-lite
  coverUrl    String?
  authorName  String?
  authorTitle String?
  topic       String   @default("GUIDE") // GUIDE | NEWS | POLICY | FUNDING | MARKET
  tags        String? // comma-separated
  readMinutes Int      @default(4)
  featured    Boolean  @default(false)
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
