model FundingStory {
  id                 String            @id @default(cuid())
  financierProfileId String? // null = platform-level story
  financierProfile   FinancierProfile? @relation(fields: [financierProfileId], references: [id], onDelete: SetNull)
  title              String
  summary            String            @db.Text // MYSQL: card summary
  body               String?           @db.Text // MYSQL: long-form, markdown-lite
  imageUrl           String? // MediaAsset-backed URL
  sector             String? // AGRICULTURE | RETAIL | MANUFACTURING | HEALTH | EDUCATION | SERVICES | ENERGY
  location           String?
  year               Int?
  amountFinanced     Float?
  currency           String            @default("YER")
  peopleImpacted     Int?
