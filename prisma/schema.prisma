  @@index([status, createdAt])
  @@index([documentId])
  @@index([providerKey, status])
  @@index([decidedById]) // MYSQL-FK-INDEX: decidedById relation needs its own leftmost index
}

model KycProviderConfig {
  id          String   @id @default(cuid())
  docType     String   @unique // NATIONAL_ID | PASSPORT | COMMERCIAL_REG | …
  mode        String   @default("MANUAL") // MANUAL | PROVIDER | PROVIDER_THEN_MANUAL
  providerKey String   @default("mock") // which adapter handles PROVIDER legs
  enabled     Boolean  @default(true) // master switch (false = MANUAL regardless)
  timeoutMs   Int      @default(30000) // dispatch timeout → PROVIDER_ERROR
  settings    String?  @db.MediumText // JSON: adapter options (mock outcome, webhook URL…)
  changedById String? // last admin actor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases KycCase[]

  @@index([enabled, mode])
}

model KycWebhookEvent {
  id             String    @id @default(cuid())
  eventId        String // provider-declared event id — the idempotency key
  providerKey    String
  caseId         String?
  case           KycCase?  @relation("KycWebhookEventCase", fields: [caseId], references: [id])
  eventType      String // case.approved | case.rejected | case.error | ping
  payload        String    @db.MediumText // exactly what arrived (evidence)
  signatureValid Boolean   @default(false)
  replayed       Boolean   @default(false) // true = duplicate eventId (no-op)
  nonce          String? // replay protection — unique per provider when present
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@unique([providerKey, eventId])
  @@unique([providerKey, nonce])
  @@index([providerKey, receivedAt])
  @@index([caseId])
}

model OrderFulfillment {
  id             String    @id @default(cuid())
  orderId        String
  sellerOrgId    String? // null = platform-facilitated group (items with no seller org)
  sellerId       String? // historical seller-account identity (7.0 three-concept model)
  status         String    @default("UNFULFILLED") // UNFULFILLED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order     Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrg Organization?          @relation("FulfillmentSellerOrg", fields: [sellerOrgId], references: [id])
  items     OrderFulfillmentItem[]

  @@index([orderId])
  @@index([sellerOrgId])
}

model OrderFulfillmentItem {
  id            String @id @default(cuid())
  fulfillmentId String
  orderItemId   String @unique
  quantity      Int    @default(1)

  fulfillment OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId]) // MYSQL-FK-INDEX
}

model OrganizationType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  icon        String?
  isActive    Boolean  @default(true) // hidden from registration pickers when false
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String // normalized E.164 (+9677XXXXXXXXX)
  purpose    String // REGISTER | RESET (LOGIN reserved for future passwordless)
  codeHash   String // sha256(code)
  expiresAt  DateTime // 5-minute TTL
  attempts   Int       @default(0) // max 5 verify tries then burn
  consumedAt DateTime? // single-use burn
  ip         String? // issuance IP (abuse forensics)
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model PaymentReconciliation {
  id             String             @id @default(cuid())
  agreementId    String
  agreement      FinancingAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  batchDate      DateTime // the rail-export day (date-only semantics; service normalizes)
  railExpected   Float // sum per the rail export for that day
  ledgerActual   Float // sum of non-reversed payments receivedAt in that day
  difference     Float // ledgerActual − railExpected
  status         String             @default("OPEN") // OPEN | RESOLVED
  resolutionNote String?            @db.Text
  resolvedById   String?
  resolvedBy     User?              @relation("PaymentReconciliationsResolvedBy", fields: [resolvedById], references: [id])
  createdAt      DateTime           @default(now())
  resolvedAt     DateTime?

  @@unique([agreementId, batchDate])
  @@index([status, batchDate])
}

model PayoutLine {
  id               String    @id @default(cuid())
  payoutId         String
  orderItemId      String
  linePurpose      String // SETTLEMENT | REVERSAL | REISSUE
  amount           Float
  commission       Float
  currency         String    @default("USD")
  fxRate           Float? // FX snapshot on converted amounts (7.2)
  fxRateAt         DateTime?
  fxSource         String?
  status           String    @default("PENDING") // PENDING | EFFECTIVE | REVERSED | CANCELLED
  claimKey         String?   @unique
  reversalOfLineId String?
  effectiveAt      DateTime?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())

  payout     Payout       @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderItem  OrderItem    @relation(fields: [orderItemId], references: [id])
  reversalOf PayoutLine?  @relation("PayoutLineReversal", fields: [reversalOfLineId], references: [id])
  reversals  PayoutLine[] @relation("PayoutLineReversal")

  @@index([payoutId])
  @@index([orderItemId])
  @@index([status])
  @@index([reversalOfLineId]) // MYSQL-FK-INDEX
}

model ProductCertification {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind         String // DATASHEET | WARRANTY | ORIGIN | TEST_REPORT | CERTIFICATE | OTHER
  title        String
  mediaId      String? // vault-backed MediaAsset when uploaded
  url          String? // external link when provided
  issuedBy     String? // certifying body / manufacturer
  issuedAt     DateTime?
  expiresAt    DateTime?
  status       String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  verifiedById String?
  verifiedBy   User?     @relation("CertificationsVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  note         String?   @db.Text
  isActive     Boolean   @default(true) // soft-delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([productId, kind, status])
  @@index([verifiedById]) // MYSQL-FK-INDEX: verifiedById relation needs its own leftmost index
}

model PublicationAgreementTemplate {
  id          String               @id @default(cuid())
  version     String               @unique // e.g. "v2"
  title       String
  body        String               @db.Text // the agreement markdown/text sellers accept
  isActive    Boolean              @default(false) // exactly ONE active template recommended (enforce in service: activating one deactivates others)
  createdById String?
  createdBy   User?                @relation("AgreementsAuthored", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  consents    PublicationConsent[]
}

model PublicationConsent {
  id           String                       @id @default(cuid())
  templateId   String
  template     PublicationAgreementTemplate @relation(fields: [templateId], references: [id])
  productId    String?
  product      Product?                     @relation("ProductAgreementConsents", fields: [productId], references: [id])
  userId       String // the seller who consented
  user         User                         @relation("AgreementConsents", fields: [userId], references: [id])
  productTitle String? // snapshot for export even if product later deleted
  acceptedAt   DateTime                     @default(now())
  ipAddress    String?

  @@unique([templateId, userId, productId]) // one consent per (template, user, product); product-less consents have productId null
  @@index([templateId])
  @@index([userId])
}

model RecurringRfqRun {
  id             String   @id @default(cuid())
  scheduleId     String // loose FK to RecurringRfq.id — run history outlives the schedule
  dueAt          DateTime
  status         String   @default("CLAIMED") // CLAIMED | CREATED | FAILED
  leaseToken     String // random per claim; rewritten on reclaim — Tx 2 verifies it (fencing)
  leaseExpiresAt DateTime
  attempt        Int      @default(1)
  rfqId          String?
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scheduleId, dueAt]) // idempotency key
  @@index([status, leaseExpiresAt])
}

model Refund {
  id               String    @id @default(cuid())
  number           String    @unique // RF-2026-000001
  orderId          String
  requestedById    String
  reason           String    @db.Text
  status           String    @default("REQUESTED") // REQUESTED | APPROVED | COMPLETED | DENIED | CANCELLED
  decidedNote      String?   @db.Text
  amountTotal      Float     @default(0) // sum of allocation buckets
  currency         String    @default("USD")
  paymentReference String? // execution evidence — REQUIRED to complete
  approvedById     String?
  approvedAt       DateTime?
  completedById    String?
  completedAt      DateTime?
  deniedAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order       Order              @relation(fields: [orderId], references: [id])
  requestedBy User               @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedBy  User?              @relation("RefundApprover", fields: [approvedById], references: [id])
  completedBy User?              @relation("RefundCompleter", fields: [completedById], references: [id])
  allocations RefundAllocation[]

  @@index([orderId])
  @@index([status])
  @@index([requestedById]) // MYSQL-FK-INDEX
  @@index([approvedById]) // MYSQL-FK-INDEX
  @@index([completedById]) // MYSQL-FK-INDEX
}

model RefundAllocation {
  id              String @id @default(cuid())
  refundId        String
  orderItemId     String
  quantity        Int    @default(1)
  amount          Float  @default(0) // items bucket for this allocation
  bucketShipping  Float  @default(0)
  bucketDiscounts Float  @default(0)
  bucketTaxes     Float  @default(0)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([refundId, orderItemId])
  @@index([orderItemId]) // MYSQL-FK-INDEX
}

model RiskAssessment {
  id           String           @id @default(cuid())
  requestId    String           @unique
  request      FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  score        Float // 0–100, higher = lower risk
  band         String // LOW | MEDIUM | HIGH
  factors      String           @db.MediumText // JSON: per-factor breakdown
  decision     String           @default("DECISION_SUPPORT") // DECISION_SUPPORT | AUTO_APPROVE | AUTO_DECLINE
  computedById String
  computedBy   User             @relation("RiskAssessmentsComputedBy", fields: [computedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([computedById]) // MYSQL-FK-INDEX: computedById relation needs its own leftmost index
}

model RiskConfig {
  id                   String           @id @default(cuid())
  financierProfileId   String           @unique
  financierProfile     FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  autoDecisionEnabled  Boolean          @default(false)
  autoApproveThreshold Float            @default(80) // score ≥ threshold → AUTO_APPROVE (only when enabled)
  autoDeclineThreshold Float            @default(30) // score < threshold → AUTO_DECLINE (only when enabled)
  // factor weights (0–100 each; the service normalizes to 100% at compute time)
  weightAmount         Int              @default(20) // requested amount vs service range & capacity
  weightTenor          Int              @default(10) // tenor requested vs financed norms
  weightGuarantee      Int              @default(20) // guarantee type + availability
  weightCapacity       Int              @default(20) // monthlyInstallmentCapacity vs schedule
  weightHistory        Int              @default(15) // prior agreements on the platform (performance)
  weightDocuments      Int              @default(15) // verified requirement-submissions ratio
  updatedById          String?
  updatedBy            User?            @relation("RiskConfigsUpdatedBy", fields: [updatedById], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model SellerSubscription {
  id                 String           @id @default(cuid())
  organizationId     String           @unique // the seller-org tenant (org with a SellerProfile)
  organization       Organization     @relation("SellerSubscriptionOrg", fields: [organizationId], references: [id])
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  status             String           @default("ACTIVE") // TRIALING | ACTIVE | GRACE | DOWNGRADED | CANCELLED
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime // renewAt
  graceEndsAt        DateTime? // set when GRACE (now + graceDays)
  graceDays          Int              @default(7)
  cancelledAt        DateTime?
  cancelReason       String?          @db.Text
  changedById        String? // last admin/actor
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  invoices SubscriptionInvoice[]

  @@index([status])
}

model ShariaCertification {
  id                 String           @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  scholarName        String
  scholarInstitution String
  certificateRef     String
  scope              String?          @db.Text // what the certification covers
  issuedAt           DateTime
  expiresAt          DateTime
  reminderSentAt     DateTime? // last 30-day-before-expiry reminder emitted
  documentUrl        String? // evidence document link (media library URL)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([financierProfileId, certificateRef])
  @@index([financierProfileId, expiresAt])
}

model SpecAttribute {
  id         String    @id @default(cuid())
  categoryId String? // null = available to EVERY category
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String // machine key: "wattage"
  label      String // human label: "Rated power"
  dataType   String    @default("TEXT") // TEXT | NUMBER | SELECT | BOOLEAN
  unit       String? // "W", "V", "kg"
  options    String?   @db.Text // SELECT: JSON array ["Monocrystalline","Polycrystalline"]
  required   Boolean   @default(false)
  position   Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([categoryId, key]) // MySQL: NULL categoryId rows not enforced — service layer dedupes global keys
  @@index([isActive, position])
}

model SubscriptionInvoice {
  id             String             @id @default(cuid())
  number         String             @unique // SUB-2026-000001
  subscriptionId String
  subscription   SellerSubscription @relation(fields: [subscriptionId], references: [id])
  planKey        String // snapshot
  planName       String // snapshot
  amount         Float
  currency       String             @default("USD")
  status         String             @default("PAID") // PAID | FAILED
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  failedAt       DateTime?
  createdAt      DateTime           @default(now())

  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  key          String   @unique // free | starter | growth | pro
  name         String
  description  String?  @db.Text
  priceMonthly Float    @default(0)
  currency     String   @default("USD")
  modules      String   @db.MediumText // JSON array of module keys (the ceiling bundle)
  limits       String   @db.MediumText // JSON object of numeric limits (null value = uncapped)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  changedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions SellerSubscription[]

  @@index([isActive, sortOrder])
}

model UnderwritingLimit {
  id                 String           @id @default(cuid())
  financierProfileId String
  financierProfile   FinancierProfile @relation(fields: [financierProfileId], references: [id], onDelete: Cascade)
  scopeKey           String           @unique
  branchId           String? // set when scoped to a branch
  branch             FinancierBranch? @relation(fields: [branchId], references: [id])
  userId             String? // set when scoped to a specific underwriter
  user               User?            @relation("UnderwritingLimitUsers", fields: [userId], references: [id])
  maxAmount          Float
  currency           String           @default("YER")
  updatedById        String
  updatedBy          User             @relation("UnderwritingLimitsUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([financierProfileId])
  @@index([branchId]) // MYSQL-FK-INDEX: branchId relation needs its own leftmost index
  @@index([userId]) // MYSQL-FK-INDEX: userId relation needs its own leftmost index
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  code      String   @unique // "W", "V", "kg", "cm", "mo"
  label     String // "Watt", "Volt", "Kilogram"
  dimension String // POWER | VOLTAGE | CURRENT | WEIGHT | LENGTH | AREA | VOLUME | COUNT | TIME | OTHER
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dimension])
}

model UserNotificationPref {
  userId   String  @id
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsapp Boolean @default(true)
  email    Boolean @default(true)
  sms      Boolean @default(false) // off until an SMS gateway is wired

  updatedAt DateTime @updatedAt
}

model WhatsAppChatMessage {
  id        String             @id @default(cuid())
  threadId  String
  thread    WhatsAppChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction String // IN | OUT
  body      String             @db.Text
  author    String? // 'auto-reply' | 'agent' | 'visitor' | rule name
  createdAt DateTime           @default(now())

  @@index([threadId, createdAt])
}

model WhatsAppChatThread {
  id              String   @id @default(cuid())
  phone           String? // E.164 (WhatsApp threads: the contact; WEBCHAT: visitor phone when given)
  waJid           String? // raw WhatsApp jid (@s.whatsapp.net) — unique per WA thread
  source          String   @default("WHATSAPP") // WHATSAPP | WEBCHAT
  name            String   @default("") // display name (pushName / visitor / user)
  publicToken     String?  @unique // WEBCHAT only — unguessable widget session key
  userId          String? // linked platform user when the phone matches an account
  unreadCount     Int      @default(0)
  lastMessageAt   DateTime @default(now())
  lastMessageBody String?  @db.Text
  autoReply       Boolean  @default(true) // per-thread auto-reply switch (agent mode takes over when off)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages WhatsAppChatMessage[]

  @@unique([waJid])
  @@index([lastMessageAt])
  @@index([source])
  @@index([publicToken])
}

model WhatsAppMessage {
  id             String          @id @default(cuid())
  senderId       String?
  sender         WhatsAppSender? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  toPhone        String // E.164
  template       String // OTP | NOTIFICATION | TEST | CUSTOM
  body           String          @db.Text
  status         String          @default("QUEUED") // QUEUED | SENT | FAILED
  error          String?         @db.Text
  userId         String? // recipient user (null for pre-account OTP)
  notificationId String? // mirrored in-app Notification when applicable
  campaignId     String? // WA-BIZ: bulk campaign this send belongs to
  createdAt      DateTime        @default(now())
  sentAt         DateTime?

  @@index([toPhone, createdAt])
  @@index([status, createdAt])
  @@index([userId])
  @@index([campaignId])
}

model WhatsAppSender {
  id           String    @id @default(cuid())
  label        String // display name, e.g. "Vendora main line"
  phoneNumber  String    @unique // E.164 — the number users receive messages FROM
  status       String    @default("PENDING_PAIRING") // PENDING_PAIRING | PAIRED | DISCONNECTED | FAILED
  credsJson    String?   @db.MediumText // Baileys session credentials (encrypted-at-rest candidate)
  pairingCode  String? // 8-char code the owner types on their phone (pairing flow)
  codeIssuedAt DateTime? // when the CURRENT pairing code was issued (codes expire in ~2-3 min)
  qrExpiresAt  DateTime?
  isDefault    Boolean   @default(false) // the active outbound line
  lastUsedAt   DateTime?
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages WhatsAppMessage[]

  @@index([status])
}

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String   @unique // slug, e.g. "order-shipped"
  category  String   @default("MARKETING") // MARKETING | UTILITY | NOTIFICATION | CUSTOM
  language  String   @default("ar") // ar | en — display hint for the editor
  body      String   @db.Text // supports {{name}}-style placeholders
  status    String   @default("DRAFT") // DRAFT | APPROVED | ARCHIVED
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns BulkCampaign[]
}
