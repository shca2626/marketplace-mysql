// ─────────────────────────────────────────────────────────────────────
// MySQL mirror of schema.prisma — target: Aiven MySQL 8.4 (defaultdb)
//
// Purpose: define/maintain the ONLINE MySQL DDL while the app still runs
// on SQLite. The app's active schema stays prisma/schema.prisma.
//
// Usage:
//   bun run mysql:push     → prisma db push --schema THIS FILE (always --skip-generate)
//   bun run mysql:migrate  → copy all data from SQLite → MySQL
//   bun run mysql:verify   → parity check (counts + spot checks)
//   bun run db:use-mysql   → flip the app to MySQL (one command)
//
// KEEP IN SYNC with prisma/schema.prisma — new fields there must be
// mirrored here, then re-run mysql:push (+ mysql:migrate if needed).
//
// MySQL-specific notes:
//   • Long text fields use @db.Text — MySQL forbids literal defaults on
//     TEXT columns, so `images` drops its @default("[]"); the app ALWAYS
//     sets images explicitly (POST /api/products zod: min 1 image).
//   • Bounded strings get explicit @db.VarChar lengths.
// ─────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-mysql"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique @db.VarChar(255)
  password  String     @db.VarChar(500)
  name      String     @db.VarChar(191)
  image     String?    @db.VarChar(1000)
  role      String     @default("BUYER") @db.VarChar(32) // BUYER | SELLER
  storeName String?    @db.VarChar(191)
  storeBio  String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  orders    Order[]
  reviews   Review[]
  favorites Favorite[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @db.VarChar(191)
  slug     String    @unique @db.VarChar(191)
  icon      String?  @db.VarChar(100) // lucide icon name
  products Product[]
}

model Product {
  id             String     @id @default(cuid())
  title          String     @db.VarChar(300)
  description    String     @db.Text
  price          Float
  compareAtPrice Float?
  images         String     @db.Text // JSON string array of URLs (app always sets it)
  categoryId     String     @db.VarChar(191)
  category       Category   @relation(fields: [categoryId], references: [id])
  sellerId       String     @db.VarChar(191)
  seller         User       @relation(fields: [sellerId], references: [id])
  stock          Int        @default(10)
  soldCount      Int        @default(0)
  rating         Float      @default(0)
  reviewCount    Int        @default(0)
  featured       Boolean    @default(false)
  status         String     @default("ACTIVE") @db.VarChar(32) // ACTIVE | DRAFT | ARCHIVED
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  reviews        Review[]
  favorites      Favorite[]
  orderItems     OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  buyerId   String      @db.VarChar(191)
  buyer     User        @relation(fields: [buyerId], references: [id])
  items     OrderItem[]
  total     Float
  status    String      @default("PAID") @db.VarChar(32) // PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  fullName  String      @db.VarChar(300)
  address   String      @db.Text
  city      String      @db.VarChar(191)
  country   String      @db.VarChar(191)
  zip       String      @db.VarChar(50)
  phone     String?     @db.VarChar(50)
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @db.VarChar(191)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.VarChar(191)
  product   Product @relation(fields: [productId], references: [id])
  sellerId  String  @db.VarChar(191)
  quantity  Int
  price     Float
  title     String  @db.VarChar(300) // snapshot of product title at purchase time
  image     String? @db.VarChar(1000) // snapshot of first product image
}

model Review {
  id        String   @id @default(cuid())
  productId String   @db.VarChar(191)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1..5
  comment   String   @db.Text
  verified  Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id])
  productId String   @db.VarChar(191)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
