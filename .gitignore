# vercel
.vercel

# NOTE (owner ruling, 2026-09): `.env` is intentionally COMMITTED so a fresh clone
# runs out of the box. Do not re-add `.env*` to this file.

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
# exception: the local-disk storage adapter is REQUIRED app source (was lost on host resets)
!src/lib/storage/local-disk.ts
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

