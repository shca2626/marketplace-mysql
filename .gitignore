/storage/
# autonomous-loop management docs (governance of the build process, not the app)
/team/PLAYBOOK.md
/team/TASK_BOARD.md
/team/SPRINT_PLAN.md

# runtime database is COMMITTED on purpose (demo dataset ships with the repo)
db/search-results/
db/custom.db-journal
*.sqlite-wal
*.sqlite-shm

# runtime secrets — never commit (repo is public)
# .env — see the SECURITY note above (real pattern now present)

# ── BRIDGE-1: PHP import bridge + generated dump artifacts (contain DB data/creds) ──
/import.php
/db/*.sql
/db/sqlite-manifest.json
/db/vlm-*.json
/db/mysql-check-result.json
/db/mysql-migrate-result.json
# ── SYNC-1: mysql:sync artifacts (result report + zeroed progress marker) ──
/db/mysql-sync-result.json
/db/import-progress-reset.txt
# ── DOCS-1: tester handover doc (plaintext demo passwords — never commit) ──
/db/TESTER-ACCOUNTS.md
/db/product-images/
/db/product-images-gen.log
# ── WA-8: WhatsApp mini-service — auth session files are ACCOUNT CREDENTIALS ──
mini-services/*/service.log
mini-services/whatsapp-service/sessions/
# ── WA-8: WhatsApp mini-service — auth session files are ACCOUNT CREDENTIALS ──
mini-services/*/service.log
